o["DEAL 2 DAMAGE TO AN ENEMY. IF IT WAS ALREADY DAMAGED, DESTROY IT INSTEAD."]="НАНЕСИТЕ 2 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ЭТОТ ОТРЯД УЖЕ ПОВРЕЖДЕН, УНИЧТОЖЬТЕ ЕГО.";
o["DEAL 2 DAMAGE. REPEAT 2 TIMES."]="НАНЕСИТЕ 2 ЕД. УРОНА. ПОВТОРИТЕ НЕСКОЛЬКО РАЗ (ВСЕГО 2).";
o["DEAL 3 DAMAGE TO 3 ENEMIES AND MOVE THEM TO THE ROW ABOVE."]="НАНЕСИТЕ ПО 3 ЕД. УРОНА 3 ВРАЖЕСКИМ ОТРЯДАМ И ПЕРЕМЕСТИТЕ ИХ В РЯД ВЫШЕ.";
o["DEAL 3 DAMAGE TO A RANDOM ENEMY ON EACH ROW."]="НАНЕСИТЕ 3 ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ.";
o["DEAL 3 DAMAGE TO ALL ENEMIES WITH EVEN POWER."]="НАНЕСИТЕ ПО 3 ЕД. УРОНА ВСЕМ ВРАЖЕСКИМ ОТРЯДАМ С ЧЕТНЫМ ЗНАЧЕНИЕМ СИЛЫ.";
o["DEAL 3 DAMAGE TO ALL ENEMIES WITH ODD POWER."]="НАНЕСИТЕ ПО 3 ЕД. УРОНА ВСЕМ ВРАЖЕСКИМ ОТРЯДАМ С НЕЧЕТНЫМ ЗНАЧЕНИЕМ СИЛЫ.";
o["DEAL 3 DAMAGE TO ALL UNITS ON A ROW."]="НАНЕСИТЕ ПО 3 ЕД. УРОНА ВСЕМ ОТРЯДАМ В ОДНОМ РЯДУ.";
}
