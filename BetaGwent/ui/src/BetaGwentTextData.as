o["DEAL {DAMAGE} DAMAGE TO A RANDOM ENEMY. REPEAT {COUNTER} TIMES."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ. ПОВТОРИТЕ НЕСКОЛЬКО РАЗ (ВСЕГО {COUNTER}).";
