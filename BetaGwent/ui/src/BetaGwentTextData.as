o["<B><#BDBDBD>COUNTER:</COLOR></B> REDUCE THE COUNTER WHENEVER THE GIVEN CONDITION IS MET. RESET THE COUNTER WHEN THE UNIT LEAVES THE BOARD."]="<B><#BDBDBD>СЧЕТЧИК:</COLOR></B> УМЕНЬШАЕТ ЗНАЧЕНИЕ ПРИ ВЫПОЛНЕНИИ ОПРЕДЕЛЕННЫХ УСЛОВИЙ. СБРОСЬТЕ СЧЕТЧИК, КОГДА ОТРЯД ПОКИНЕТ ПОЛЕ.";
o["<B><#BDBDBD>CRAVEN:</COLOR></B> TRIGGER THIS ABILITY IF YOUR OPPONENT IS LOSING THE CURRENT ROUND."]="<B><#BDBDBD>ТРУСОСТЬ:</COLOR></B> АКТИВИРУЕТСЯ, ЕСЛИ ПРОТИВНИК ПРОИГРЫВАЕТ В ТЕКУЩЕМ РАУНДЕ.";
o["<B><#BDBDBD>CREATE:</COLOR></B> SPAWN ONE OF THREE RANDOMLY CHOSEN CARDS, EXCLUDING AGENTS, FROM THE CARD'S FACTION AND FROM NEUTRAL CARDS, UNLESS OTHERWISE SPECIFIED."]="<B><#BDBDBD>СОТВОРИТЬ:</COLOR></B> СОЗДАТЬ ОДНУ ИЗ ТРЕХ СЛУЧАЙНО ВЫБРАННЫХ КАРТ (ВАШЕЙ ФРАКЦИИ ИЛИ НЕЙТРАЛЬНЫХ, ЕСЛИ НЕ УКАЗАНО ИНОЕ), НО НЕ АГЕНТА.";
o["<B><#BDBDBD>CREW:</COLOR></B> THIS UNIT TRIGGERS THE ABILITY OF CREWED UNITS PLAYED ADJACENT TO IT."]="<B><#BDBDBD>ПОДКРЕПЛЕНИЕ:</COLOR></B> АКТИВИРУЕТ СПОСОБНОСТЬ \"КОМАНДА\" У СООТВЕТСТВУЮЩИХ ОТРЯДОВ, СЫГРАННЫХ РЯДОМ С ЭТИМ.";
o["<B><#BDBDBD>CREWED:</COLOR></B> WHEN PLAYED, TRIGGER THIS ABILITY ONCE FOR EACH ADJACENT CREW UNIT."]="<B><#BDBDBD>КОМАНДА:</COLOR></B> ПРИ ПОЯВЛЕНИИ НА ПОЛЕ АКТИВИРУЕТСЯ ПО РАЗУ ЗА КАЖДЫЙ СМЕЖНЫЙ ОТРЯД, ОБЛАДАЮЩИЙ СПОСОБНОСТЬЮ \"ПОДКРЕПЛЕНИЕ\".";
o["<B><#BDBDBD>DAMAGE:</COLOR></B> DECREASE A UNIT'S CURRENT POWER."]="<B><#BDBDBD>УРОН:</COLOR></B> УМЕНЬШАЕТ ТЕКУЩУЮ СИЛУ ОТРЯДА.";
o["<B><#BDBDBD>DAMAGED:</COLOR></B> A DAMAGED UNIT'S CURRENT POWER IS LESS THAN ITS BASE POWER."]="<B><#BDBDBD>ПОВРЕЖДЕННЫЙ:</COLOR></B> ОТРЯД, ОБЛАДАЮЩИЙ МЕНЬШЕЙ СИЛОЙ, ЧЕМ ИЗНАЧАЛЬНАЯ.";
o["<B><#BDBDBD>DEATHWISH:</COLOR></B> TRIGGER THIS ABILITY WHEN MOVED FROM BOARD TO GRAVEYARD. NOTE: UNITS THAT ARE BANISHED OR WEAKENED TO 0 ARE NOT SENT TO THE GRAVEYARD."]="<B><#BDBDBD>ЗАВЕЩАНИЕ:</COLOR></B> АКТИВИРУЕТСЯ, КОГДА КАРТА УХОДИТ С ПОЛЯ В СБРОС. УЧТИТЕ, ЧТО УДАЛЕННЫЕ ИЛИ ОСЛАБЛЕННЫЕ ДО НУЛЯ ОТРЯДЫ В СБРОС НЕ ОТПРАВЛЯЮТСЯ.";
o["<B><#BDBDBD>DEMOTE:</COLOR></B> CONVERT A GOLD CARD TO SILVER (OR BRONZE, IF BRONZE WAS THE CARD'S ORIGINAL COLOR)."]="<B><#BDBDBD>ПОНИЗИТЬ:</COLOR></B> ПРЕОБРАЗОВАТЬ ЗОЛОТУЮ КАРТУ В СЕРЕБРЯНУЮ (ИЛИ В БРОНЗОВУЮ, ЕСЛИ ОНА ИЗНАЧАЛЬНО БЫЛА ТАКОЙ).";
o["<B><#BDBDBD>DEPLOY:</COLOR></B> TRIGGER THIS ABILITY WHEN THE CARD IS PLACED ON THE BOARD."]="<B><#BDBDBD>РАЗМЕЩЕНИЕ:</COLOR></B> АКТИВИРУЕТСЯ, КОГДА КАРТА ПОЯВЛЯЕТСЯ НА ПОЛЕ.";
o["<B><#BDBDBD>DESTROY:</COLOR></B> MOVE THE CARD TO THE GRAVEYARD."]="<B><#BDBDBD>УНИЧТОЖИТЬ:</COLOR></B> ПЕРЕМЕСТИТЬ КАРТУ В СБРОС.";
o["<B><#BDBDBD>DISCARD:</COLOR></B> MOVE A CARD TO THE GRAVEYARD FROM HAND OR DECK. NOTE: RELATED ABILITIES ARE NOT TRIGGERED WHEN DISCARDING MANUALLY."]="<B><#BDBDBD>СБРОСИТЬ:</COLOR></B> ПЕРЕМЕСТИТЬ КАРТУ ИЗ РУКИ ИЛИ КОЛОДЫ В СБРОС. УЧТИТЕ, ЧТО ЕСЛИ КАРТА СБРОШЕНА ВРУЧНУЮ, ЕЕ СПОСОБНОСТИ НЕ АКТИВИРУЮТСЯ.";
o["<B><#BDBDBD>DOOMED:</COLOR></B> REMOVED FROM THE GAME WHEN SENT TO THE GRAVEYARD."]="<B><#BDBDBD>ОБРЕЧЕННОСТЬ:</COLOR></B> ОТРЯД УБИРАЕТСЯ ИЗ ИГРЫ ПРИ ОТПРАВЛЕНИИ В СБРОС.";
}
private static function reverse4(o:Object):void{
