o["НАНЕСИТЕ 2 ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ.\nПОВТОРЯЙТЕ СПОСОБНОСТЬ ЭТОГО ОТРЯДА КАЖДЫЙ РАЗ, КОГДА ВЫ ВСКРЫВАЕТЕ КАРТУ."]="DEAL 2 DAMAGE TO A RANDOM ENEMY.\nREPEAT THIS ABILITY WHENEVER YOU REVEAL A CARD.";
o["НАНЕСИТЕ 2 ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ.\nПОВТОРЯЙТЕ ЭТУ СПОСОБНОСТЬ КАЖДЫЙ РАЗ, КОГДА ВЫ СБРАСЫВАЕТЕ КАРТУ."]="DEAL 2 DAMAGE TO A RANDOM ENEMY.\nREPEAT THIS ABILITY WHENEVER YOU DISCARD A CARD.";
o["НАНЕСИТЕ 2 ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ. ПОВТОРИТЕ НЕСКОЛЬКО РАЗ (ВСЕГО 8)."]="DEAL 2 DAMAGE TO A RANDOM ENEMY. REPEAT 8 TIMES.";
o["НАНЕСИТЕ 2 ЕД. УРОНА. ПОВТОРИТЕ НЕСКОЛЬКО РАЗ (ВСЕГО 2)."]="DEAL 2 DAMAGE. REPEAT 2 TIMES.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ НЕ УНИЧТОЖИТЕ ОТРЯД, УСИЛЬТЕ ЭТУ КАРТУ НА 3 ЕД."]="DEAL 3 DAMAGE TO AN ENEMY. IF THE UNIT WAS NOT DESTROYED, BOOST SELF BY 3.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ОН УНИЧТОЖЕН ИЛИ НА НЕГО ДЕЙСТВУЕТ МОРОЗ, УСИЛЬТЕ ЭТУ КАРТУ НА 2 ЕД."]="DEAL 3 DAMAGE TO AN ENEMY. IF THE ENEMY IS DESTROYED OR IS UNDER FROST, BOOST SELF BY 2.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ОН УНИЧТОЖЕН ИЛИ НА НЕГО ДЕЙСТВУЕТ ТРЕСКУЧИЙ МОРОЗ, УСИЛЬТЕ ЭТУ КАРТУ НА 2 ЕД."]="DEAL 3 DAMAGE TO AN ENEMY. IF THE ENEMY IS DESTROYED OR IS UNDER BITING FROST, BOOST SELF BY 2.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ УНИЧТОЖИТЕ ЕГО, НАНЕСИТЕ 3 ЕД. УРОНА ДРУГОМУ ВРАЖЕСКОМУ ОТРЯДУ.\nКОМАНДА: УВЕЛИЧЬТЕ ИЗНАЧАЛЬНЫЙ УРОН НА 1 ЕД."]="DEAL 3 DAMAGE TO AN ENEMY. IF IT'S DESTROYED, DEAL 3 DAMAGE TO ANOTHER ENEMY.\nCREWED: INCREASE INITIAL DAMAGE BY 1.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ЭТОТ ОТРЯД ШПИОНИТ, НАНЕСИТЕ 6 ЕД. УРОНА."]="DEAL 3 DAMAGE TO AN ENEMY. IF IT'S SPYING, DEAL 6 DAMAGE INSTEAD.";
o["НАНЕСИТЕ 3 ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ."]="DEAL 3 DAMAGE TO A RANDOM ENEMY ON EACH ROW.";
o["НАНЕСИТЕ 3 ЕД. УРОНА ФЕНИКСУ."]="DEAL 3 TO THE PHOENIX.";
o["НАНЕСИТЕ 3 ЕД. УРОНА, А ЗАТЕМ ЕЩЕ 1 ЕД. УРОНА."]="DEAL 3 DAMAGE, THEN DEAL 1 DAMAGE.";
o["НАНЕСИТЕ 3 ЕД. УРОНА."]="DEAL 3 DAMAGE.";
o["НАНЕСИТЕ 4 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL 4 DAMAGE TO AN ENEMY.";
o["НАНЕСИТЕ 4 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ НА НЕГО ДЕЙСТВУЕТ КРОВАВАЯ ЛУНА, НАНЕСИТЕ 7 ЕД. УРОНА."]="DEAL 4 DAMAGE TO AN ENEMY. IF THE ENEMY IS UNDER BLOOD MOON, DEAL 7 DAMAGE INSTEAD.";
o["НАНЕСИТЕ 4 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ НА НЕГО ДЕЙСТВУЕТ ТРЕСКУЧИЙ МОРОЗ, НАНЕСИТЕ 8 ЕД. УРОНА."]="DEAL 4 DAMAGE TO AN ENEMY. IF THE ENEMY IS UNDER BITING FROST, DEAL 8 DAMAGE INSTEAD.";
o["НАНЕСИТЕ 4 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ЭТО ОТРЯД ИЗ ФРАКЦИИ ЧУДОВИЩ, УНИЧТОЖЬТЕ ЕГО."]="DEAL 4 DAMAGE TO AN ENEMY. IF IT'S A MONSTER FACTION UNIT, DESTROY IT INSTEAD.";
o["НАНЕСИТЕ 4 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ ЭТОТ ОТРЯД - ШПИОН, УНИЧТОЖЬТЕ ЕГО."]="DEAL 4 DAMAGE TO AN ENEMY. IF IT'S SPYING, DESTROY IT INSTEAD.";
o["НАНЕСИТЕ 4 ЕД. УРОНА. ЕСЛИ ЭТУ КАРТУ ВОСКРЕСИЛИ, НАНЕСИТЕ 6 ЕД. УРОНА."]="DEAL 4 DAMAGE. IF RESURRECTED, DEAL 6 DAMAGE INSTEAD.";
o["НАНЕСИТЕ 5 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ, ЗАТЕМ НАНЕСИТЕ ПО 1 ЕД. УРОНА ВСЕМ ВРАЖЕСКИМ ОТРЯДАМ ПОД ДЕЙСТВИЕМ КРОВАВОЙ ЛУНЫ."]="DEAL 5 DAMAGE TO AN ENEMY, THEN DEAL 1 DAMAGE TO ALL ENEMIES UNDER BLOOD MOON.";
o["НАНЕСИТЕ 5 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ, ЗАТЕМ ПО ОЧЕРЕДИ НАНЕСИТЕ 4, 3, 2 И 1 ЕД. УРОНА СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ. ОДИН И ТОТ ЖЕ ВРАЖЕСКИЙ ОТРЯД НЕ МОЖЕТ ПОЛУЧИТЬ УРОН ДВА РАЗА ПОДРЯД."]="DEAL 5 DAMAGE TO AN ENEMY, THEN DEAL 4, 3, 2 AND 1 DAMAGE TO RANDOM ENEMIES. CANNOT DAMAGE THE SAME ENEMY TWICE IN A ROW.";
o["НАНЕСИТЕ 5 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL 5 DAMAGE TO AN ENEMY.";
o["НАНЕСИТЕ 5 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nАКТИВИРУЙТЕ СПОСОБНОСТЬ ЭТОЙ КАРТЫ КАЖДЫЙ РАЗ, КОГДА ВСКРЫВАЕТЕ ЭТУ КАРТУ."]="DEAL 5 DAMAGE TO AN ENEMY.\nWHENEVER YOU REVEAL THIS UNIT, TRIGGER ITS ABILITY.";
o["НАНЕСИТЕ 5 ЕД. УРОНА И СОЗДАЙТЕ ПРИЗРАКА В СЛУЧАЙНОМ РЯДУ."]="DEAL 5 DAMAGE AND SPAWN A SPECTER ON A RANDOM ROW.";
o["НАНЕСИТЕ 5 ЕД. УРОНА СИЛЬНЕЙШЕМУ ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL 5 DAMAGE TO THE HIGHEST ENEMY.";
o["НАНЕСИТЕ 5 ЕД. УРОНА ЭТОЙ КАРТЕ.\nВ СЛЕДУЮЩИЙ РАЗ, КОГДА ТЕКУЩАЯ СИЛА ЭТОЙ КАРТЫ СТАНЕТ РАВНА ИЗНАЧАЛЬНОЙ, НАНЕСИТЕ В КОНЦЕ ХОДА 7 ЕД. УРОНА НЕСКОЛЬКИМ СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ (ВСЕГО 3)."]="DEAL 5 DAMAGE TO SELF.\nTHE NEXT TIME THIS UNIT'S CURRENT POWER EQUALS ITS BASE POWER, DEAL 7 DAMAGE TO 3 RANDOM ENEMIES ON TURN END.";
o["НАНЕСИТЕ 5 ЕД. УРОНА."]="DEAL 5 DAMAGE.";
o["НАНЕСИТЕ 6 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. УВЕЛИЧЬТЕ УРОН НА 1 ЕД. ЗА КАЖДЫЙ ОТРЯД ДИКОЙ ОХОТЫ В ВАШЕЙ РУКЕ."]="DEAL 6 DAMAGE TO AN ENEMY. INCREASE DAMAGE BY 1 FOR EACH WILD HUNT UNIT IN YOUR HAND.";
o["НАНЕСИТЕ 6 ЕД. УРОНА ОТРЯДАМ НА КОНЦЕ РЯДА ПРОТИВНИКА."]="DEAL 6 DAMAGE TO THE UNITS AT THE END OF AN ENEMY ROW.";
o["НАНЕСИТЕ 6 ЕД. УРОНА ОТРЯДАМ НА КОНЦЕ РЯДА."]="DEAL 6 DAMAGE TO THE UNITS AT THE END OF A ROW.";
o["НАНЕСИТЕ 6 ЕД. УРОНА. ЕСЛИ УНИЧТОЖИТЕ ОТРЯД, УКРЕПИТЕ СИЛЬНЕЙШИЙ ОТРЯД В ВАШЕМ СБРОСЕ НА 3 ЕД."]="DEAL 6 DAMAGE. IF THE UNIT WAS DESTROYED, STRENGTHEN THE HIGHEST UNIT IN YOUR GRAVEYARD BY 3.";
o["НАНЕСИТЕ 7 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ В РЯДУ, В КОТОРОМ МЕНЬШЕ 4 ОТРЯДОВ."]="DEAL 7 DAMAGE TO AN ENEMY ON A ROW WITH LESS THAN 4 UNITS.";
o["НАНЕСИТЕ 7 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ И ПЕРЕМЕСТИТЕ ЕГО В РЯД ВЫШЕ. ЕСЛИ ЭТОТ РЯД ЗАПОЛНЕН, УНИЧТОЖЬТЕ ЭТОТ ВРАЖЕСКИЙ ОТРЯД."]="DEAL 7 DAMAGE TO AN ENEMY AND MOVE IT TO THE ROW ABOVE. IF THE ROW IS FULL, DESTROY THE ENEMY INSTEAD.";
o["НАНЕСИТЕ 7 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ СДЕЛАЙТЕ СИЛУ ВСКРЫТОГО ВРАЖЕСКОГО ОТРЯДА РАВНОЙ 1 ЕД."]="DEAL 7 DAMAGE TO AN ENEMY; OR SET A REVEALED OPPOSING UNIT'S POWER TO 1.";
o["НАНЕСИТЕ 7 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nВ НАЧАЛЕ ИГРЫ ДОБАВЬТЕ КАРТУ \"ПОЛОСКИ: БОЕЦ\" В ВАШУ КОЛОДУ."]="DEAL 7 DAMAGE TO AN ENEMY.\nAT GAME START, ADD A BLUE STRIPE COMMANDO TO YOUR DECK.";
o["НАНЕСИТЕ 7 ЕД. УРОНА ШПИОНСКОМУ ОТРЯДУ. ЕСЛИ УНИЧТОЖИТЕ ЕГО, УКРЕПИТЕ ЭТУ КАРТУ НА 4 ЕД."]="DEAL 7 DAMAGE TO A SPYING UNIT. IF IT WAS DESTROYED, STRENGTHEN SELF BY 4.";
o["НАНЕСИТЕ 7 ЕД. УРОНА, ЕСЛИ В ТОМ ЖЕ РЯДУ ЕСТЬ ПРОКЛЯТЫЙ ОТРЯД."]="IF THERE IS A CURSED UNIT ON THIS ROW, DEAL 7 DAMAGE.";
o["НАНЕСИТЕ 8 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ УНИЧТОЖИТЕ ЕГО, УСИЛЬТЕ ВСЕХ ЭЛЬФОВ В ВАШЕЙ РУКЕ НА 1 ЕД."]="DEAL 8 DAMAGE TO AN ENEMY. IF THE UNIT WAS DESTROYED, BOOST ALL ELVES IN YOUR HAND BY 1.";
o["НАНЕСИТЕ 8 ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ПОВТОРИТЕ ОДИН РАЗ."]="DEAL 8 DAMAGE TO AN ENEMY. REPEAT ONCE.";
o["НАНЕСИТЕ 8 ЕД. УРОНА ОТРЯДУ, НЕ ОТНОСЯЩЕМУСЯ К ФРАКЦИИ ЧУДОВИЩ."]="DEAL 8 DAMAGE TO A NON-MONSTER FACTION UNIT.";
o["НАНЕСИТЕ 9 ЕД. УРОНА И, ЕСЛИ УНИЧТОЖИТЕ ОТРЯД, УДАЛИТЕ ЕГО."]="DEAL 9 DAMAGE AND, IF THE UNIT WAS DESTROYED, BANISH IT.";
o["НАНЕСИТЕ 9 ЕД. УРОНА."]="DEAL 9 DAMAGE.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА <KEYWORD=HIGHEST>СИЛЬНЕЙШЕМУ</KEYWORD> ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL {DAMAGE} DAMAGE TO THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> ENEMY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА <KEYWORD=SPYING>ШПИОНСКОМУ</KEYWORD> ОТРЯДУ. ЕСЛИ УНИЧТОЖИТЕ ЕГО, <KEYWORD=STRENGTHEN>УКРЕПИТЕ</KEYWORD> ЭТУ КАРТУ НА {STRENGTHEN} ЕД."]="DEAL {DAMAGE} DAMAGE TO A <KEYWORD=SPYING>SPYING</KEYWORD> UNIT. IF IT WAS DESTROYED, <KEYWORD=STRENGTHEN>STRENGTHEN</KEYWORD> SELF BY {STRENGTHEN}.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА БРОНЗОВОЙ ДРУЖЕСТВЕННОЙ МАШИНЕ ИЛИ СОЛДАТУ, ЗАТЕМ СЫГРАЙТЕ ЕГО КОПИЮ ИЗ ВАШЕЙ КОЛОДЫ."]="DEAL {DAMAGE} DAMAGE TO A BRONZE MACHINE OR SOLDIER ALLY, THEN PLAY A COPY OF IT FROM YOUR DECK.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ В РЯДУ, В КОТОРОМ МЕНЬШЕ {COUNTER} ОТРЯДОВ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY ON A ROW WITH LESS THAN {COUNTER} UNITS.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ И ПЕРЕМЕСТИТЕ ЕГО В РЯД ВЫШЕ. ЕСЛИ ЭТОТ РЯД ЗАПОЛНЕН, УНИЧТОЖЬТЕ ЭТОТ ВРАЖЕСКИЙ ОТРЯД."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY AND MOVE IT TO THE ROW ABOVE. IF THE ROW IS FULL, DESTROY THE ENEMY INSTEAD.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ И ПО {DAMAGE2} ЕД. УРОНА ВСЕМ СМЕЖНЫМ С НИМ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY AND {DAMAGE2} TO ANY ADJACENT TO IT.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ СДЕЛАЙТЕ СИЛУ <KEYWORD=REVEALED>ВСКРЫТОГО</KEYWORD> ВРАЖЕСКОГО ОТРЯДА РАВНОЙ {SET} ЕД."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR SET A <KEYWORD=REVEALED>REVEALED</KEYWORD> OPPOSING UNIT'S POWER TO {SET}.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ СДЕЛАЙТЕ СИЛУ ВСКРЫТОГО ВРАЖЕСКОГО ОТРЯДА РАВНОЙ {SET} ЕД."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR SET A REVEALED OPPOSING UNIT'S POWER TO {SET}.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ УСИЛЬТЕ ДРУЖЕСТВЕННЫЙ ОТРЯД НА {BOOST} ЕД."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR BOOST AN ALLY BY {BOOST}.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ, ЗАТЕМ НАНЕСИТЕ ПО {DAMAGE2} ЕД. УРОНА ВСЕМ ВРАЖЕСКИМ ОТРЯДАМ ПОД ДЕЙСТВИЕМ КРОВАВОЙ ЛУНЫ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY, THEN DEAL {DAMAGE2} DAMAGE TO ALL ENEMIES UNDER BLOOD MOON.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ, ЗАТЕМ ПО ОЧЕРЕДИ НАНЕСИТЕ {DAMAGE2}, {DAMAGE3}, {DAMAGE4} И {DAMAGE5} ЕД. УРОНА СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ. ОДИН И ТОТ ЖЕ ВРАЖЕСКИЙ ОТРЯД НЕ МОЖЕТ ПОЛУЧИТЬ УРОН ДВА РАЗА ПОДРЯД."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY, THEN DEAL {DAMAGE2}, {DAMAGE3}, {DAMAGE4} AND {DAMAGE5} DAMAGE TO RANDOM ENEMIES. CANNOT DAMAGE THE SAME ENEMY TWICE IN A ROW.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\n<KEYWORD=CREWED>КОМАНДА</KEYWORD>: ПОВТОРИТЕ ЭТУ СПОСОБНОСТЬ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\n<KEYWORD=CREWED>CREWED:</KEYWORD> REPEAT ITS ABILITY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nАКТИВИРУЙТЕ СПОСОБНОСТЬ ЭТОЙ КАРТЫ КАЖДЫЙ РАЗ, КОГДА ВСКРЫВАЕТЕ ЭТУ КАРТУ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\nWHENEVER YOU REVEAL THIS UNIT, TRIGGER ITS ABILITY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nВ НАЧАЛЕ ИГРЫ ДОБАВЬТЕ КАРТУ \"ПОЛОСКИ: БОЕЦ\" В ВАШУ КОЛОДУ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\nAT GAME START, ADD A BLUE STRIPE COMMANDO TO YOUR DECK.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nЗА КАЖДЫЙ ВРАЖЕСКИЙ ШПИОНСКИЙ ОТРЯД, ПОЯВЛЯЮЩИЙСЯ ВО ВРЕМЯ ВАШЕГО ХОДА, НАНОСИТЕ В КОНЦЕ ХОДА ПО {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\nFOR EACH SPYING ENEMY THAT APPEARS DURING YOUR TURN, DEAL {DAMAGE} DAMAGE TO AN ENEMY ON TURN END.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nКОМАНДА: ПОВТОРИТЕ ЭТУ СПОСОБНОСТЬ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\nCREWED: REPEAT ITS ABILITY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\nНАНОСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ КАЖДЫЙ РАЗ, КОГДА ТОТ ПЕРЕМЕЩАЕТСЯ.\nНАНОСИТЕ {DAMAGE} ЕД. УРОНА СЛУЧАЙНОМУ ВРАЖЕСКОМУ ОТРЯДУ КАЖДЫЙ РАЗ, КОГДА ЭТА КАРТА ПЕРЕМЕЩАЕТСЯ."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY.\nWHENEVER AN ENEMY MOVES, DEAL {DAMAGE} DAMAGE TO IT.\nWHENEVER THIS UNIT MOVES, DEAL {DAMAGE} DAMAGE TO A RANDOM ENEMY.";
o["НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ. ЕСЛИ НА НЕГО ДЕЙСТВУЕТ КРОВАВАЯ ЛУНА, НАНЕСИТЕ {DAMAGE2} ЕД. УРОНА."]="DEAL {DAMAGE} DAMAGE TO AN ENEMY. IF THE ENEMY IS UNDER BLOOD MOON, DEAL {DAMAGE2} DAMAGE INSTEAD.";
