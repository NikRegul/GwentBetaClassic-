o["DEAL {DAMAGE} DAMAGE TO AN ENEMY.\\NFOR EACH <KEYWORD=SPYING>SPYING</KEYWORD> ENEMY THAT APPEARS DURING YOUR TURN, DEAL {DAMAGE} DAMAGE TO AN ENEMY ON TURN END."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\\NЗА КАЖДЫЙ ВРАЖЕСКИЙ <KEYWORD=SPYING>ШПИОНСКИЙ</KEYWORD> ОТРЯД, ПОЯВЛЯЮЩИЙСЯ ВО ВРЕМЯ ВАШЕГО ХОДА, НАНОСИТЕ В КОНЦЕ ХОДА ПО {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO AN ENEMY.\\NWHENEVER YOU <KEYWORD=REVEAL>REVEAL</KEYWORD> THIS UNIT, TRIGGER ITS ABILITY."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ.\\NАКТИВИРУЙТЕ СПОСОБНОСТЬ ЭТОЙ КАРТЫ КАЖДЫЙ РАЗ, КОГДА <KEYWORD=REVEAL>ВСКРЫВАЕТЕ</KEYWORD> ЭТУ КАРТУ.";
o["DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR BOOST AN ALLY BY {BOOST}."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ УСИЛЬТЕ ДРУЖЕСТВЕННЫЙ ОТРЯД НА {BOOST} ЕД.";
o["DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR SET A <KEYWORD=REVEALED>REVEALED</KEYWORD> OPPOSING UNIT'S POWER TO {SET}."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ СДЕЛАЙТЕ СИЛУ <KEYWORD=REVEALED>ВСКРЫТОГО</KEYWORD> ВРАЖЕСКОГО ОТРЯДА РАВНОЙ {SET} ЕД.";
o["DEAL {DAMAGE} DAMAGE TO AN ENEMY; OR SET A REVEALED OPPOSING UNIT'S POWER TO {SET}."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ВРАЖЕСКОМУ ОТРЯДУ ИЛИ СДЕЛАЙТЕ СИЛУ ВСКРЫТОГО ВРАЖЕСКОГО ОТРЯДА РАВНОЙ {SET} ЕД.";
o["DEAL {DAMAGE} DAMAGE TO SELF."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ЭТОЙ КАРТЕ.";
o["DEAL {DAMAGE} DAMAGE TO SELF.\nTHE NEXT TIME THIS UNIT'S CURRENT POWER EQUALS ITS BASE POWER, DEAL {DAMAGE2} DAMAGE TO {TARGETS} RANDOM ENEMIES ON TURN END."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ЭТОЙ КАРТЕ.\nВ СЛЕДУЮЩИЙ РАЗ, КОГДА ТЕКУЩАЯ СИЛА ЭТОЙ КАРТЫ СТАНЕТ РАВНА ИЗНАЧАЛЬНОЙ, НАНЕСИТЕ В КОНЦЕ ХОДА {DAMAGE2} ЕД. УРОНА НЕСКОЛЬКИМ СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ (ВСЕГО {TARGETS}).";
o["DEAL {DAMAGE} DAMAGE TO SELF. REDUCE THE DAMAGE INFLICTED BY {BOOST} FOR EACH BEAST YOU PLAYED THIS MATCH."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ЭТОЙ КАРТЕ. УМЕНЬШИТЕ НАНОСИМЫЙ УРОН НА {BOOST} ЕД. ЗА КАЖДОГО ЗВЕРЯ, СЫГРАННОГО ВАМИ В ЭТОМ МАТЧЕ.";
o["DEAL {DAMAGE} DAMAGE TO THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> ENEMIES ON TURN END."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА <KEYWORD=HIGHEST>СИЛЬНЕЙШИМ</KEYWORD> ВРАЖЕСКИМ ОТРЯДАМ В КОНЦЕ ХОДА.";
o["DEAL {DAMAGE} DAMAGE TO THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> ENEMY ON EACH ROW."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА <KEYWORD=HIGHEST>СИЛЬНЕЙШЕМУ</KEYWORD> ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> ENEMY ON EACH ROW. DEAL {DAMAGE2} EXTRA DAMAGE FOR EACH COPY OF THIS CARD IN YOUR GRAVEYARD."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА <KEYWORD=HIGHEST>СИЛЬНЕЙШЕМУ</KEYWORD> ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ. ДОПОЛНИТЕЛЬНО НАНЕСИТЕ ПО {DAMAGE2} ЕД. УРОНА ЗА КАЖДУЮ КОПИЮ ЭТОЙ КАРТЫ В ВАШЕМ СБРОСЕ.";
o["DEAL {DAMAGE} DAMAGE TO THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> ENEMY."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА <KEYWORD=HIGHEST>СИЛЬНЕЙШЕМУ</KEYWORD> ВРАЖЕСКОМУ ОТРЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO THE HIGHEST ENEMIES ON TURN END."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА СИЛЬНЕЙШИМ ВРАЖЕСКИМ ОТРЯДАМ В КОНЦЕ ХОДА.";
o["DEAL {DAMAGE} DAMAGE TO THE HIGHEST ENEMY ON EACH ROW."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА СИЛЬНЕЙШЕМУ ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO THE HIGHEST ENEMY ON EACH ROW. DEAL {DAMAGE2} EXTRA DAMAGE FOR EACH COPY OF THIS CARD IN YOUR GRAVEYARD."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА СИЛЬНЕЙШЕМУ ВРАЖЕСКОМУ ОТРЯДУ В КАЖДОМ РЯДУ. ДОПОЛНИТЕЛЬНО НАНЕСИТЕ ПО {DAMAGE2} ЕД. УРОНА ЗА КАЖДУЮ КОПИЮ ЭТОЙ КАРТЫ В ВАШЕМ СБРОСЕ.";
o["DEAL {DAMAGE} DAMAGE TO THE HIGHEST ENEMY."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА СИЛЬНЕЙШЕМУ ВРАЖЕСКОМУ ОТРЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO THE SAME UNIT {COUNTER} TIMES."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ОДНОМУ И ТОМУ ЖЕ ОТРЯДУ НЕСКОЛЬКО РАЗ (ВСЕГО {COUNTER}).";
o["DEAL {DAMAGE} DAMAGE TO THE UNITS AT THE END OF A ROW."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ОТРЯДАМ НА КОНЦЕ РЯДА.";
o["DEAL {DAMAGE} DAMAGE TO THE UNITS AT THE END OF AN ENEMY ROW."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА ОТРЯДАМ НА КОНЦЕ РЯДА ПРОТИВНИКА.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ADJACENT ENEMIES.\n<KEYWORD=CREWED>CREWED:</KEYWORD> INCREASE DAMAGE BY 1."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} СМЕЖНЫМ ВРАЖЕСКИМ ОТРЯДАМ.\n<KEYWORD=CREWED>КОМАНДА:</KEYWORD> УВЕЛИЧЬТЕ УРОН НА 1 ЕД.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ADJACENT ENEMIES.\nCREWED: INCREASE DAMAGE BY 1."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} СМЕЖНЫМ ВРАЖЕСКИМ ОТРЯДАМ.\nКОМАНДА: УВЕЛИЧЬТЕ УРОН НА 1 ЕД.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ADJACENT UNITS."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} СМЕЖНЫМ ОТРЯДАМ.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ALLIES AND <KEYWORD=STRENGTHEN>STRENGTHEN</KEYWORD> SELF BY {STRENGTHEN} FOR EACH."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} ДРУЖЕСТВЕННЫМ ОТРЯДАМ И <KEYWORD=STRENGTHEN>УКРЕПИТЕ</KEYWORD> ЭТУ КАРТУ НА {STRENGTHEN} ЕД. ЗА КАЖДЫЙ ПОВРЕЖДЕННЫЙ ОТРЯД.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ALLIES AND STRENGTHEN SELF BY {STRENGTHEN} FOR EACH."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} ДРУЖЕСТВЕННЫМ ОТРЯДАМ И УКРЕПИТЕ ЭТУ КАРТУ НА {STRENGTHEN} ЕД. ЗА КАЖДЫЙ ПОВРЕЖДЕННЫЙ ОТРЯД.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} ENEMIES AND MOVE THEM TO THE ROW ABOVE."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} ВРАЖЕСКИМ ОТРЯДАМ И ПЕРЕМЕСТИТЕ ИХ В РЯД ВЫШЕ.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} RANDOM ENEMIES ON THE OPPOSITE ROW."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ (ВСЕГО {MAXTARGETS}) В ПРОТИВОПОЛОЖНОМ РЯДУ.";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} RANDOM ENEMIES."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА СЛУЧАЙНЫМ ВРАЖЕСКИМ ОТРЯДАМ (ВСЕГО {MAXTARGETS}).";
o["DEAL {DAMAGE} DAMAGE TO {MAXTARGETS} UNITS."]="НАНЕСИТЕ ПО {DAMAGE} ЕД. УРОНА {MAXTARGETS} ОТРЯДАМ.";
o["DEAL {DAMAGE} DAMAGE, THEN DEAL {DAMAGE2} DAMAGE."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА, А ЗАТЕМ ЕЩЕ {DAMAGE2} ЕД. УРОНА.";
o["DEAL {DAMAGE} DAMAGE."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА.";
o["DEAL {DAMAGE} DAMAGE. IF <KEYWORD=RESURRECT>RESURRECTED</KEYWORD>, DEAL {DAMAGE2} DAMAGE INSTEAD."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА. ЕСЛИ ЭТУ КАРТУ <KEYWORD=RESURRECT>ВОСКРЕСИЛИ</KEYWORD>, НАНЕСИТЕ {DAMAGE2} ЕД. УРОНА.";
o["DEAL {DAMAGE} DAMAGE. IF RESURRECTED, DEAL {DAMAGE2} DAMAGE INSTEAD."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА. ЕСЛИ ЭТУ КАРТУ ВОСКРЕСИЛИ, НАНЕСИТЕ {DAMAGE2} ЕД. УРОНА.";
o["DEAL {DAMAGE} DAMAGE. IF THE UNIT WAS DESTROYED, <KEYWORD=STRENGTHEN>STRENGTHEN</KEYWORD> THE <KEYWORD=HIGHEST>HIGHEST</KEYWORD> UNIT IN YOUR GRAVEYARD BY {STRENGTHEN}."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА. ЕСЛИ УНИЧТОЖИТЕ ОТРЯД, <KEYWORD=STRENGTHEN>УКРЕПИТЕ</KEYWORD> <KEYWORD=HIGHEST>СИЛЬНЕЙШИЙ</KEYWORD> ОТРЯД В ВАШЕМ СБРОСЕ НА {STRENGTHEN} ЕД.";
o["DEAL {DAMAGE} DAMAGE. IF THE UNIT WAS DESTROYED, STRENGTHEN THE HIGHEST UNIT IN YOUR GRAVEYARD BY {STRENGTHEN}."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА. ЕСЛИ УНИЧТОЖИТЕ ОТРЯД, УКРЕПИТЕ СИЛЬНЕЙШИЙ ОТРЯД В ВАШЕМ СБРОСЕ НА {STRENGTHEN} ЕД.";
o["DEAL {DAMAGE} DAMAGE. REPEAT {COUNTER} TIMES."]="НАНЕСИТЕ {DAMAGE} ЕД. УРОНА. ПОВТОРИТЕ НЕСКОЛЬКО РАЗ (ВСЕГО {COUNTER}).";
