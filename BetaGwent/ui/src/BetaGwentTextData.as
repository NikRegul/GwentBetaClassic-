o["<B><#BDBDBD>ALLY:</COLOR></B> A UNIT ON YOUR SIDE OF THE BOARD."]="<B><#BDBDBD>ДРУЖЕСТВЕННЫЙ:</COLOR></B> ЛЮБОЙ ОТРЯД НА ВАШЕЙ СТОРОНЕ ПОЛЯ.";
o["<B><#BDBDBD>AMBUSH:</COLOR></B> PLAYED FACE DOWN. CAN BE DISABLED AND FLIPPED OVER IF LOCKED."]="<B><#BDBDBD>ЗАСАДА:</COLOR></B> ИГРАЕТСЯ РУБАШКОЙ ВВЕРХ. ПРИ БЛОКИРОВКЕ МОЖЕТ БЫТЬ ОТМЕНЕНА И ПЕРЕВЕРНУТА.";
o["<B><#BDBDBD>ARMOR:</COLOR></B> ABSORBS A GIVEN AMOUNT OF DAMAGE, THEN IS REMOVED."]="<B><#BDBDBD>БРОНЯ:</COLOR></B> ПОГЛОЩАЕТ ЧАСТЬ УРОНА, ПОСЛЕ ЧЕГО УБИРАЕТСЯ.";
o["<B><#BDBDBD>AURA:</COLOR></B> PASSIVE ABILITY THAT IS UNDONE WHEN THE UNIT IS DESTROYED OR LOCKED."]="<B><#BDBDBD>АУРА:</COLOR></B> ПАССИВНАЯ СПОСОБНОСТЬ, ДЕЙСТВИЕ КОТОРОЙ ПРЕКРАЩАЕТСЯ, КОГДА ОТРЯД УНИЧТОЖАЮТ ИЛИ БЛОКИРУЮТ.";
o["<B><#BDBDBD>BANISH:</COLOR></B> REMOVE FROM THE GAME. DOES NOT TRIGGER DEATHWISH ABILITIES."]="<B><#BDBDBD>УДАЛИТЬ:</COLOR></B> УБРАТЬ ИЗ ИГРЫ. ПРИ ЭТОМ СПОСОБНОСТЬ \"ЗАВЕЩАНИЕ\" НЕ АКТИВИРУЕТСЯ.";
o["<B><#BDBDBD>BOND:</COLOR></B> TRIGGER THIS ABILITY EACH TIME A COPY OF THIS UNIT IS PLAYED ON THE SAME SIDE."]="<B><#BDBDBD>ВЗАИМОСВЯЗЬ:</COLOR></B> АКТИВИРУЕТСЯ КАЖДЫЙ РАЗ, КОГДА НА ТОЙ ЖЕ СТОРОНЕ ПОЛЯ ИГРАЮТ КОПИЮ ЭТОГО ОТРЯДА.";
o["<B><#BDBDBD>BOON:</COLOR></B> POSITIVE ROW EFFECT. REPLACED BY OTHER ROW EFFECTS AND REMOVED ON ROUND END."]="<B><#BDBDBD>БЛАГО:</COLOR></B> ПОЛОЖИТЕЛЬНЫЙ ЭФФЕКТ В РЯДУ. ЗАМЕНЯЕТСЯ ДРУГИМИ ЭФФЕКТАМИ, УБИРАЕТСЯ В КОНЦЕ РАУНДА.";
o["<B><#BDBDBD>BOOST:</COLOR></B> INCREASE A UNIT'S CURRENT POWER."]="<B><#BDBDBD>УСИЛИТЬ:</COLOR></B> УВЕЛИЧИТЬ ТЕКУЩУЮ СИЛУ ОТРЯДА.";
o["<B><#BDBDBD>BOOSTED:</COLOR></B> A BOOSTED UNIT'S CURRENT POWER IS MORE THAN ITS BASE POWER."]="<B><#BDBDBD>УСИЛЕННЫЙ:</COLOR></B> ОТРЯД, ОБЛАДАЮЩИЙ БОЛЬШЕЙ СИЛОЙ, ЧЕМ ИЗНАЧАЛЬНАЯ.";
o["<B><#BDBDBD>BRAVE:</COLOR></B> TRIGGER THIS ABILITY IF YOUR OPPONENT IS WINNING THE CURRENT ROUND (CALCULATED AFTER PLACING THIS UNIT AND ANY UNITS IT SPAWNS)."]="<B><#BDBDBD>ХРАБРОСТЬ:</COLOR></B> АКТИВИРУЕТСЯ, ЕСЛИ ПРОТИВНИК ПОБЕЖДАЕТ В ТЕКУЩЕМ РАУНДЕ (ПОДСЧИТЫВАЕТСЯ ПОСЛЕ ПОЯВЛЕНИЯ НА ПОЛЕ ЭТОГО ОТРЯДА И ВСЕХ ОТРЯДОВ, ЧТО ОН СОЗДАЕТ).";
o["<B><#BDBDBD>CHARM:</COLOR></B> MOVE AN ENEMY TO THE OPPOSITE ROW."]="<B><#BDBDBD>ОЧАРОВАТЬ:</COLOR></B> ПЕРЕМЕСТИТЬ ВРАЖЕСКИЙ ОТРЯД В ПРОТИВОПОЛОЖНЫЙ РЯД.";
o["<B><#BDBDBD>CLASH:</COLOR></B> TRIGGER THIS ABILITY ONLY IF NEITHER PLAYER HAS PASSED."]="<B><#BDBDBD>СХВАТКА:</COLOR></B> АКТИВИРУЕТСЯ, ЕСЛИ ОБА ИГРОКА ЕЩЕ НЕ СПАСОВАЛИ.";
o["<B><#BDBDBD>CLONE:</COLOR></B> AN EXACT COPY OF A CARD, WITH THE SAME CURRENT POWER AND ABILITIES."]="<B><#BDBDBD>КЛОН:</COLOR></B> ТОЧНАЯ КОПИЯ КАРТЫ С ТЕМИ ЖЕ СПОСОБНОСТЯМИ И ТЕКУЩЕЙ СИЛОЙ.";
o["<B><#BDBDBD>CONCEAL:</COLOR></B> TURN OVER A FACE-UP CARD IN HAND."]="<B><#BDBDBD>СКРЫТЬ:</COLOR></B> ПЕРЕВЕРНУТЬ РУБАШКОЙ ВВЕРХ КАРТУ В РУКЕ.";
