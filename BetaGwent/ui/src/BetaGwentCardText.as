        private static function page0():void {
            values[100]={"templateId":100,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[101]={"templateId":101,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[102]={"templateId":102,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[103]={"templateId":103,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[104]={"templateId":104,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[105]={"templateId":105,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
            values[112101]={"templateId":112101,"description":"Возвращайте этот отряд в вашу руку каждый раз, когда проигрываете раунд.\n2 ед. брони.","flavor":"А я могу идти где хочу и когда хочу.","glossary":"","power":6,"typeMask":4};
            values[112102]={"templateId":112102,"description":"Уничтожьте все сильнейшие отряды в ряду противника, если суммарное значение силы этого ряда составляет не менее 25 ед.","flavor":"Многие пренебрегали ведьмачьими Знаками. Почувствовав на своей шкуре мощь Игни, они быстро меняли свое мнение.","glossary":"","power":5,"typeMask":4};
            values[112103]={"templateId":112103,"description":"Нет способности.","flavor":"Если надо выбирать между одним злом и другим, я предпочитаю не выбирать.","glossary":"","power":15,"typeMask":4};
            values[112104]={"templateId":112104,"description":"Истощите все усиления отряда.","flavor":"Я, деликатно говоря, считаюсь чудовищем. Кровожадным монстром.","glossary":"","power":1,"typeMask":4};
            values[112105]={"templateId":112105,"description":"Посмотрите бронзовые отряды (всего 3) в колоде противника. Поглотите 1 отряд и усильте эту карту на изначальную силу поглощенного отряда.","flavor":"Он может, если захочет, стать невидимым. Взглядом может зачаровать, погрузить в глубокий сон. Может обратиться в нетопыря и летать...","glossary":"","power":6,"typeMask":4};
            values[112106]={"templateId":112106,"description":"Нанесите 5 ед. урона.","flavor":"Я сумею о себе позаботиться. Поверь мне.","glossary":"","power":10,"typeMask":4};
            values[112107]={"templateId":112107,"description":"После 3 ходов уничтожьте в начале хода все другие сильнейшие отряды.\n3 ед. брони.","flavor":"Было в этом существе что-то невообразимо грациозное.","glossary":"","power":10,"typeMask":4};
            values[112108]={"templateId":112108,"description":"Выбор: создайте Единорога, который усилит все другие отряды на 2 ед. или создайте Хиронекса, который нанесет по 2 ед. урона всем другим отрядам.","flavor":"Заставить говорить можно каждого, даже мертвеца... Нужно только знать как.","glossary":"","power":6,"typeMask":4};
            values[112109]={"templateId":112109,"description":"Выбор: создайте карту \"Дуб: товарищ\", которая усилит по 2 отряда с каждой стороны на 2 ед. или создайте карту \"Дуб: провокатор\", которая нанесет по 2 ед. урона 2 отрядам с каждой стороны.","flavor":"Прощения просим. Умная заморская пташка, но непристойная. Десять талеров за диковинку отдал.","glossary":"","power":8,"typeMask":4};
            values[112110]={"templateId":112110,"description":"Возвращайте этот отряд в вашу колоду и укрепляйте его на 3 ед. силы каждый раз, когда его сбрасывают или уничтожают.","flavor":"Знаешь, когда сказки перестают быть сказками? Когда люди начинают в них верить.","glossary":"","power":11,"typeMask":4};
            values[112111]={"templateId":112111,"description":"Нанесите по 3 ед. урона 3 вражеским отрядам и переместите их в ряд выше.","flavor":"Ведьмак сложил пальцы в Знак Аард. Грохнуло так, что у Геральта заложило уши, а от поднявшегося ветра зашумели ивы.","glossary":"","power":6,"typeMask":4};
            values[112112]={"templateId":112112,"description":"Создайте базовую копию случайного золотого или серебряного отряда из стартовой колоды противника.","flavor":"Немногочисленные среди вольных эльфов Aen Saevherne, Знающие, были почти легендарной загадкой.","glossary":"","power":3,"typeMask":4};
            values[112113]={"templateId":112113,"description":"Нанесите по 1 ед. урона сильнейшим вражеским отрядам в конце хода.","flavor":"Одетая в сочетание черного и белого, она напоминала декабрьское утро.","glossary":"","power":10,"typeMask":4};
            values[112201]={"templateId":112201,"description":"Скопируйте силу вражеского отряда.","flavor":"Мимик. Впрочем, у него много названий. Подвойняк, векслинг, бедняр. Или допплер, как он сам себя окрестил.","glossary":"","power":1,"typeMask":4};
            values[112202]={"templateId":112202,"description":"Призовите Весемира и Ламберта в тот же ряд.","flavor":"Я простой ведьмак. Не сражаюсь с драконами, не братаюсь с королями, не сплю с чародейками...","glossary":"","power":6,"typeMask":4};
            values[112203]={"templateId":112203,"description":"Призовите Эскеля и Ламберта в тот же ряд.","flavor":"Перед казнью попроси воды. Кто знает, что случится, пока ее принесут.","glossary":"","power":7,"typeMask":4};
            values[112204]={"templateId":112204,"description":"Призовите Эскеля и Весемира в тот же ряд.","flavor":"Вот такие переговоры я понимаю.","glossary":"","power":5,"typeMask":4};
            values[112205]={"templateId":112205,"description":"Нанесите 2 ед. урона. Повторите несколько раз (всего 2).","flavor":"Никогда не влезай между драконицей и ее потомством.","glossary":"","power":7,"typeMask":4};
            values[112206]={"templateId":112206,"description":"Однократность: после 4 ходов нанесите по 1 ед. урона всем вражеским отрядам, затем верните в начале хода эту карту в вашу руку.","flavor":"Господин Дворцовой Горы, Разрушитель, Погибель Трайана. В кругу друзей любит долгие прогулки и беседы при свете луны.","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.","power":8,"typeMask":4};
        }
        private static function page1():void {
            values[112207]={"templateId":112207,"description":"Завещание: воскресите этот отряд в том же месте в конце хода.","flavor":"Теперь ты, по крайней мере, знаешь: мне не так легко потерять голову.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":5,"typeMask":4};
            values[112208]={"templateId":112208,"description":"Однократность, Перемирие: сделайте для обоих игроков базовую копию бронзового отряда в вашей руке.","flavor":"Сжимаясь перед нами, время и пространство расширяются позади нас. Так можно двигаться вперед сквозь время и пространство.","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.\n\nПеремирие: если оба игрока еще не спасовали.","power":5,"typeMask":4};
            values[112209]={"templateId":112209,"description":"Завещание: создайте Черта в случайном ряду.","flavor":"Му-у-у-у-у.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":1,"typeMask":4};
            values[112210]={"templateId":112210,"description":"Призывайте этот отряд в случайный ряд каждый раз, как играете золотой отряд из вашей руки.","flavor":"Геральт, без обид, но мы должны поговорить о том, как ты ездишь.","glossary":"","power":4,"typeMask":4};
            values[112211]={"templateId":112211,"description":"Сбросьте карту из вашей руки. Сделайте на ее месте базовую копию карты того же цвета из стартовой колоды противника.","flavor":"Жить и не слышать божественного сочетания звуков \"ниточка карачунницы\" - все равно что лизать улиток через сукно.","glossary":"","power":9,"typeMask":4};
            values[112212]={"templateId":112212,"description":"Поменяйте карту на другую карту того же цвета.","flavor":"Сара хочет поиграть!","glossary":"","power":11,"typeMask":4};
            values[112213]={"templateId":112213,"description":"Если проигрываете, укрепите эту карту настолько, чтобы установить равенство в раунде, но не более чем до 15 ед.","flavor":"Выясню, хорошо ли смотрюсь без ушей. Или без руки. Король Нищих, кажется, часто берет их в счет долга.","glossary":"","power":5,"typeMask":4};
            values[112214]={"templateId":112214,"description":"Ослабьте отряд на 4 ед.","flavor":"Это один из тех четырех, которые ворочают нашим преступным миром - вместе с Сиги Ройвеном, Карлом Варезе и Королем Нищих.","glossary":"","power":8,"typeMask":4};
            values[112215]={"templateId":112215,"description":"Шпион.\nЗавещание: усильте случайные отряды (всего 5) на противоположной стороне поля на 5 ед.","flavor":"Я так мало помню... Но когда я думаю о моей розе, я могу вспомнить то, что было.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":3,"typeMask":4};
            values[112401]={"templateId":112401,"description":"Усильте все другие отряды на 2 ед.","flavor":"Говорят, единороги льнут к девственницам. Впрочем, никто не проверял: отыскать девственницу в наши времена так же трудно, как единорога.","glossary":"","power":1,"typeMask":4};
            values[112402]={"templateId":112402,"description":"Нанесите по 2 ед. урона всем другим отрядам.","flavor":"\"Боги... это не единорог! Это...\" - последние слова Вилемара, прославленного собирателя редкостей.","glossary":"","power":4,"typeMask":4};
            values[112403]={"templateId":112403,"description":"Усильте по 2 отряда с каждой стороны от этой карты на 2 ед.","flavor":"Он знает сто слов. Восемьдесят из них - ругательства, остальные - союзы и предлоги.","glossary":"","power":1,"typeMask":4};
            values[112404]={"templateId":112404,"description":"Нанесите по 2 ед. урона 2 отрядам с каждой стороны от этой карты.","flavor":"У попугая Золтана была удивительная способность доводить всех, кто ему не угодил. В том числе, Золтана.","glossary":"","power":1,"typeMask":4};
            values[112405]={"templateId":112405,"description":"Нет способности.","flavor":"Бес выглядит почти как олень. Огромный бешеный олень.","glossary":"","power":11,"typeMask":4};
            values[113101]={"templateId":113101,"description":"Сыграйте Бедствие в каждом ряду противника, которое в начале хода наносит 2 ед. урона его сильнейшему отряду.","flavor":"Когда наступит Tedd Deireadh, Час Конца, Час Белого Хлада и Волчьей Пурги, Хеймдалль встанет против злых сил из страны Морхёгг, против демонов и призраков Хаоса.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[113102]={"templateId":113102,"description":"Посмотрите случайные карты в вашей колоде (всего 2) и сыграйте одну из них.","flavor":"Джинн, судари мои, исполняет только три желания, а затем, свободный, он уносится в свое измерение.","glossary":"","power":0,"typeMask":2};
            values[113201]={"templateId":113201,"description":"Повторно сыграйте бронзовый или серебряный дружественный отряд и усильте его на 3 ед.","flavor":"Сюрприз!","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[113202]={"templateId":113202,"description":"Уменьшите силу всех бронзовых и серебряных отрядов в ряду наполовину.","flavor":"Небо внезапно потемнело, над городом заклубились тучи. Вокруг сделалось чертовски мрачно. Повеяло холодом. \"Ой-ой, - вздохнула Йеннифэр. - Сдается, натворили мы дел\".","glossary":"","power":0,"typeMask":2};
            values[113203]={"templateId":113203,"description":"Сыграйте Бедствие в ряду противника, которое в начале хода наносит 2, 1 и 1 ед. урона его отрядам в левом конце ряда.","flavor":"Это не простая буря. Это гнев богов.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[113204]={"templateId":113204,"description":"Нанесите по 1 ед. урона всем вражеским отрядам.","flavor":"Говорят, чародей Стаммельфорд смог приказать д'ао передвинуть гору, закрывающую вид из его башни.","glossary":"","power":0,"typeMask":2};
            values[113205]={"templateId":113205,"description":"Восстановите все усиленные отряды в ряду.","flavor":"Это основной элемент снаряжения Охотников за ведьмами. В один миг превращает могущественнейшего чародея в безоружную жертву.","glossary":"","power":0,"typeMask":2};
            values[113206]={"templateId":113206,"description":"Сыграйте Трескучий мороз в 2 смежных рядах противника.","flavor":"Это Tedd Deireadh, Час Конца. Мир, уничтоженный Белым Холодом.","glossary":"","power":0,"typeMask":2};
            values[113207]={"templateId":113207,"description":"Усильте смежные отряды (всего 5) на 3 ед.","flavor":"Плюс один к морали, минус один к слуху.","glossary":"","power":0,"typeMask":2};
            values[113208]={"templateId":113208,"description":"Создайте Трескучий мороз, Густой туман или Альзур: Гром.","flavor":"Ведермакар - это друид, который умеет влиять на погоду. Может унять шторм. Вызвать град. Сделать так, чтобы врага испепелила молния. Поэтому советую тебе по-хорошему... Обращайся к нему с уважением.","glossary":"","power":4,"typeMask":4};
            values[113209]={"templateId":113209,"description":"Усильте сильнейший бронзовый или серебряный отряд в вашей колоде на 2 ед. и сыграйте его.","flavor":"Несколько созданных Альзуром творений еще вроде бы болтаются по свету, в том числе и вий, который изуродовал его и разрушил половину Марибора, прежде чем сбежать в зареченский лес.","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":0,"typeMask":2};
        }
        private static function page2():void {
            values[113301]={"templateId":113301,"description":"Нанесите 9 ед. урона.","flavor":"Нам не удастся произнести Гром Альзура. Утверждают, что у Альзура голос был подобен колоколу и дикция оратора. А мы пищим и бормочем, путая ритмику и слова...","glossary":"","power":0,"typeMask":2};
            values[113302]={"templateId":113302,"description":"Сыграйте Бедствие в ряду противника, которое в начале хода наносит 2 ед. урона его слабейшему отряду.","flavor":"У меня пальцы так заледенели, едва меч держу... А ведь мечом еще и махать надо...","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[113303]={"templateId":113303,"description":"Выбор: усильте все поврежденные дружественные отряды под действием Бедствий на 2 ед. и очистите вашу сторону от всех Бедствий или сыграйте случайный бронзовый отряд из вашей колоды.","flavor":"Хороший день, чтобы умереть.","glossary":"","power":0,"typeMask":2};
            values[113305]={"templateId":113305,"description":"Сыграйте Бедствие в ряду противника, которое в начале хода наносит 2 ед. урона его сильнейшему отряду.","flavor":"Вот туман-то... Хоть глаз выколи.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[113306]={"templateId":113306,"description":"Нанесите 13 ед. урона.","flavor":"Он убьет вас прежде, чем вы успеете произнести полный титул императора Нильфгаарда.","glossary":"","power":0,"typeMask":2};
            values[113307]={"templateId":113307,"description":"Измените статус стойкости у отряда.","flavor":"Бестия набросилась на них с дикой яростью, не чувствуя боли от ударов, которые наносили защитники. Ничто не могло остановить ее...","glossary":"","power":0,"typeMask":2};
            values[113308]={"templateId":113308,"description":"Уничтожьте все слабейшие отряды.","flavor":"Эпидемии не признают границ и ни для кого не делают исключений.","glossary":"","power":0,"typeMask":2};
            values[113309]={"templateId":113309,"description":"Уничтожьте все сильнейшие отряды.","flavor":"Геральт отступил на шаг. Он уже видел людей, которых поразила \"Казнь\". А скорее то, что от них осталось.","glossary":"","power":0,"typeMask":2};
            values[113310]={"templateId":113310,"description":"Усильте отряд на 10 ед.","flavor":"Это зелье, ускоряющее заживление ран, получило свое название от ласточки, что приносит весну и радость.","glossary":"","power":0,"typeMask":2};
            values[113311]={"templateId":113311,"description":"Усильте 3 смежных отряда на 3 ед. и добавьте им 2 ед. брони.","flavor":"Лицо ведьмака изменилось - в нем появилось что-то нечеловеческое, устрашающее.","glossary":"","power":0,"typeMask":2};
            values[113312]={"templateId":113312,"description":"Сыграйте Бедствие в ряду противника, которое в начале хода наносит по 1 ед. урона 2 его случайным отрядам.","flavor":"\"Осадная башня увязла в грязи!\" \"Вижу, идиот. Труби отступление\".","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[113313]={"templateId":113313,"description":"Усильте дружественный отряд на половину его силы.","flavor":"На Скеллиге любой мужчина, женщина и ребенок могут убить врага топором. Лишь некоторые из них способны сделать это яростным криком.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":5,"typeMask":4};
            values[113315]={"templateId":113315,"description":"Передайте до 10 ед. силы сильнейшего отряда слабейшему.","flavor":"И если ты долго смотришь в бездну, то бездна тоже смотрит в тебя.","glossary":"","power":0,"typeMask":2};
            values[113316]={"templateId":113316,"description":"Воскресите золотой отряд (но не лидера).","flavor":"Врач лечит, магия исцеляет.","glossary":"","power":0,"typeMask":2};
            values[113319]={"templateId":113319,"description":"Измените статус блокировки у отряда. Если это вражеский отряд, нанесите ему 4 ед. урона.","flavor":"Реданцы защелкнули наручники на вывернутых за спину руках чародея. Терранова закричал, задергался, согнулся, захрипел в позыве рвоты. Геральт уже понял, из чего сделаны наручники.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[113320]={"templateId":113320,"description":"Выбор: восстановите отряд и укрепите его на 3 ед. или восстановите отряд и ослабьте его на 3 ед.","flavor":"Съешь побольше, и мир уже не будет прежним...","glossary":"","power":0,"typeMask":2};
            values[113401]={"templateId":113401,"description":"Усильте все поврежденные дружественные отряды под действием Бедствия на 2 ед. и очистите вашу сторону от всех Бедствий.","flavor":"Хороший день, чтобы умереть.","glossary":"","power":0,"typeMask":2};
            values[113402]={"templateId":113402,"description":"Сыграйте случайный бронзовый отряд из вашей колоды.","flavor":"Хороший день, чтобы умереть.","glossary":"","power":0,"typeMask":2};
            values[113403]={"templateId":113403,"description":"Восстановите отряд и укрепите его на 3 ед.","flavor":"Съешь побольше, и мир уже не будет прежним...","glossary":"","power":0,"typeMask":2};
            values[113404]={"templateId":113404,"description":"Восстановите отряд и ослабьте его на 3 ед.","flavor":"Съешь побольше, и мир уже не будет прежним...","glossary":"","power":0,"typeMask":2};
            values[121104]={"templateId":121104,"description":"Размещение: создайте изначальную копию бронзового дружественного отряда в том же ряду.","flavor":"Проклятая политика... Я доверяю только своим солдатам.","glossary":"Размещение: активируется, когда карта появляется на поле.","power":3,"typeMask":4};
            values[122101]={"templateId":122101,"description":"Каждый раз, когда уничтожается вражеский отряд, усиливайте эту карту на 1 ед., если она находится в руке, в колоде или на поле.","flavor":"Я знаю, что не был хорошим отцом. Но, может, еще не слишком поздно.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":9,"typeMask":4};
            values[122102]={"templateId":122102,"description":"Нанесите 7 ед. урона вражескому отряду.\nВ начале игры добавьте карту \"Полоски: боец\" в вашу колоду.","flavor":"Дрянь человек, но патриот.","glossary":"","power":3,"typeMask":4};
            values[122103]={"templateId":122103,"description":"Сыграйте бронзовую или серебряную карту тактики из вашей колоды.","flavor":"Этот сквер должен носить имя павших солдат. А не мое.","glossary":"","power":6,"typeMask":4};
            values[122104]={"templateId":122104,"description":"Нанесите 5 ед. урона вражескому отряду, затем по очереди нанесите 4, 3, 2 и 1 ед. урона случайным вражеским отрядам. Один и тот же вражеский отряд не может получить урон два раза подряд.","flavor":"Филиппа Эйльхарт, хоть и весьма привлекательная, была очень неприятной.","glossary":"Урон: уменьшает текущую силу отряда.\n\nВражеский: любой отряд на стороне поля противника.","power":1,"typeMask":4};
        }
        private static function page3():void {
            values[122105]={"templateId":122105,"description":"Шпион.\nСыграйте верхние карты (всего 2) из вашей колоды.","flavor":"Гвинт напоминает политику. Только честнее.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":4,"typeMask":4};
            values[122106]={"templateId":122106,"description":"Воскресите не проклятый бронзовый или серебряный отряд и добавьте ему 2 ед. брони.","flavor":"Я медичка. И если что-то советую, то знаю, что говорю.","glossary":"","power":4,"typeMask":4};
            values[122107]={"templateId":122107,"description":"Усильте слабейшие дружественные отряды на 1 ед. в конце хода.","flavor":"Капитан... наши стрелы... у них... у них крылья!","glossary":"","power":8,"typeMask":4};
            values[122108]={"templateId":122108,"description":"Создайте Альзур: Гром, Гром или Яд главоглаза.","flavor":"Если мне сегодня суждено умереть, я хоть выглядеть буду хорошо.","glossary":"","power":6,"typeMask":4};
            values[122201]={"templateId":122201,"description":"Усильте отряды в вашей колоде (всего 3) на 2 ед.","flavor":"Юлиан Альфред Панкрац, виконт де Леттенхоф. Для друзей - Лютик.","glossary":"","power":11,"typeMask":4};
            values[122202]={"templateId":122202,"description":"Усильте случайные дружественные отряды (всего 5) на 3 ед.","flavor":"Представь себе, что Лютик поменял пол, и у тебя будет точный образ.","glossary":"","power":3,"typeMask":4};
            values[122203]={"templateId":122203,"description":"Шпион.\nОднократность: возьмите 2 карты. Одну оставьте, вторую верните в вашу колоду.","flavor":"Ну так как? По рукам?","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":13,"typeMask":4};
            values[122204]={"templateId":122204,"description":"Поменяйте до 2 карт.","flavor":"Лучше прожить один день как король, чем всю жизнь как нищий.","glossary":"","power":12,"typeMask":4};
            values[122205]={"templateId":122205,"description":"Сыграйте бронзовую или серебряную особую карту, затем возьмите карту.","flavor":"Нет ничего хуже, чем научно обоснованный шовинизм.","glossary":"","power":4,"typeMask":4};
            values[122206]={"templateId":122206,"description":"Шпион.\nЗавещание: сделайте силу всех отрядов в ряду равной силе слабейшего отряда в ряду.","flavor":"Дщерь каэдвенских пущ.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":3,"typeMask":4};
            values[122207]={"templateId":122207,"description":"Создайте Проливной дождь, Чистое небо или Альзур: Гром.","flavor":"Такими чарами выигрывают войны! Тысячи жертв в одну минуту!","glossary":"","power":4,"typeMask":4};
            values[122208]={"templateId":122208,"description":"Сыграйте верхний не шпионский бронзовый или серебряный отряд из вашей колоды и добавьте ему 5 ед. брони.\n3 ед. брони.","flavor":"Сразу было видно, что редкостный кретин. Кто же носит золотые доспехи?!","glossary":"","power":3,"typeMask":4};
            values[122209]={"templateId":122209,"description":"9 ед. брони.","flavor":"Что, людь мне видит? Я записался в армию короля Радозвида. И у меня приказ - защищать лодки.","glossary":"","power":11,"typeMask":4};
            values[122210]={"templateId":122210,"description":"Верните слабейший бронзовый или серебряный отряд каждого игрока в колоду.","flavor":"Говорили, у принцессы взрывной нрав, но такого не ожидал никто...","glossary":"Слабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":3,"typeMask":4};
            values[122211]={"templateId":122211,"description":"Восстановите отряд и измените у него статус блокировки.","flavor":"Меня интересует только благо Аретузы и моих учениц.","glossary":"","power":6,"typeMask":4};
            values[122212]={"templateId":122212,"description":"Верните бронзовые или серебряные отряды (всего 3) из сброса в вашу колоду.","flavor":"Мало кто знает о здоровье больше, чем Неннеке.","glossary":"","power":10,"typeMask":4};
            values[122213]={"templateId":122213,"description":"В начале хода переместите этот отряд в случайный ряд и усильте все другие дружественные отряды в этом ряду на 1 ед.","flavor":"Пить без Одрина - это как грести без весел.","glossary":"","power":8,"typeMask":4};
            values[122214]={"templateId":122214,"description":"Очистите ряд от Бедствий.\n3 ед. брони.\nПодкрепление.","flavor":"Вперед, подонки! Вперед! Вы не нильфов бойтесь, вам меня бояться надо!","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":9,"typeMask":4};
            values[122216]={"templateId":122216,"description":"Нанесите по 1 ед. урона за каждую карту в вашей руке.","flavor":"Если хочешь торговать в Новиграде, выбор прост: сговорись с Тесаком, или прощайся со своими коленями.","glossary":"","power":7,"typeMask":4};
            values[122301]={"templateId":122301,"description":"Нанесите по 1 ед. урона вражескому отряду и другим случайным вражеским отрядам (всего 4) с той же силой.\nКоманда: повторите способность.","flavor":"- Мы даем им женские имена. - Это какая-нибудь Марыська? - Нет, это Хельга.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".","power":6,"typeMask":4};
            values[122302]={"templateId":122302,"description":"Нанесите 2 ед. урона вражескому отряду.\nКоманда: повторите эту способность.","flavor":"Никогда не попадает дважды в одно и то же место. По здравому размышлению, это может вызвать серьезные проблемы.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".","power":7,"typeMask":4};
            values[122303]={"templateId":122303,"description":"Нанесите по 1 ед. урона 3 смежным вражеским отрядам.\nКоманда: увеличьте урон на 1 ед.","flavor":"Один требушет стоит ста пехотинцев. И трехсот таких доходяг, как ты.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".\n\nУрон: уменьшает текущую силу отряда.","power":7,"typeMask":4};
            values[122304]={"templateId":122304,"description":"Усильте эту карту на 2 ед.\nКоманда: повторите способность.","flavor":"Последний писк моды в области разрушения стен.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".","power":8,"typeMask":4};
            values[122306]={"templateId":122306,"description":"Усильте на 1 ед. все копии этого отряда в руке, в колоде или на поле.\nПовторяйте способность каждый раз, когда играют копию этого отряда.","flavor":"Видишь татуировку, барышня? Это я, с драконом сражаюсь. С ДРАКОНОМ.","glossary":"","power":6,"typeMask":4};
            values[122307]={"templateId":122307,"description":"Выберите другой бронзовый дружественный отряд и сыграйте его копию из вашей колоды.","flavor":"Записались мы на войну, а то с чудищами последнее время нам не шибко везет.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":1,"typeMask":4};
        }
        private static function page4():void {
            values[122308]={"templateId":122308,"description":"Если у этого отряда нет брони, в конце хода усильте его на 2 ед. и добавьте ему 2 ед. брони.","flavor":"Во славу Редании!","glossary":"","power":7,"typeMask":4};
            values[122309]={"templateId":122309,"description":"Усиливайте на 1 ед. каждый появляющийся дружественный отряд. Если это машина, добавляйте ей еще 1 ед. брони.\nПодкрепление.","flavor":"Откалибруйте базу на пять градусов! - Так точ... Сука, чо?","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.\n\nДружественный: любой отряд на вашей стороне поля.","power":7,"typeMask":4};
            values[122310]={"templateId":122310,"description":"Усильте все дружественные темерские отряды и не шпионские темерские отряды в руке и колоде с той же силой, что и у этого отряда, на 1 ед.\nПодкрепление.","flavor":"Синих Полосок и скоя'таэлей роднит одно: их ведет ненависть.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":3,"typeMask":4};
            values[122311]={"templateId":122311,"description":"Призывайте копию этого отряда в случайный ряд каждый раз, когда играют другой дружественный отряд Темерии с той же силой.","flavor":"Для Темерии я готов на все. Но обычно я для нее только убиваю.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":3,"typeMask":4};
            values[122312]={"templateId":122312,"description":"Усильте всех дружественных солдат на 1 ед.","flavor":"Шейте красное с красным, желтое с желтым, белое с белым. Так наверняка будет хорошо...","glossary":"","power":8,"typeMask":4};
            values[122313]={"templateId":122313,"description":"Призовите этот отряд в случайный ряд, если в начале хода проигрываете с разницей более чем в 25 ед. силы.","flavor":"Всем сохранять спокойствие. А также бдительность. Плащи и бобровые шапки довольно легко меняют хозяев.","glossary":"","power":4,"typeMask":4};
            values[122314]={"templateId":122314,"description":"Уничтожьте броню отряда, затем усильте эту карту на значение уничтоженной брони.","flavor":"Мне всегда было интересно, как они в сортир-то ходят?","glossary":"","power":8,"typeMask":4};
            values[122315]={"templateId":122315,"description":"Нанесите 1 ед. урона случайному вражескому отряду в конце хода.","flavor":"Чуешь? Земля дрожит, когда \"Толстая Берта\" стреляет.","glossary":"","power":8,"typeMask":4};
            values[122316]={"templateId":122316,"description":"Призовите все копии этого отряда в тот же ряд.","flavor":"Темерия! Темерия! Судьба к тебе щедра! Ты сокрушишь врагов своих величием добра!","glossary":"","power":3,"typeMask":4};
            values[122317]={"templateId":122317,"description":"Усиливайте эту карту на 5 ед. каждый раз, когда значение ее брони уменьшается до 0.\n4 ед. брони.","flavor":"Все для Редании! Конечно, если жалованье получим вовремя.","glossary":"","power":8,"typeMask":4};
            values[122318]={"templateId":122318,"description":"Исцелите бронзовую или серебряную машину и повторите ее способность.\nПодкрепление.","flavor":"Я никогда не промахиваюсь дважды.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":6,"typeMask":4};
            values[122401]={"templateId":122401,"description":"Призовите Чура в тот же ряд.","flavor":"Могила разрыта... Значит, игоша вышел на охоту.","glossary":"","power":10,"typeMask":4};
            values[122402]={"templateId":122402,"description":"Призовите Игошу в тот же ряд.","flavor":"Нарекаю тебя... Дея. И признаю дочерью.","glossary":"","power":5,"typeMask":4};
            values[122403]={"templateId":122403,"description":"Посмотрите 2 случайные бронзовые карты алхимии в вашей колоде и сыграйте одну из них.","flavor":"Нильфгаардские маги - расходный материал. Если один из них разгневает императора, дюжина других охотно исполнит приказ.","glossary":"","power":2,"typeMask":4};
            values[123201]={"templateId":123201,"description":"Сыграйте бронзового или серебряного солдата, машину, офицера или отряд поддержки из вашей колоды.","flavor":"Трубить отступление! Перегруппироваться и ждать подкрепления!","glossary":"","power":0,"typeMask":2};
            values[123301]={"templateId":123301,"description":"Если в конце вашего хода у этого отряда есть броня, усильте смежные с ним отряды на 1 ед.\n2 ед. брони.","flavor":"Не злато, но рвение святое тебе поможет стать героем!","glossary":"Броня: поглощает часть урона, после чего убирается.","power":7,"typeMask":4};
            values[131101]={"templateId":131101,"description":"Создайте бронзовый отряд Дикой Охоты.","flavor":"Держи себя в руках. Ты же знаешь, чем это кончится.","glossary":"","power":5,"typeMask":4};
            values[131102]={"templateId":131102,"description":"Посмотрите случайную золотую и серебряную карты в вашей колоде. Сыграйте одну из них и положите вторую на верх вашей колоды.","flavor":"Картина должна передавать эмоции, а не слова.","glossary":"","power":1,"typeMask":4};
            values[132101]={"templateId":132101,"description":"Воскрешайте отряды в качестве Драугиров с 1 ед. силы, пока не заполните этот ряд.","flavor":"Генерал так и не признал поражения. Продолжал сражаться даже после смерти.","glossary":"","power":10,"typeMask":4};
            values[132102]={"templateId":132102,"description":"Нанесите 4 ед. урона вражескому отряду. Если на него действует Трескучий мороз, нанесите 8 ед. урона.","flavor":"Имлерих?.. Лучше сразу сдаться.","glossary":"","power":9,"typeMask":4};
            values[132103]={"templateId":132103,"description":"Создайте Волков (всего 3) в рукопашном ряду и сыграйте Густой туман в противоположном ряду.","flavor":"В этом лесу не охотятся. Никогда. Пусть даже вся деревня умирает от голода.","glossary":"","power":5,"typeMask":4};
            values[132104]={"templateId":132104,"description":"Переместите вражеский отряд в ряд, противоположный этому отряду, и сыграйте Трескучий мороз в том же ряду.","flavor":"Золотой мальчик, который вырос злодеем.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":9,"typeMask":4};
            values[132105]={"templateId":132105,"description":"Перемирие: оба игрока берут карты (всего 2).","flavor":"Я шутить не склонен.","glossary":"Перемирие: если оба игрока еще не спасовали.","power":8,"typeMask":4};
            values[132106]={"templateId":132106,"description":"Воскресите бронзовый или серебряный отряд из сброса противника.","flavor":"Некоторые вещи истинными именами лучше не называть.","glossary":"","power":4,"typeMask":4};
            values[132107]={"templateId":132107,"description":"Поглотите отряд с силой 7 ед. или меньше и усильте эту карту на силу поглощенного отряда.","flavor":"\"Этот ствол там, слева... Он движется!\" \"Это не ствол. Это щупальце\".","glossary":"","power":5,"typeMask":4};
        }
        private static function page5():void {
            values[132108]={"templateId":132108,"description":"После 2 ходов очаруйте в начале хода сильнейший вражеский отряд в противоположном ряду.","flavor":"Зачем сражаться? Есть много более приятных способов тратить энергию...","glossary":"Вражеский: любой отряд на стороне поля противника.\n\nСильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":4,"typeMask":4};
            values[132201]={"templateId":132201,"description":"Следующие несколько раз (всего 4), когда вы поглощаете отряд, создавайте Молодого главоглаза в случайном ряду.","flavor":"Оно... Оно шевелится!","glossary":"","power":8,"typeMask":4};
            values[132202]={"templateId":132202,"description":"Поглотите все бронзовые и серебряные отряды в вашем сбросе и усильте эту карту на 1 ед. за каждый.","flavor":"Обычно кладбищенские бабы предпочитают питаться гнилыми останками, которые выкапывают из могил. Однако некоторые прокрадываются в хаты, воруя детей и убивая стариков. Словом, те еще соседи.","glossary":"","power":4,"typeMask":4};
            values[132203]={"templateId":132203,"description":"Создайте Проливной дождь, Чистое небо или Яд главоглаза.","flavor":"Множество гнусных тварей видел я в своей жизни, но ни одна из них не сравнится в мерзости с водной бабой.","glossary":"","power":4,"typeMask":4};
            values[132204]={"templateId":132204,"description":"Шпион.\nОднократность: переместите вражеский отряд в тот же ряд и возьмите карту.","flavor":"Откуда это имя? Погоди, сейчас узнаешь.","glossary":"Вражеский: любой отряд на стороне поля противника.\n\nОднократность: способность этой карты можно использовать лишь один раз за игру.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":13,"typeMask":4};
            values[132205]={"templateId":132205,"description":"Измените статус блокировки у отряда. Если это вражеский отряд, уменьшите его силу наполовину.","flavor":"Необычный бес с Ард Скеллига. Привередливый в плане еды.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":6,"typeMask":4};
            values[132206]={"templateId":132206,"description":"Призовите Кухарку и Пряху в тот же ряд.","flavor":"Хи-хи-хи-хи-хи!","glossary":"","power":6,"typeMask":4};
            values[132207]={"templateId":132207,"description":"Призовите Шептуху и Пряху в тот же ряд.","flavor":"Порубим тебя, юноша. Отличный выйдет супчик...","glossary":"","power":8,"typeMask":4};
            values[132208]={"templateId":132208,"description":"Призовите Кухарку и Шептуху в тот же ряд.","flavor":"Я чую твою боль, вижу твой страх.","glossary":"","power":6,"typeMask":4};
            values[132209]={"templateId":132209,"description":"Нет способности.","flavor":"Один из самых редких и самых опасных монстров. Раньше я был бы в восторге. Теперь она была только преградой на моем пути. Ее мясо и горячая кровь помогли мне выжить в ледяном аду.","glossary":"","power":13,"typeMask":4};
            values[132210]={"templateId":132210,"description":"Создайте Малых ифритов (всего 3) справа от этого отряда.","flavor":"Ну, сейчас тут будет горячо.","glossary":"","power":8,"typeMask":4};
            values[132211]={"templateId":132211,"description":"Выберите бронзовый дружественный отряд и добавьте его копии (всего 2) в низ вашей колоды.","flavor":"Осторожней, там под мостом накеры живут.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":9,"typeMask":4};
            values[132212]={"templateId":132212,"description":"Усильте этот отряд на 6 ед., если на поле есть Трескучий мороз.","flavor":"Раз в жизни я бегал от врага. От Ледяного Великана. И вовсе этого не стыжусь.","glossary":"","power":6,"typeMask":4};
            values[132213]={"templateId":132213,"description":"Завещание: создайте отряды Малого д'ао (всего 2) в том же ряду.","flavor":"Как выжить при встрече с элементалем земли? Очень просто. Бежать со всех ног.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":6,"typeMask":4};
            values[132214]={"templateId":132214,"description":"Нанесите 6 ед. урона вражескому отряду. Увеличьте урон на 1 ед. за каждый отряд Дикой Охоты в вашей руке.","flavor":"Каждый всадник Дикой Охоты проходит суровый отбор, но к свите Эредина присоединяются только самые жестокие и самые решительные эльфы Aen Elle.","glossary":"Урон: уменьшает текущую силу отряда.","power":6,"typeMask":4};
            values[132215]={"templateId":132215,"description":"Заключите пари с Гюнтером о'Димом: угадайте силу карты, которую он выбрал.","flavor":"Он даст тебе успех и достаток. Щедро одарит и сребром, и златом.","glossary":"Пари: сыграть в азартную игру.","power":6,"typeMask":4};
            values[132216]={"templateId":132216,"description":"Возьмите отряд, затем поглотите отряд в вашей руке и усильте эту карту на силу поглощенного отряда.","flavor":"Большой. Злой. Мерзкий. В каналах сидит.","glossary":"","power":6,"typeMask":4};
            values[132217]={"templateId":132217,"description":"Создайте Яйца гарпии (всего 2) слева от этого отряда.","flavor":"Обычные гарпии питаются падалью. А келено - снами.","glossary":"","power":6,"typeMask":4};
            values[132218]={"templateId":132218,"description":"Укрепите всех других ваших огроидов в руке, в колоде или на поле на 1 ед.","flavor":"\"Не беспокоить\".","glossary":"","power":12,"typeMask":4};
            values[132220]={"templateId":132220,"description":"Создайте Лунный свет.","flavor":"Мелитэле, Великая Мать, защити нас от зла, от когтей катакана и носферата...","glossary":"","power":5,"typeMask":4};
            values[132301]={"templateId":132301,"description":"Призывайте копию этого отряда в противоположном ряду каждый раз, когда играете Густой туман в ряду противника.","flavor":"Как увидишь свет в тумане, поворачивай обратно. Тут же.","glossary":"","power":4,"typeMask":4};
            values[132302]={"templateId":132302,"description":"Усильте этот отряд на 1 ед., если в конце хода на поле есть Густой туман.","flavor":"Есть множество потаенных страхов. Страх перед туманом обоснован...","glossary":"","power":10,"typeMask":4};
            values[132303]={"templateId":132303,"description":"Нанесите 5 ед. урона вражескому отряду.","flavor":"Это было нечто, что жило только затем, чтобы убивать.","glossary":"","power":6,"typeMask":4};
            values[132304]={"templateId":132304,"description":"Призовите все копии этого отряда в тот же ряд.","flavor":"Полукраб, полупаук. Словом, та еще гадина.","glossary":"","power":3,"typeMask":4};
            values[132305]={"templateId":132305,"description":"Каждый раз, когда вы поглощаете карту, усиливайте этот отряд на 1 ед., если он находится в руке, в колоде или на поле.\nЗавещание: призовите копию этого отряда в то же место.","flavor":"Мелкие, быстрые, гнусные.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":4,"typeMask":4};
        }
        private static function page6():void {
            values[132306]={"templateId":132306,"description":"Поглотите бронзовый или серебряный отряд из вашего сброса и усильте эту карту на силу поглощенного отряда.","flavor":"Ходят гули вдоль дороги, съели руки, съели ноги.","glossary":"","power":4,"typeMask":4};
            values[132307]={"templateId":132307,"description":"Очистите ряд от Бедствий.","flavor":"Как грифон, только архиопасный.","glossary":"","power":10,"typeMask":4};
            values[132308]={"templateId":132308,"description":"Поглотите отряд справа и усильте эту карту на силу поглощенного отряда.\nПовторяйте эту способность в начале каждого 2-го хода.","flavor":"Они сидели на конях неподвижно, как каменные. Он видел их оружие - короткие дротики с широким наконечником. Мечи с чудно выкованной гардой. Бердыши. Зубатые гизармы.","glossary":"","power":6,"typeMask":4};
            values[132309]={"templateId":132309,"description":"Нанесите 3 ед. урона вражескому отряду. Если он уничтожен или на него действует Трескучий мороз, усильте эту карту на 2 ед.","flavor":"Белый Хлад близко.","glossary":"","power":7,"typeMask":4};
            values[132310]={"templateId":132310,"description":"Увеличьте на 1 ед. урон, который наносит Трескучий мороз в противоположном ряду.","flavor":"В движущейся по небу ленте проявляются нечетко кошмарные силуэты всадников. Качаются буйволиные рога и оборванные плюмажи на шлемах. Из-под шлемов белеют оскалы черепов.","glossary":"Урон: уменьшает текущую силу отряда.","power":10,"typeMask":4};
            values[132312]={"templateId":132312,"description":"Активируйте способность Завещание у бронзового дружественного отряда.","flavor":"Грифоны любят помучать. Едят живьем, по кусочку.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":9,"typeMask":4};
            values[132313]={"templateId":132313,"description":"Истощите отряд на 3 ед. силы.","flavor":"Экимма - это как бы нетопырь... Только размером с человека.","glossary":"","power":5,"typeMask":4};
            values[132314]={"templateId":132314,"description":"Переместите вражеский отряд в ряд, противоположный этому отряду, и нанесите ему 2 ед. урона. Если этот ряд находится под действием Бедствия, нанесите 4 ед. урона.","flavor":"Хотя ведьмак вельми алчен и на золото падок, не давать оному за утопца более, чем серебряный грош либо полтора.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":7,"typeMask":4};
            values[132315]={"templateId":132315,"description":"Призывайте копию этого отряда в то же место каждый раз, когда уничтожаете дружественного зверя.","flavor":"Спрячьте украшения, сударыня. Не то гарпии слетятся.","glossary":"","power":4,"typeMask":4};
            values[132316]={"templateId":132316,"description":"При поглощении этого отряда усильте поглощающий отряд на 4 ед.\nЗавещание: создайте Молодую гарпию в случайном ряду.","flavor":"Омлет из яиц гарпии - вкуснейший деликатес. Однако эти твари не спешат отдавать свои яйца.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":1,"typeMask":4};
            values[132402]={"templateId":132402,"description":"Сыграйте Трескучий мороз из вашей колоды.","flavor":"Отважных только смерть одна лишь встретит. Она вскричит: убить! И спустит псов войны.","glossary":"","power":4,"typeMask":4};
            values[132403]={"templateId":132403,"description":"Нет способности.","flavor":"\"Спокойно... я знаю, как приручить волка\" - последние слова ловчего Дунбара.","glossary":"","power":1,"typeMask":4};
            values[132404]={"templateId":132404,"description":"Нанесите 1 ед. урона случайному вражескому отряду.","flavor":"Один чародей считал их очаровательными. Его судьба дала начало поговорке \"Не играй с огнем\"...","glossary":"","power":1,"typeMask":4};
            values[132405]={"templateId":132405,"description":"Нет способности.","flavor":"Их легко перепутать с камнями, и подобная ошибка была фатальной для многих троллей.","glossary":"","power":4,"typeMask":4};
            values[132406]={"templateId":132406,"description":"Сыграйте бронзовый отряд со способностью Завещание из вашей колоды.","flavor":"Бойся не тьмы, но света.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":4,"typeMask":4};
            values[132407]={"templateId":132407,"description":"Призывайте копию этого отряда из вашей колоды в случайный ряд каждый раз, когда вскрываете карту в руке противника.","flavor":"Лишь самые могущественные волшебники Нильфгаарда освоили искусство сотворения големов. Иногда им даже удавалось заставить их сражаться во благо империи...","glossary":"","power":3,"typeMask":4};
            values[132408]={"templateId":132408,"description":"Нанесите по 2 ед. урона случайным вражеским отрядам (всего 5) в противоположном ряду.","flavor":"Ну допрыгались...","glossary":"","power":10,"typeMask":4};
            values[132409]={"templateId":132409,"description":"Нанесите 4 ед. урона вражескому отряду. Если на него действует Кровавая луна, нанесите 7 ед. урона.","flavor":"Этот идиот наслушался сказок, залил уши воском и не слышал наших криков. Ну и влепил нас прямо в скалы.","glossary":"","power":6,"typeMask":4};
            values[133301]={"templateId":133301,"description":"Усильте отряд на изначальную силу бронзового или серебряного отряда в вашей руке.","flavor":"Долговечнее обычного щита и уж точно более стильный.","glossary":"","power":0,"typeMask":2};
            values[133302]={"templateId":133302,"description":"Создайте бронзового трупоеда или инсектоида и усильте его на 1 ед.","flavor":"Ох и развелось тут паскуд... Без ведьмака уже и не проживешь.","glossary":"","power":0,"typeMask":2};
            values[142101]={"templateId":142101,"description":"Усильте эту карту на 1 ед. за каждого дружественного краснолюда и нанесите по 1 ед. урона вражескому отряду за каждого дружественного эльфа.","flavor":"Я унаследовала от отца способность принимать другие формы. Вернее, в моем случае, одну форму.","glossary":"","power":10,"typeMask":4};
            values[142102]={"templateId":142102,"description":"Сыграйте бронзовую или серебряную карту засады из вашей колоды.","flavor":"Мало кто досадил людям так, как он, потому и цена за его голову велика.","glossary":"","power":7,"typeMask":4};
            values[142103]={"templateId":142103,"description":"Нанесите 8 ед. урона вражескому отряду. Если уничтожите его, усильте всех эльфов в вашей руке на 1 ед.","flavor":"Он чертовски меток для парня с одним глазом.","glossary":"","power":6,"typeMask":4};
            values[142104]={"templateId":142104,"description":"Верните сильнейший бронзовый или серебряный отряд каждого игрока в колоду.","flavor":"Я простая деревенская девка. Только из лука лучше меня никто не стреляет.","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":6,"typeMask":4};
            values[142105]={"templateId":142105,"description":"Выберите отряды (всего 3). Укрепите дружественные на 2 ед. и переместите их в тот же ряд. Нанесите по 2 ед. урона вражеским и переместите их в ряд, противоположный этому отряду.","flavor":"Пить в одиночку - все равно что гадить в компании.","glossary":"","power":8,"typeMask":4};
        }
        private static function page7():void {
            values[142106]={"templateId":142106,"description":"Воскресите бронзовую или серебряную особую карту из сброса противника, затем удалите ее.","flavor":"Брокилон истекает кровью... Даже я не в силах его излечить.","glossary":"","power":8,"typeMask":4};
            values[142107]={"templateId":142107,"description":"Сыграйте бронзовую карту заклятия, Блага или Бедствия из вашей колоды дважды.","flavor":"Она известна тем, что прорицает конец света. Так что ее не очень любят в обществе.","glossary":"","power":2,"typeMask":4};
            values[142108]={"templateId":142108,"description":"Создайте Казнь или Эпидемию.","flavor":"Пришло твое время взглянуть смерти в глаза.","glossary":"","power":4,"typeMask":4};
            values[142201]={"templateId":142201,"description":"Укрепите всех других ваших краснолюдов в руке, в колоде или на поле на 1 ед.","flavor":"Я приказы исполнять умею. Без поучений обойдусь.","glossary":"","power":8,"typeMask":4};
            values[142202]={"templateId":142202,"description":"Создайте Густой туман, Чистое небо или Альзур: Гром.","flavor":"Ида Эмеан аэп Сивни. Как всегда таинственная.","glossary":"","power":4,"typeMask":4};
            values[142203]={"templateId":142203,"description":"Шпион.\nОднократность: возьмите особую карту и отряд. Одну из этих карт оставьте, вторую верните в вашу колоду.","flavor":"Я вижу людей насквозь: вы столь же сложны, как конструкция цепа.","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":13,"typeMask":4};
            values[142204]={"templateId":142204,"description":"Засада: когда противник спасует, переверните и усильте по несколько отрядов (всего 2) с каждой стороны на 2 ед.","flavor":"Я с удовольствием пырнула бы тебя, глядя в глаза. Но ты смердишь, человек.","glossary":"Засада: играется рубашкой вверх. При блокировке может быть отменена и перевернута.","power":6,"typeMask":4};
            values[142205]={"templateId":142205,"description":"В конце хода усильте случайный не шпионский отряд в вашей руке на 1 ед.","flavor":"Чума Катрионы, пожар в Венгерберге и атака кавалерии \"Врихедд\". Ничего страшней я не видал.","glossary":"","power":8,"typeMask":4};
            values[142206]={"templateId":142206,"description":"Измените статус блокировки у отряда и переместите его в тот же ряд на его стороне.","flavor":"Bloede dh'oine!","glossary":"","power":9,"typeMask":4};
            values[142207]={"templateId":142207,"description":"Сыграйте случайного бронзового или серебряного краснолюда из вашей колоды и укрепите его на 3 ед.","flavor":"С песней на устах! Только громко, чтобы все со страху в порты наложили!","glossary":"","power":2,"typeMask":4};
            values[142208]={"templateId":142208,"description":"Засада: когда на стороне противника будет сыгран отряд, переверните его и нанесите ему 7 ед. урона.","flavor":"Дочь госпожи Эитнэ унаследовала от нее неземную красоту и дикую ненависть ко всему людскому.","glossary":"Засада: играется рубашкой вверх. При блокировке может быть отменена и перевернута.","power":8,"typeMask":4};
            values[142209]={"templateId":142209,"description":"Нанесите урон, равный силе этого отряда. Если уничтожите отряд, усильте всех других ваших Дриад и отряды засады в руке, в колоде или на поле на 1 ед.","flavor":"Мона?.. Нет... нет. Я Браэнн, дочь Брокилона.","glossary":"Урон: уменьшает текущую силу отряда.","power":6,"typeMask":4};
            values[142210]={"templateId":142210,"description":"Засада: после 2 ходов переверните в начале хода и очаруйте сильнейший бронзовый или серебряный вражеский отряд с силой 5 ед. или меньше.","flavor":"Ненавижу вас, dh'oine. Все вы одинаковые.","glossary":"Засада: играется рубашкой вверх. При блокировке может быть отменена и перевернута.\n\nВражеский: любой отряд на стороне поля противника.\n\nСильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":7,"typeMask":4};
            values[142211]={"templateId":142211,"description":"В конце любого хода призовите этот отряд из вашей колоды в случайный ряд, если на поле окажется несколько дружественных эльфов (всего 5).","flavor":"Лучше умереть стоя, чем жить на коленях.","glossary":"","power":6,"typeMask":4};
            values[142212]={"templateId":142212,"description":"Переместите в случайные ряды все дружественные отряды, находящиеся в том же ряду, и усильте эту карту на 1 ед. за каждый перемещенный отряд.","flavor":"А я стоял на первой линии, там, где горячше всего было!","glossary":"","power":9,"typeMask":4};
            values[142213]={"templateId":142213,"description":"Стойкость.\nУсиливайте эту карту на 1 ед. каждый раз, когда появляется дружественный краснолюд.","flavor":"Про дракона Оквиста с Кварцевой горы слышал? Так знай, что это Ярпен Зигрин и его краснолюды уделали Оквиста.","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nСтойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.","power":8,"typeMask":4};
            values[142214]={"templateId":142214,"description":"Усиливайте этот отряд на 2 ед. каждый раз, когда достаете его или возвращаете в колоду.","flavor":"Любовь оправдывает любое безумие.","glossary":"","power":10,"typeMask":4};
            values[142301]={"templateId":142301,"description":"Усильте дружественные отряды (всего 2) на 3 ед.","flavor":"Подлатаю я вас, а как же. Но не бесплатно.","glossary":"","power":5,"typeMask":4};
            values[142302]={"templateId":142302,"description":"Снимите Бедствия с этого ряда и переместите отряд в тот же ряд на его стороне.","flavor":"Как перевести слово \"Врихедд\"? Не знаю. Но оно означает неприятности.","glossary":"","power":9,"typeMask":4};
            values[142303]={"templateId":142303,"description":"Поменяйте карту и усильте этот отряд на значение ее изначальной силы.","flavor":"Ненависть горит ярче, чем огонь. И режет глубже, чем какое бы то ни было острие.","glossary":"","power":5,"typeMask":4};
            values[142304]={"templateId":142304,"description":"Создайте Огненную ловушку в ряду противника.","flavor":"Носы у них, как у гончих. Глаз, как у сокола. А сердца из льда.","glossary":"","power":6,"typeMask":4};
            values[142305]={"templateId":142305,"description":"Нанесите 3 ед. урона вражескому отряду. Если не уничтожите отряд, усильте эту карту на 3 ед.","flavor":"Я всю жизнь кайлом машу. И с боевым топором как-нибудь управлюсь.","glossary":"","power":6,"typeMask":4};
            values[142306]={"templateId":142306,"description":"Стойкость.","flavor":"Биться с краснолюдами из Махакама... Все равно что уголь жевать.","glossary":"Стойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.","power":6,"typeMask":4};
            values[142307]={"templateId":142307,"description":"Засада: после 2 ходов переверните в начале хода.","flavor":"Заканчивай уже танцевать, долгоух хренов, а то я никак не попаду!","glossary":"Засада: играется рубашкой вверх. При блокировке может быть отменена и перевернута.","power":11,"typeMask":4};
            values[142308]={"templateId":142308,"description":"Посмотрите случайные бронзовые особые карты в вашей колоде (всего 2) и сыграйте 1 из них.","flavor":"Плевал я на идеи скоя'таэлей, а вот монетой не побрезгую.","glossary":"","power":1,"typeMask":4};
        }
        private static function page8():void {
            values[142309]={"templateId":142309,"description":"Усильте дружественных эльфов на 1 ед.\nАктивируйте эту способность каждый раз, когда меняете эту карту.","flavor":"Темерцы, реданцы - все едино. Все они должны... умереть.","glossary":"","power":6,"typeMask":4};
            values[142310]={"templateId":142310,"description":"Нанесите 3 ед. урона, а затем еще 1 ед. урона.","flavor":"Еще шаг, dh’oine, и я всажу тебе стрелу между глаз.","glossary":"","power":7,"typeMask":4};
            values[142311]={"templateId":142311,"description":"Переместите отряд в тот же ряд на его стороне. Если это дружественный отряд, усильте его на 3 ед.","flavor":"Главное - объединять приятное с полезным: бить по мордасам, а еще и деньгу за это получать.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":8,"typeMask":4};
            values[142312]={"templateId":142312,"description":"Усильте отряд в вашей руке на 3 ед.","flavor":"Эльф, краснолюд - какая разница? Деньги не пахнут.","glossary":"","power":7,"typeMask":4};
            values[142313]={"templateId":142313,"description":"Автоматически играйте этот отряд в случайном ряду каждый раз, когда меняете его.","flavor":"Вы хотите сказать, что эта эльфка танцевала на поле битвы? Вы умом тронулись, сотник?!","glossary":"","power":3,"typeMask":4};
            values[142314]={"templateId":142314,"description":"Нанесите 2 ед. урона вражескому отряду.\nНаносите 2 ед. урона вражескому отряду каждый раз, когда тот перемещается.\nНаносите 2 ед. урона случайному вражескому отряду каждый раз, когда эта карта перемещается.","flavor":"Можешь прятаться, только убежать ты все равно не успеешь.","glossary":"","power":7,"typeMask":4};
            values[142315]={"templateId":142315,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда появляется вражеский отряд.","flavor":"Я сражаюсь за тех, кто больше заплатит. Или за тех, кого легче обокрасть.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":7,"typeMask":4};
            values[142316]={"templateId":142316,"description":"Призовите все копии этого отряда в тот же ряд.\nУсиливайте этот отряд на 2 ед. каждый раз, когда он перемещается.","flavor":"Когда мы их услышали, было уже поздно...","glossary":"","power":3,"typeMask":4};
            values[142317]={"templateId":142317,"description":"Усильте дружественный отряд на 7 ед.","flavor":"Нарушение спокойствия в Махакаме сурово наказывается... обухом по башке.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":4,"typeMask":4};
            values[142401]={"templateId":142401,"description":"Усильте случайные карты в вашей руке (всего 2) на 1 ед.","flavor":"Столкнувшись с расизмом и ксенофобией, многие нелюди из городов решают присоединиться к отрядам скоя'таэлей.","glossary":"","power":10,"typeMask":4};
            values[143201]={"templateId":143201,"description":"Сыграйте бронзовую или серебряную особую карту из вашей колоды.","flavor":"Для нас земля родила и цвела, ибо любила нас.","glossary":"","power":0,"typeMask":2};
            values[143301]={"templateId":143301,"description":"Шпион.\nНанесите в конце хода по 2 ед. урона всем другим отрядам в ряду и удалите эту карту.","flavor":"Осторожно... Еще один шаг - и от вас останется дымящаяся лужа.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[152101]={"templateId":152101,"description":"Создайте Владыку Ундвика в противоположном ряду.","flavor":"Вместо того чтобы скорбеть над павшими, лучше выпьем в память о них!","glossary":"","power":16,"typeMask":4};
            values[152103]={"templateId":152103,"description":"Возьмите несколько карт (всего 2), затем сбросьте несколько карт (всего 2).","flavor":"Только невежды преуменьшают значение мифов.","glossary":"","power":10,"typeMask":4};
            values[152104]={"templateId":152104,"description":"Шпион.\nЗавещание: создайте Хеймдалля в случайном ряду на стороне этого отряда.","flavor":"Когда придет время, Камби запоет и разбудит Хеймдалля.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[152105]={"templateId":152105,"description":"Сыграйте Шторм Скеллиге в ряду противника.","flavor":"Скеллиге нужен сильный король. А там будь что будет.","glossary":"","power":6,"typeMask":4};
            values[152106]={"templateId":152106,"description":"Сбросьте бронзовый отряд из вашей колоды, затем нанесите вражескому отряду урон, равный изначальной силе сброшенного отряда.","flavor":"ЫААААААААААААХ!!!!","glossary":"Урон: уменьшает текущую силу отряда.","power":6,"typeMask":4};
            values[152107]={"templateId":152107,"description":"Обратите бронзовый или серебряный отряд в Нефритовую статуэтку.","flavor":"На самом деле ее зовут Астрид Литтнейд Асгейрфиннбьорнсдоттир, но это уже ни в какие рамки не лезет.","glossary":"","power":5,"typeMask":4};
            values[152109]={"templateId":152109,"description":"В конце хода укрепите отряд слева на 1 ед. и нанесите 1 ед. урона отряду справа.\n5 ед. брони.","flavor":"От одного его имени любой нильф штаны промочит.","glossary":"","power":8,"typeMask":4};
            values[152201]={"templateId":152201,"description":"Создайте Кита из Пещеры Снов в ряду противника.","flavor":"У меня уже зубы от скуки чешутся.","glossary":"","power":9,"typeMask":4};
            values[152202]={"templateId":152202,"description":"Вызовите вражеский отряд на дуэль.","flavor":"Он не откроет своего имени, покуда не будет побежден. Это странствующий тролль.","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.\n\nВражеский: любой отряд на стороне поля противника.","power":7,"typeMask":4};
            values[152203]={"templateId":152203,"description":"Нанесите по 1 ед. урона 2 дружественным отрядам и укрепите эту карту на 2 ед. за каждый поврежденный отряд.","flavor":"Если в гончем листе написано \"живым или мертвым\", многие охотники тебя просто убьют... только не я. Если я тебя поймаю, тебя повесят.","glossary":"Поврежденный: отряд, обладающий меньшей силой, чем изначальная.","power":10,"typeMask":4};
            values[152204]={"templateId":152204,"description":"Измените статус блокировки у отряда, затем переместите бронзовый отряд из сброса противника в ваш сброс.","flavor":"Я собрал совет ярлов по твоему требованию. Изложи свое дело.","glossary":"","power":8,"typeMask":4};
            values[152205]={"templateId":152205,"description":"Укрепите отряды (всего 2, но не лидера) в вашем сбросе на 3 ед.","flavor":"Послушай сагу о геройских деяниях воинов клана ан Крайт.","glossary":"","power":6,"typeMask":4};
            values[152206]={"templateId":152206,"description":"Создайте Проливной дождь, Чистое небо или Леденящий кровь рык.","flavor":"Архидруид, мастер алхимии, и вместе с тем - самый вредный дед на Островах.","glossary":"","power":4,"typeMask":4};
        }
        private static function page9():void {
            values[152207]={"templateId":152207,"description":"Нанесите 6 ед. урона. Если уничтожите отряд, укрепите сильнейший отряд в вашем сбросе на 3 ед.","flavor":"Фареры - это скалы, поросшие соснами, а нам большего и не надо.","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":6,"typeMask":4};
            values[152208]={"templateId":152208,"description":"Нанесите 1 ед. урона этой карте.","flavor":"Некоторые зовут ее \"Железной Девой\".","glossary":"","power":13,"typeMask":4};
            values[152209]={"templateId":152209,"description":"Воскрешайте этот отряд в случайном ряду каждый раз, когда его сбрасывают. Воскрешайте этот отряд в том же месте каждый раз, когда его уничтожают. После этого ослабляйте его наполовину.","flavor":"Самый скверный человек на Скеллиге.","glossary":"","power":9,"typeMask":4};
            values[152210]={"templateId":152210,"description":"Каждый раз, когда отряд играют на стороне противника из любой руки, наносите ему 1 ед. урона.","flavor":"Ручной?! Эй, парень, мы на Скеллиге приручаем медведей, но это не делает их ручными...","glossary":"","power":9,"typeMask":4};
            values[152211]={"templateId":152211,"description":"Воскресите бронзовый или серебряный отряд клана.","flavor":"Пади на колени и моли Модрон Фрейю о милости.","glossary":"","power":3,"typeMask":4};
            values[152213]={"templateId":152213,"description":"Возьмите карту, затем сбросьте карту.","flavor":"Император тоже считал его временщиком. Сперва.","glossary":"","power":9,"typeMask":4};
            values[152214]={"templateId":152214,"description":"Шпион.\nОднократность: посмотрите 2 карты в вашей колоде. Возьмите одну и сбросьте вторую.","flavor":"Хаааа! За мной, кто смел!","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":13,"typeMask":4};
            values[152301]={"templateId":152301,"description":"Обратите этот отряд в Разъяренного медведя, когда ему нанесут урон или ослабят.","flavor":"Из песен скальдов следует, что охваченные боевой яростью берсерки на первый взгляд ничем не отличались от обычного медведя.","glossary":"Урон: уменьшает текущую силу отряда.","power":8,"typeMask":4};
            values[152302]={"templateId":152302,"description":"Усильте эту карту на 1 ед. за каждый поврежденный или проклятый дружественный отряд.","flavor":"Доедай давай, не то придет берсерк и сожрет тебя целиком.","glossary":"Поврежденный: отряд, обладающий меньшей силой, чем изначальная.\n\nДружественный: любой отряд на вашей стороне поля.","power":9,"typeMask":4};
            values[152303]={"templateId":152303,"description":"Нанесите 1 ед. урона этой карте.","flavor":"Я принесу клану ан Крайт славу, а мое имя будут славить в песнях!","glossary":"","power":12,"typeMask":4};
            values[152304]={"templateId":152304,"description":"Нанесите 5 ед. урона.","flavor":"Охотимся, а то как же. Только зверье у нас на Спикерооге дрянь...","glossary":"","power":6,"typeMask":4};
            values[152305]={"templateId":152305,"description":"Сбросьте все копии этой карты из вашей колоды.","flavor":"В их глазах я вижу страх. Они боятся... За мной! За клан Димун!","glossary":"","power":11,"typeMask":4};
            values[152306]={"templateId":152306,"description":"Сыграйте другой бронзовый отряд клана Димун из вашей колоды.","flavor":"Подтянись, выше знамя!","glossary":"","power":1,"typeMask":4};
            values[152307]={"templateId":152307,"description":"Воскресите все копии этого отряда в том же ряду.","flavor":"Королеву охраняют самые выносливые и самые отчаянные девушки-щитоносцы, какие только есть на Скеллиге.","glossary":"","power":4,"typeMask":4};
            values[152308]={"templateId":152308,"description":"Усильте все дружественные отряды из клана по вашему выбору на 1 ед.","flavor":"Деяния воинов клана Хэймэй останутся в веках.","glossary":"","power":9,"typeMask":4};
            values[152309]={"templateId":152309,"description":"В конце хода нанесите 1 ед. урона отряду справа и усильте эту карту на 2 ед.","flavor":"Уйти от них? По водам Скеллиге? Удачи.","glossary":"","power":7,"typeMask":4};
            values[152310]={"templateId":152310,"description":"Воскресите бронзового солдата.","flavor":"Модрон Фрейя, Великая Мать, богиня любви, красоты и урожая.","glossary":"","power":1,"typeMask":4};
            values[152311]={"templateId":152311,"description":"Укрепите дружественный отряд на 2 ед. и добавьте ему 2 ед. брони.","flavor":"Запомни мои слова: хороший щит может спасти тебе жизнь.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":9,"typeMask":4};
            values[152312]={"templateId":152312,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда в противоположном ряду наносят урон вражескому отряду.\n2 ед. брони.","flavor":"Меч - оружие женщин. Сделай себе топор.","glossary":"Урон: уменьшает текущую силу отряда.","power":6,"typeMask":4};
            values[152313]={"templateId":152313,"description":"Укрепляйте этот отряд на 3 ед. каждый раз, когда его воскрешают.","flavor":"Для друзей у нас есть сердце, а для врагов - топор. Помни об этом.","glossary":"","power":8,"typeMask":4};
            values[152314]={"templateId":152314,"description":"Нанесите 2 ед. урона случайному вражескому отряду.\nПовторяйте эту способность каждый раз, когда вы сбрасываете карту.","flavor":"Говорят, что когда драккары уходят в набег, сердце Хеймдалля наполняется радостью.","glossary":"","power":7,"typeMask":4};
            values[152315]={"templateId":152315,"description":"Нанесите по 1 ед. урона 3 отрядам.","flavor":"Ты попадешь в движущуюся цель с двухсот шагов? И я тоже. В шторм.","glossary":"","power":8,"typeMask":4};
            values[152316]={"templateId":152316,"description":"Воскрешайте этот отряд в случайном ряду каждый раз, когда сбрасываете его.","flavor":"Мы - ан Крайты! За что другие платят золотом, мы платим жизнью и кровью.","glossary":"","power":4,"typeMask":4};
            values[152317]={"templateId":152317,"description":"Исцелите несколько дружественных отрядов (всего 2) и добавьте им 3 ед. брони.","flavor":"Наклепаем как-нибудь.","glossary":"","power":7,"typeMask":4};
            values[152318]={"templateId":152318,"description":"Призовите все копии этого отряда в тот же ряд.","flavor":"Они разобьются о наши щиты, как волны о берег.","glossary":"","power":3,"typeMask":4};
        }
        private static function page10():void {
            values[152401]={"templateId":152401,"description":"Шпион.\nЗавещание: усильте вражеских Хьялмаров на 10 ед.","flavor":"По его вине остров Ундвик, дом некогда гордого клана Тордаррох, превратился в унылую обитель былой славы...","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":5,"typeMask":4};
            values[152402]={"templateId":152402,"description":"Уничтожьте все другие отряды и очистите ряды от всех Благ и Бедствий.","flavor":"Когда придет Час Белого Холода, Хеймдалль призовет нас на битву.","glossary":"","power":20,"typeMask":4};
            values[152403]={"templateId":152403,"description":"Шпион.\nПереместите в случайный ряд и нанесите в конце хода по 1 ед. урона всем другим находящимся там отрядам.","flavor":"\"Ну для финвала-то он большеват. Это кит-полосатик.\" \"Полосатик? С такой короткой мордой?\"","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":3,"typeMask":4};
            values[152405]={"templateId":152405,"description":"Нет способности.","flavor":"Р-р-р-р!","glossary":"","power":12,"typeMask":4};
            values[152406]={"templateId":152406,"description":"Нет способности.","flavor":"Первый час медведь спит. Второй час медведь храпит. Третий час... спасайся, кто может!","glossary":"","power":11,"typeMask":4};
            values[153201]={"templateId":153201,"description":"Верните бронзовый или серебряный отряд Скеллиге из вашего сброса в вашу руку, добавьте ему категорию Обреченность и сделайте его изначальную силу равной 8 ед. Затем сыграйте карту.","flavor":"Сраные чародеи обломали нам всю малину... К чему мучиться часами у операционного стола, если такая вот надушенная дамочка может решить дело одним движением руки?","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.","power":0,"typeMask":2};
            values[153301]={"templateId":153301,"description":"Нанесите по 3 ед. урона всем отрядам в одном ряду.","flavor":"Страшное было зрелище... Кровища повсюду: бестия беднягу в клочья разорвала.","glossary":"","power":0,"typeMask":2};
            values[162101]={"templateId":162101,"description":"Шпион.\nДобавьте блокировку отрядам в том же ряду (всего 2), затем истощите всю их силу.","flavor":"Жду желающих меня убить.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[162102]={"templateId":162102,"description":"Нанесите 4 ед. урона вражескому отряду. Если этот отряд - Шпион, уничтожьте его.","flavor":"Погодите, я вас научу заниматься разведкой!","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":8,"typeMask":4};
            values[162103]={"templateId":162103,"description":"Вскройте ваши карты (до 2), затем случайным образом вскройте столько же карт противника.","flavor":"Нет такой проблемы, которую нельзя было бы решить заказным убийством.","glossary":"","power":11,"typeMask":4};
            values[162104]={"templateId":162104,"description":"Воскресите лидера.","flavor":"Разыскивается за убийство, дезертирство, воровство и подделку документов...","glossary":"","power":1,"typeMask":4};
            values[162105]={"templateId":162105,"description":"Уничтожьте дружественный отряд и сыграйте верхнюю карту из вашей колоды или перемирие: уничтожьте вражеский отряд, после чего ваш противник возьмет бронзовую карту и вскроет ее.","flavor":"Все мы пешки на его шахматной доске. В игре, правил которой не знаем.","glossary":"Вражеский: любой отряд на стороне поля противника.\n\nДружественный: любой отряд на вашей стороне поля.\n\nПеремирие: если оба игрока еще не спасовали.","power":9,"typeMask":4};
            values[162106]={"templateId":162106,"description":"Переместите любую карту из вашей колоды на ее верх. Если это не шпион, усильте ее на 5 ед.","flavor":"Шрам на лице будущей императрицы - это мое наивысшее достижение.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":10,"typeMask":4};
            values[162107]={"templateId":162107,"description":"Перемирие: усильте эту карту на 15 ед., после чего противник возьмет вскрытую бронзовую карту.","flavor":"О рвении Тибора слагали легенды. Говорили, что перед императором он не кланяется, а кувыркается.","glossary":"Перемирие: если оба игрока еще не спасовали.","power":10,"typeMask":4};
            values[162108]={"templateId":162108,"description":"Посмотрите карты в колоде противника и переместите одну карту в низ колоды.","flavor":"Астрология, гидромантия, гаруспиция, церомантия. Овомантия, туфрамантия, метроскопия, бронхоскопия...","glossary":"","power":13,"typeMask":4};
            values[162201]={"templateId":162201,"description":"Перемирие: каждый игрок берет карту. Противник вскрывает свою карту.","flavor":"Огненный шар? Как пожелаете!","glossary":"Перемирие: если оба игрока еще не спасовали.","power":10,"typeMask":4};
            values[162202]={"templateId":162202,"description":"Верните бронзовые или серебряные карты (всего 2) из любого сброса в колоду соответствующего игрока.","flavor":"У нильфгаардских чародеев тоже есть выбор: служба императору - или эшафот.","glossary":"","power":11,"typeMask":4};
            values[162203]={"templateId":162203,"description":"Вскройте сильнейший отряд в руке противника и усильте эту карту на силу вскрытого отряда.","flavor":"Талант Цинтии огромен. Ей нужен поводок покороче.","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":5,"typeMask":4};
            values[162204]={"templateId":162204,"description":"Восстановите дружественный отряд и укрепите его на 3 ед. или восстановите вражеский отряд и ослабьте его на 3 ед.","flavor":"Какое я тебе \"ваше превосходительство\", крестьянин я. Так и давай говорить, как мужик с мужиком.","glossary":"Вражеский: любой отряд на стороне поля противника.\n\nДружественный: любой отряд на вашей стороне поля.","power":6,"typeMask":4};
            values[162205]={"templateId":162205,"description":"Шпион.\nСкопируйте силу отряда слева и передайте ее отряду справа.","flavor":"Ах, как приятно наложить наконец какое-нибудь заклинание...","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[162206]={"templateId":162206,"description":"Выберите вражеский отряд или вскрытый отряд в руке противника и переместите все его копии из колоды противника в сброс.","flavor":"А ну, за работу, паршивцы!","glossary":"Вражеский: любой отряд на стороне поля противника.","power":9,"typeMask":4};
            values[162207]={"templateId":162207,"description":"Создайте Трескучий мороз, Чистое небо или Сорокопутку.","flavor":"Люблю играть с огнем. Особенно с нордлингами.","glossary":"","power":4,"typeMask":4};
            values[162208]={"templateId":162208,"description":"Измените статус блокировки у отрядов (всего 2).","flavor":"У Лето был план... Что же пошло не так?","glossary":"","power":7,"typeMask":4};
            values[162209]={"templateId":162209,"description":"Нанесите 7 ед. урона вражескому отряду или сделайте силу вскрытого вражеского отряда равной 1 ед.","flavor":"Мы делаем то, что должны, и я этого не стыжусь.","glossary":"","power":6,"typeMask":4};
            values[162210]={"templateId":162210,"description":"Шпион.\nОднократность: возьмите карты (всего 2). Одну оставьте, остальные положите в низ вашей колоды.","flavor":"Мужчину нужно постоянно соблазнять таинственностью и изысканным обхождением.","glossary":"Однократность: способность этой карты можно использовать лишь один раз за игру.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":13,"typeMask":4};
        }
        private static function page11():void {
            values[162211]={"templateId":162211,"description":"Шпион.\nСыграйте верхний не шпионский бронзовый или серебряный отряд из вашей колоды и усильте его на 10 ед.","flavor":"Герцог де Ветт командовал оперативной группой \"Верден\" таким образом, для которого определение \"неудачно\" следует считать исключительно деликатным.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":5,"typeMask":4};
            values[162212]={"templateId":162212,"description":"Шпион. Если шпионит, усильте эту карту на 1 ед. в начале хода. Когда этот игрок спасует, переместите в противоположный ряд.\nЗавещание: уничтожьте слабейший отряд в ряду.","flavor":"\"Вот он приближается - интерес империи, - подумал он. - Лжепринцесса, лжекоролева Цинтры, лжевладелица устья реки Ярры, которое так необходимо империи\".","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nСлабейший: с наименьшей силой; если силы равны, выбирается случайным образом.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":8,"typeMask":4};
            values[162213]={"templateId":162213,"description":"Создайте Посла, Убийцу или Эмиссара.","flavor":"\"Ваше величество, - с трудом проговорил сенешаль, на которого до сих пор никто, казалось, не обращал внимания. - Покорнейше прошу помиловать... Кагыр... Мой сын...\"","glossary":"","power":2,"typeMask":4};
            values[162301]={"templateId":162301,"description":"Автоматически играйте этот отряд в случайном ряду и берите карту каждый раз, когда вы вскрываете его.","flavor":"Отравить колодцы? Так ведь... Это же недостойно!","glossary":"","power":4,"typeMask":4};
            values[162302]={"templateId":162302,"description":"Создайте Коровью тушу в ряду противника.","flavor":"Пускай историки спорят, этично ли заносить чуму в осажденный город. Для нас главное, что это чрезвычайно эффективно.","glossary":"","power":8,"typeMask":4};
            values[162303]={"templateId":162303,"description":"Усильте эту карту на изначальную силу вскрытого бронзового или серебряного отряда.","flavor":"На севере нет ничего, чем можно нас удивить.","glossary":"","power":5,"typeMask":4};
            values[162304]={"templateId":162304,"description":"Воскресите бронзовый отряд из сброса противника.","flavor":"На свете было столько же эпидемий чумы, сколько и войн. И, несмотря на это, и чума, и война по-прежнему застают людей врасплох.","glossary":"","power":1,"typeMask":4};
            values[162305]={"templateId":162305,"description":"Нанесите 3 ед. урона вражескому отряду. Если этот отряд шпионит, нанесите 6 ед. урона.","flavor":"Я всегда бью по коленям.","glossary":"","power":7,"typeMask":4};
            values[162306]={"templateId":162306,"description":"Нанесите 5 ед. урона вражескому отряду.\nАктивируйте способность этой карты каждый раз, когда вскрываете эту карту.","flavor":"Название полностью сбивает с толку. Звучит так, будто это жирный алый арахнид, а не изящно сконструированное оружие массового поражения…","glossary":"","power":5,"typeMask":4};
            values[162307]={"templateId":162307,"description":"Усильте эту карту на 2 ед. за каждый вражеский шпионский отряд. Усиливайте эту карту на 2 ед. каждый раз, когда появляется вражеский шпионский отряд.","flavor":"Бригада \"Импера\" не сдается. Никогда.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":6,"typeMask":4};
            values[162308]={"templateId":162308,"description":"Нанесите 2 ед. урона вражескому отряду.\nЗа каждый вражеский шпионский отряд, появляющийся во время вашего хода, наносите в конце хода по 2 ед. урона вражескому отряду.","flavor":"Солдаты императорской гвардии фанатично преданны и сражаются до последнего.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":6,"typeMask":4};
            values[162309]={"templateId":162309,"description":"Очистите ряд от Бедствий и усильте дружественный или вскрытый отряд в вашей руке на 3 ед.","flavor":"Император приучит Север к дисциплине.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":7,"typeMask":4};
            values[162310]={"templateId":162310,"description":"Нанесите 7 ед. урона шпионскому отряду. Если уничтожите его, укрепите эту карту на 4 ед.","flavor":"- Это Дикая Охота? - Нет. Это кавалерийская бригада \"Наузикаа\".","glossary":"","power":5,"typeMask":4};
            values[162311]={"templateId":162311,"description":"Призовите все копии этого отряда в тот же ряд.","flavor":"Присягни нашему императору - или умри.","glossary":"","power":3,"typeMask":4};
            values[162312]={"templateId":162312,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда любой игрок берет карту.","flavor":"Смерть и слава!","glossary":"","power":10,"typeMask":4};
            values[162313]={"templateId":162313,"description":"Усильте дружественный отряд на 5 ед.\nПодкрепление.","flavor":"Не сказал бы, что цивилизация не развивается. На каждой новой войне способы убийства все более совершенны.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.\n\nДружественный: любой отряд на вашей стороне поля.","power":6,"typeMask":4};
            values[162314]={"templateId":162314,"description":"Шпион.\nПосмотрите случайные бронзовые отряды (всего 2) в вашей колоде и сыграйте 1 из них.","flavor":"Но ведь... так не годится! Не убивайте посланца!","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":2,"typeMask":4};
            values[162315]={"templateId":162315,"description":"Шпион.\nУсильте дружественный отряд на 12 ед.","flavor":"Шпион - громко сказано. Я, скорее, наблюдатель.","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":2,"typeMask":4};
            values[162316]={"templateId":162316,"description":"Вскройте карты (всего 2).","flavor":"Две унции calcium equum, одна унция рубедо...","glossary":"","power":9,"typeMask":4};
            values[162317]={"templateId":162317,"description":"Нанесите 2 ед. урона случайному вражескому отряду.\nПовторяйте способность этого отряда каждый раз, когда вы вскрываете карту.","flavor":"\"Это рухлядь еще работает?!\" \"Смотря что ты имеешь в виду...\"","glossary":"","power":7,"typeMask":4};
            values[162318]={"templateId":162318,"description":"Вскройте случайную карту в вашей руке, отдавая предпочтение сначала бронзовым, потом серебряным, потом золотым картам.\n2 ед. брони.","flavor":"Мальчики из дворянских семейств Города Золотых Башен составляют элиту имперской армии.","glossary":"","power":12,"typeMask":4};
            values[162401]={"templateId":162401,"description":"Добавьте Малого стража на верх колоды противника.","flavor":"От чужаков, пришедших с мечами, сохранят каменные кулаки. От чужаков, пришедших с ложью, сохранит железная логика.","glossary":"","power":11,"typeMask":4};
            values[162402]={"templateId":162402,"description":"Шпион.\nПосле 2 ходов уничтожьте в конце хода все другие слабейшие отряды в ряду и удалите эту карту.","flavor":"Это птица? Может, грифон? Нет! Это...","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[163101]={"templateId":163101,"description":"Нанесите 8 ед. урона вражескому отряду. Повторите один раз.","flavor":"Сколько стоит жизнь человека? Зависит от человека - твоя, к примеру, не больше сотни оренов.","glossary":"","power":0,"typeMask":2};
            values[163201]={"templateId":163201,"description":"Заставьте несколько смежных вражеских отрядов (всего 2) вызвать друг друга на дуэль.","flavor":"Многие полагают, что сила империи - в ее дисциплинированных солдатах и послушных магах. Правда же в том, что миром правит нильфгаардский флорен.","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.","power":0,"typeMask":2};
        }
        private static function page12():void {
            values[200008]={"templateId":200008,"description":"Усильте случайные дружественные отряды (всего 6) на 2 ед.","flavor":"В ту ночь у луны был цвет крови.","glossary":"","power":0,"typeMask":2};
            values[200009]={"templateId":200009,"description":"Нанесите по 2 ед. урона случайным вражеским отрядам (всего 6).","flavor":"Зелья смертельно опасны для людей, тогда как для ведьмаков они лишь токсичны. Впрочем, даже они отмеряют каждую каплю, чтобы не превысить допустимую дозу... и не заплатить наивысшую цену.","glossary":"","power":0,"typeMask":2};
            values[200018]={"templateId":200018,"description":"Сыграйте Бедствие в каждом ряду противника, которое в начале хода наносит 2 ед. урона его слабейшему отряду.","flavor":"Ученые из Виковаро установили, что пораженные засухой провинции, оставшись без имперской помощи, теряют половину населения, две трети поголовья скота и всякую волю к сопротивлению.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[200019]={"templateId":200019,"description":"Усильте слабейший бронзовый или серебряный отряд в вашей колоде на 2 ед. и сыграйте его.","flavor":"Мы всего лишь пешки в игре стариков. Нас посылают на битвы и смерть в угоду их маразматическим капризам...","glossary":"Слабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":0,"typeMask":2};
            values[200020]={"templateId":200020,"description":"Удалите бронзовый или серебряный отряд из любого сброса, затем усильте дружественный отряд на силу удаленного отряда.","flavor":"Мы заставим тебя говорить... живого или мертвого.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[200021]={"templateId":200021,"description":"Уничтожьте дружественный отряд.\nСоздайте Медведя.","flavor":"Сперва мы наткнулись на медведя... а потом дела пошли еще хуже.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[200022]={"templateId":200022,"description":"Создайте базовую копию последнего бронзового или серебряного отряда (не агента), появившегося на поле.","flavor":"Есть много других реальностей, помимо нашей... Овладев нужными знаниями, можно вступить с ними в контакт и призвать оттуда существ, глубоко чуждых человеческому разуму.","glossary":"","power":0,"typeMask":2};
            values[200023]={"templateId":200023,"description":"Нанесите по 4 ед. урона 3 смежным отрядам.","flavor":"\"Если вещество попало в глаза, немедленно промойте их холодной водой и начинайте писать завещание\".","glossary":"","power":0,"typeMask":2};
            values[200026]={"templateId":200026,"description":"Выберите любой бронзовый дружественный отряд Дикой Охоты, который не является чародеем, и сыграйте его копию из вашей колоды.","flavor":"На протяжении сотен лет Аваллак'х пытался воссоздать ген Старшей Крови, используя обратное скрещивание, но зачатые таким образом эльфийские дети были тусклыми искрами на фоне пламени Лары.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":3,"typeMask":4};
            values[200028]={"templateId":200028,"description":"Нанесите 2 ед. урона вражескому отряду. Если этот отряд уже поврежден, уничтожьте его.","flavor":"Кровь за Свальблода! Черепа за престол!","glossary":"","power":11,"typeMask":4};
            values[200030]={"templateId":200030,"description":"Нанесите 6 ед. урона отрядам на конце ряда.","flavor":"Старый барон был беспощаден к браконьерам. К счастью для Милаэн, старый барон был уже покойником, а его люди давно превратились в отчаявшихся бродяг.","glossary":"","power":4,"typeMask":4};
            values[200031]={"templateId":200031,"description":"Вскройте один из ваших отрядов и нанесите вражескому отряду урон, равный изначальной силе вскрытого отряда.","flavor":"Он только сидел и молча таращился на меня. Глаза у него были такие... ну, какие-то рыбьи, что ли. Без бровей, без ресниц... Какие-то водянистые шарики, и в каждом - черное ядрышко. Он таращился на меня и молчал. И этим угнетал еще больше, чем избиениями.","glossary":"Урон: уменьшает текущую силу отряда.","power":7,"typeMask":4};
            values[200032]={"templateId":200032,"description":"Сыграйте бронзовую или серебряную карту шпионского отряда из вашей колоды.","flavor":"Аттре пало вслед за Цинтрой, и перед защитниками встал выбор: принять оковы Нильфгаарда или погибнуть.","glossary":"","power":5,"typeMask":4};
            values[200033]={"templateId":200033,"description":"Сыграйте случайную бронзовую карту Бедствия из вашей колоды.","flavor":"Для учениц не жалеют ничего, живут в Аретузе как принцессы. А ими кормится половина города - портные, сапожники, кондитеры, поставщики...","glossary":"","power":3,"typeMask":4};
            values[200036]={"templateId":200036,"description":"Сбросьте бронзовую карту из вашей колоды.","flavor":"Хватай все и тащи на драккар!","glossary":"","power":8,"typeMask":4};
            values[200037]={"templateId":200037,"description":"Уничтожьте дружественный отряд и нанесите вражескому отряду урон, равный силе уничтоженного отряда.","flavor":"Не пялься ему в глаз, он этого терпеть не может...","glossary":"Урон: уменьшает текущую силу отряда.\n\nДружественный: любой отряд на вашей стороне поля.","power":11,"typeMask":4};
            values[200038]={"templateId":200038,"description":"Переместите в случайный ряд и нанесите 1 ед. урона случайному вражескому отряду в начале хода.\nЗавещание: нанесите 4 ед. урона случайному вражескому отряду.","flavor":"Согласно народным поверьям, они растут на орошенной кровью земле. Поэтому чаще всего они встречаются там, где в прошлом происходили погромы, кровавые ритуалы или жестокие убийства.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":7,"typeMask":4};
            values[200039]={"templateId":200039,"description":"Каждый раз, когда играете особую карту, усиливайте этот отряд на 1 ед., если он находится в руке, в колоде или на поле.","flavor":"Пока мы живы, ни один человек не посмеет топтать луга Дол Блатанна.","glossary":"","power":2,"typeMask":4};
            values[200040]={"templateId":200040,"description":"Каждый 2-й ход, если этот отряд поврежден, исцеляйте его в начале хода и укрепляйте на 2 ед.","flavor":"Ух, здорово ты насмешил меня, нордлинг! Ты даже взять его не можешь как следует, а не то что меня разрубить.","glossary":"","power":8,"typeMask":4};
            values[200041]={"templateId":200041,"description":"Нанесите по 1 ед. урона всем вражеским отрядам, кроме тех, что находятся в противоположном ряду. Если этот отряд вскрыт, нанесите урон всем вражеским отрядам.","flavor":"Нильфгаард славится своими скорпионами.","glossary":"Урон: уменьшает текущую силу отряда.","power":8,"typeMask":4};
            values[200042]={"templateId":200042,"description":"Усиливайте этот отряд на 2 ед. каждый раз, когда его сила изменяется (но не когда отряд восстанавливается).","flavor":"Охотиться на крутых склонах Махакама не очень-то и легко, но и опасностей краснолюды не очень-то боятся.","glossary":"","power":7,"typeMask":4};
            values[200043]={"templateId":200043,"description":"Создайте Вильфреда слева от этого отряда, Вильхельма справа и Вильмара в противоположном ряду.","flavor":"В прошлом гордый ярл клана Тордаррох, теперь же - просто ворчливый безумец.","glossary":"","power":6,"typeMask":4};
            values[200044]={"templateId":200044,"description":"Сыграйте случайный бронзовый предмет из вашей колоды.","flavor":"Я знаю, что император хочет защищать все свои владения... но гарнизон в этой треклятой пустоши - все равно что пояс верности на кладбищенской бабе.","glossary":"","power":3,"typeMask":4};
            values[200046]={"templateId":200046,"description":"Укрепите все другие ваши отряды клана Тиршах в руке, в колоде или на поле на 1 ед.","flavor":"За свою жизнь я видел чудеса, о которых никто и не мечтает, и творил вещи, которых никто не должен делать.","glossary":"","power":7,"typeMask":4};
            values[200048]={"templateId":200048,"description":"Поменяйте карту в вашей руке на бронзовую особую карту из вашей колоды.","flavor":"Я постоянно сравниваю результаты адепток из Аретузы с достижениями мальчиков из школы в Бан Арде, и сравнение неизменно склоняется в пользу девочек.","glossary":"","power":9,"typeMask":4};
        }
        private static function page13():void {
            values[200049]={"templateId":200049,"description":"Нанесите 3 ед. урона вражескому отряду. Если уничтожите его, нанесите 3 ед. урона другому вражескому отряду.\nКоманда: увеличьте изначальный урон на 1 ед.","flavor":"Не открывают? Значит, надо постучать сильнее.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".\n\nУрон: уменьшает текущую силу отряда.","power":6,"typeMask":4};
            values[200050]={"templateId":200050,"description":"Сотворите бронзового Нильфгаардского солдата.","flavor":"Великое Солнце согреет Север своими лучами, даже если мне придется для этого вырезать всех вас до единого!","glossary":"","power":4,"typeMask":4};
            values[200052]={"templateId":200052,"description":"Усильте эту карту на 7 ед.\nНаносите этому отряду 2 ед. урона каждый раз, когда ему наносят урон.","flavor":"Говорят, что Голиаф когда-то был славным рыцарем. К сожалению, однажды он прогневал Владычицу Озера, и та превратила его в чудовище.","glossary":"Урон: уменьшает текущую силу отряда.","power":10,"typeMask":4};
            values[200053]={"templateId":200053,"description":"Обратите бронзовый или серебряный отряд в Нефритовую статуэтку.","flavor":"Статуэтка увеличилась в один миг, пульсируя и колеблясь, меняя свою форму и строение, как клубок дыма, стелющийся по полу. Лучи света открыли движение и затвердевающую материю. Мгновение спустя в центре магического круга вдруг появилась человеческая фигура.","glossary":"","power":0,"typeMask":2};
            values[200055]={"templateId":200055,"description":"Истощите отряд на половину силы.","flavor":"Никто, даже высшие вампиры, не знает точного возраста Скрытого. Им известно лишь одно: против его воли нельзя идти никогда, ни при каких обстоятельствах.","glossary":"","power":5,"typeMask":4};
            values[200056]={"templateId":200056,"description":"Сотворите любое бронзовое или серебряное заклятие.","flavor":"Ты знаешь, что такое \"антерион\"? Это как ликантроп, только наоборот - бестия, которая может оборачиваться человеком.","glossary":"","power":2,"typeMask":4};
            values[200057]={"templateId":200057,"description":"","flavor":"Я унаследовала от отца способность принимать другие формы. Вернее, в моем случае, одну форму.","glossary":"","power":0,"typeMask":4};
            values[200058]={"templateId":200058,"description":"Сотворите любой золотой отряд (но не лидера).","flavor":"Я даю тебе три свежих следа... Предлагаю помощь разведки и придворной чародейки... А ты вместо дочери привозишь мне какое-то... чучело?","glossary":"","power":0,"typeMask":2};
            values[200062]={"templateId":200062,"description":"Выбор двух вариантов: усильте слабейший дружественный отряд на 5 ед.; усильте случайный отряд в вашей руке на 5 ед.; нанесите 5 ед. урона сильнейшему вражескому отряду; очаруйте случайного вражеского эльфа с силой 5 ед. или меньше.","flavor":"Смотри у меня! Не будешь слушаться - отдам тебя агуаре!","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nСлабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":5,"typeMask":4};
            values[200067]={"templateId":200067,"description":"Выбор: сыграйте Благо Полная луна или сыграйте Бедствие Кровавая луна.","flavor":"Когда восходит полная луна, из темных закоулков этого мира приходят кошмары.","glossary":"Благо: положительный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.\n\nБедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[200071]={"templateId":200071,"description":"Перемирие: возьмите по карте из обеих колод. Одну оставьте себе, другую отдайте противнику.","flavor":"Дипломат - это человек, который использует гораздо больше слов, чем необходимо, чтобы рассказать гораздо меньше, чем он знает.","glossary":"Перемирие: если оба игрока еще не спасовали.","power":9,"typeMask":4};
            values[200073]={"templateId":200073,"description":"Нанесите 8 ед. урона отряду, не относящемуся к фракции Чудовищ.","flavor":"Со стрыгой все в порядке. Да, ей надо время от времени кого-то кусать, но ты быстро к этому привыкнешь.","glossary":"","power":6,"typeMask":4};
            values[200078]={"templateId":200078,"description":"Усильте ведьмака до 25 ед. или нанесите 10 ед. урона отряду, который не является ведьмаком. Если он выживет, усильте его до 25 ед.","flavor":"Представьте себе кусок глины. Чтобы придать ему форму, надо сперва его вымочить, иначе он рассыпется. Первая часть Испытания именно это и делает... Она как бы открывает тело к переменам. И только потом мутагены превращают человека в ведьмака.","glossary":"","power":0,"typeMask":2};
            values[200079]={"templateId":200079,"description":"Создайте базовую копию золотого отряда из сброса противника (но не лидера) и усильте этот отряд на 2 ед.","flavor":"Это заклинание позволит тебе прожить воспоминания мертвеца... Смотри только, чтобы оно тебя не погубило.","glossary":"","power":0,"typeMask":2};
            values[200080]={"templateId":200080,"description":"Усильте этот отряд на базовую силу последнего сыгранного вами другого краснолюда.","flavor":"Ну и что такое? Сраньем смердит, королевишна?","glossary":"","power":10,"typeMask":4};
            values[200081]={"templateId":200081,"description":"Сыграйте из вашей колоды случайную бронзовую карту органики или карту Бедствия.","flavor":"\"Здесь, на Скеллиге, мы не сжигаем хитрых женщин, а прислушиваемся к их советам\".","glossary":"","power":3,"typeMask":4};
            values[200083]={"templateId":200083,"description":"Переместите карту из вашей колоды в вашу руку, затем сбросьте случайную карту.","flavor":"Мы хотели бы сохранить наши имена для себя. Считай нас... Друзьями семьи.","glossary":"","power":11,"typeMask":4};
            values[200087]={"templateId":200087,"description":"Сотворите любого бронзового или серебряного зверя или драконида.","flavor":"Доррегарай переплюнет своими причудами даже ведьмаков. Не ограничивается делением чудовищ на хороших и плохих. Считает, что все они хорошие.","glossary":"","power":1,"typeMask":4};
            values[200088]={"templateId":200088,"description":"Истощите все усиления у отрядов в вашей колоде.","flavor":"Коронер - человек спокойный и мирный. Он даже к трупам относится с величайшей деликатностью.","glossary":"","power":7,"typeMask":4};
            values[200089]={"templateId":200089,"description":"Переместите все отряды в одном ряду в случайные ряды.","flavor":"Заплутал? Ну, так выплутывайся. За ворота, стало быть. Обороти левое ухо к солнцу и так и держись - попадешь на тракт. Ну, чего ждешь?","glossary":"","power":10,"typeMask":4};
            values[200091]={"templateId":200091,"description":"Перемирие: каждый игрок берет отряд и делает его силу равной 1.","flavor":"Ведьмаку встречались в жизни разбойники с внешностью городских советников, советники, похожие на вымаливающих подаяние старцев, и короли с манерами разбойников. Стрегобор же всегда выглядел так, как по всем канонам и представлениям должен выглядеть чародей.","glossary":"Перемирие: если оба игрока еще не спасовали.","power":10,"typeMask":4};
            values[200098]={"templateId":200098,"description":"Уничтожьте броню у всех отрядов, затем усильте эту карту на половину значения уничтоженной брони.","flavor":"Днем он - капитан городской стражи Вызимы, а ночью - безжалостный мститель и защитник угнетенных.","glossary":"","power":9,"typeMask":4};
            values[200102]={"templateId":200102,"description":"Выбор: сыграйте бронзовый или серебряный проклятый отряд из вашей колоды или сотворите серебряный отряд из стартовой колоды противника.","flavor":"Боги обращаются ко мне. Я слышу их шепот из тени....","glossary":"","power":3,"typeMask":4};
            values[200103]={"templateId":200103,"description":"Нанесите 10 ед. урона этой карте. Уменьшите наносимый урон на 2 ед. за каждого зверя, сыгранного вами в этом матче.","flavor":"Десятикратный обладатель почетного титула чемпиона Ан Скеллиге.","glossary":"Урон: уменьшает текущую силу отряда.","power":20,"typeMask":4};
            values[200104]={"templateId":200104,"description":"Нанесите по 1 ед. урона всем вражеским отрядам. Если они уже повреждены, нанесите по 2 ед. урона.","flavor":"Волколак? Ой нет, нет... Это что-то гораздо, гораздо хуже.","glossary":"","power":6,"typeMask":4};
        }
        private static function page14():void {
            values[200105]={"templateId":200105,"description":"Нанесите 1 ед. урона одному и тому же отряду несколько раз (всего 4).","flavor":"У клана Димун легкие и быстрые боевые корабли. Они идеально подходят для атаки на медленные торговые фрегаты.","glossary":"","power":7,"typeMask":4};
            values[200112]={"templateId":200112,"description":"Сыграйте Лунный свет из вашей колоды.","flavor":"Если верить сплетням, их пение сбило с пути не одного морехода. Хотя, скорее всего, моряков соблазняли другие их прелести.","glossary":"","power":4,"typeMask":4};
            values[200114]={"templateId":200114,"description":"Создайте Волка с каждой стороны от этого отряда при контакте с Полной луной.","flavor":"Говорят, ликантропия заразна, достаточно одного укуса, чтобы стать оборотнем. Ведьмаки знают, что это неправда. Оборотнем от одного укуса можно стать лишь в результате сильного проклятия.","glossary":"","power":10,"typeMask":4};
            values[200115]={"templateId":200115,"description":"Шпион.\nНанесите 10 ед. урона отряду слева.","flavor":"Самая популярная профессия при императорском дворе, после писаря и куртизанки.","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[200118]={"templateId":200118,"description":"Измените статус шпиона у отряда.","flavor":"Ты можешь попытаться сбежать, но тебе не скрыться.","glossary":"","power":10,"typeMask":4};
            values[200124]={"templateId":200124,"description":"Нанесите по 1 ед. урона за каждую карту алхимии в вашей стартовой колоде.","flavor":"Школа Змеи будет восстановлена... Лето позаботился об этом.","glossary":"","power":5,"typeMask":4};
            values[200132]={"templateId":200132,"description":"Восстановите отряд. Если это чародей, сыграйте копию этого отряда из вашей колоды.","flavor":"Кто такие охотники за колдуньями? В большинстве своем - мерзавцы и фанатики, однако после совершенных Ложей чародеек злодеяний в ряды охотников вступило много порядочных людей…","glossary":"","power":3,"typeMask":4};
            values[200135]={"templateId":200135,"description":"Нанесите 3 ед. урона случайному вражескому отряду в каждом ряду.","flavor":"Это махакамское ремесло - дело рискованное, и потому крайне уважаемое. Наибольшего признания в нем достиг краснолюд по имени Микель Бэй.","glossary":"","power":5,"typeMask":4};
            values[200136]={"templateId":200136,"description":"В конце хода усиливайте эту карту на 2 ед., если во время вашего хода был усилен другой дружественный отряд или отряд в вашей руке.","flavor":"Ее слова порой неясны, но всегда несут тайный смысл и великую мудрость.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":8,"typeMask":4};
            values[200138]={"templateId":200138,"description":"Воскресите бронзовую карту алхимии или заклятия и удалите ее.","flavor":"Знание, дорогой мой, это привилегия, а привилегиями делятся только с равными себе.","glossary":"","power":2,"typeMask":4};
            values[200139]={"templateId":200139,"description":"Нанесите 7 ед. урона вражескому отряду в ряду, в котором меньше 4 отрядов.","flavor":"Один ученый из Оксенфурта утверждал, что пантера - это не особый вид зверя, а просто леопард. Пантере было все равно, так что она сожрала его прежде, чем тот успел закончить свои исследования.","glossary":"","power":4,"typeMask":4};
            values[200144]={"templateId":200144,"description":"Создайте Медведя.","flavor":"Не трогай его. Не смотри ему в глаза. А по правде сказать... лучше вообще не подходи.","glossary":"","power":1,"typeMask":4};
            values[200145]={"templateId":200145,"description":"Воскресите бронзовую машину.","flavor":"Это море наше, и все, что здесь ходит или плавает, - тоже!","glossary":"","power":3,"typeMask":4};
            values[200146]={"templateId":200146,"description":"Верните бронзовый отряд из вашего сброса в вашу колоду.","flavor":"Спикероог - глухая дыра, но это ничего. Все, что нам нужно, мы возьмем у вас.","glossary":"","power":10,"typeMask":4};
            values[200147]={"templateId":200147,"description":"Очистите ряд от Бедствий и переместите в этот ряд дружественные отряды (всего 2).","flavor":"Фламиника - предводительница круга друидов, которая обладает огромной властью и пользуется огромным уважением.","glossary":"","power":10,"typeMask":4};
            values[200149]={"templateId":200149,"description":"Сыграйте бронзовый предмет из вашей колоды.","flavor":"Он боится только гнева Фрейи и своей жены!","glossary":"","power":2,"typeMask":4};
            values[200154]={"templateId":200154,"description":"Сыграйте золотой отряд из вашей колоды и усильте его на 2 ед.","flavor":"Мы, Фольтест, богопомазанный король Темерии, князь Соддена, сеньор-протектор Бругге и т.д., и т.д., нижеследующим повелеваем...","glossary":"","power":0,"typeMask":2};
            values[200158]={"templateId":200158,"description":"Создайте Густой туман или Проливной дождь.","flavor":"Не умер тот, кто почиет веками. И смерть сама умрет, покуда он лежит с закрытыми глазами.","glossary":"","power":8,"typeMask":4};
            values[200159]={"templateId":200159,"description":"Сбросьте до 3 карт из вашей колоды и укрепите их на 1 ед.","flavor":"Никто не заменит Брана. Они могут только пытаться.","glossary":"","power":2,"typeMask":4};
            values[200160]={"templateId":200160,"description":"Укрепите сильнейший не шпионский бронзовый или серебряный отряд в вашей колоде на 2 ед. и сыграйте его.","flavor":"Нильфгаардцы называют его Tirth ys Muire, Морской Вепрь. Детей им пугают!","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":5,"typeMask":4};
            values[200161]={"templateId":200161,"description":"Нанесите 1 ед. урона случайному вражескому отряду в противоположном ряду. Повторите несколько раз (всего 9).","flavor":"Никто не знал, откуда взялось его прозвище. И никто не смел спросить.","glossary":"","power":6,"typeMask":4};
            values[200162]={"templateId":200162,"description":"Сыграйте карту, затем верните бронзовый или серебряный дружественный отряд в вашу руку.","flavor":"Император не славится терпением. Он хочет видеть свою дочь. Как можно скорее.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":7,"typeMask":4};
            values[200163]={"templateId":200163,"description":"Вскройте до 4 карт.","flavor":"\"А ты кто такой? Еще один болван?\" \"Нет. Морвран Воорхис. Командующий Дивизии Альба\".","glossary":"","power":7,"typeMask":4};
            values[200164]={"templateId":200164,"description":"Посмотрите верхние карты в вашей колоде (всего 3) и сыграйте 1 из них.","flavor":"Сила - это лишь одно из качеств, доступных владыке.","glossary":"","power":5,"typeMask":4};
            values[200165]={"templateId":200165,"description":"Поменяйте карту на любую карту по вашему выбору и усильте ее на 3 ед.","flavor":"Все имеет свою цену. Война требует жертв. Мир, как оказалось, тоже.","glossary":"","power":7,"typeMask":4};
        }
        private static function page15():void {
            values[200166]={"templateId":200166,"description":"Воскресите бронзовую или серебряную особую карту.","flavor":"Привет тебе, сереброокая Эитнэ, владычица Брокилона!","glossary":"","power":5,"typeMask":4};
            values[200167]={"templateId":200167,"description":"Сыграйте не шпионский серебряный отряд или бронзового краснолюда из вашей колоды.","flavor":"Старый пень! На вид и не поймешь, живой или набитый!","glossary":"","power":4,"typeMask":4};
            values[200168]={"templateId":200168,"description":"Усильте все другие дружественные отряды и не шпионские отряды в руке и колоде на 1 ед.\nПодкрепление.","flavor":"Проклятая политика... Я доверяю только своим солдатам.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":5,"typeMask":4};
            values[200169]={"templateId":200169,"description":"Измените статус блокировки у отрядов (всего 2). Если это вражеские отряды, нанесите им по 4 ед. урона. Подкрепление.","flavor":"Король должен быть суровым для врагов и щедрым для друзей.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":6,"typeMask":4};
            values[200170]={"templateId":200170,"description":"Выберите бронзовый дружественный отряд Каэдвена или машину и сыграйте все его копии из вашей колоды.\nПодкрепление.","flavor":"Моими отпрысками можно было бы засадить троны всех королевств Севера.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.\n\nДружественный: любой отряд на вашей стороне поля.","power":3,"typeMask":4};
            values[200171]={"templateId":200171,"description":"4 ед. брони.","flavor":"Солдаты, верные старому барону Тридама, покинули город вместе с Фалибором, тем самым пойдя против закона.","glossary":"","power":10,"typeMask":4};
            values[200174]={"templateId":200174,"description":"Призовите всех Трутней главоглаза.","flavor":"В мире животных молодой - необязательно красивый.","glossary":"","power":3,"typeMask":4};
            values[200175]={"templateId":200175,"description":"Значение силы больше 6 ед.","flavor":"Он даст тебе успех и достаток. Щедро одарит и сребром, и златом.","glossary":"","power":6,"typeMask":4};
            values[200176]={"templateId":200176,"description":"Значение силы меньше 6 ед.","flavor":"Он даст тебе успех и достаток. Щедро одарит и сребром, и златом.","glossary":"","power":6,"typeMask":4};
            values[200177]={"templateId":200177,"description":"Воскресите эту карту в случайном ряду, когда сумеете воскресить 4 отряда во время нахождения этой карты в сбросе.","flavor":"Иди сюда, щас я тебе покажу \"перепелочку\"...","glossary":"Воскресить: сыграть из вашего сброса.","power":6,"typeMask":4};
            values[200178]={"templateId":200178,"description":"Нет способности.","flavor":"Бес выглядит почти как олень. Огромный бешеный олень.","glossary":"","power":11,"typeMask":4};
            values[200179]={"templateId":200179,"description":"Повторно сыграйте бронзовый или серебряный дружественный отряд и усильте его на {Boost} ед.","flavor":"Сюрприз!","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[200181]={"templateId":200181,"description":"Создайте Левую пехтуру и Правую пехтуру слева и справа от этого отряда соответственно.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":6,"typeMask":4};
            values[200183]={"templateId":200183,"description":"Нет способности.","flavor":"Если надо выбирать между одним злом и другим, я предпочитаю не выбирать.","glossary":"","power":15,"typeMask":4};
            values[200184]={"templateId":200184,"description":"Размещение или взаимосвязь: усильте отряд слева на 2 ед.","flavor":"Для Темерии я готов на все. Но обычно я для нее только убиваю.","glossary":"Взаимосвязь: активируется каждый раз, когда на той же стороне поля играют копию этого отряда.\n\nРазмещение: активируется, когда карта появляется на поле.","power":5,"typeMask":4};
            values[200188]={"templateId":200188,"description":"Усильте смежные отряды (всего {Counter}) на {Boost} ед.","flavor":"Плюс один к морали, минус один к слуху.","glossary":"","power":0,"typeMask":2};
            values[200189]={"templateId":200189,"description":"Выбор: усильте все поврежденные дружественные отряды под действием Бедствий на {Boost} ед. и очистите вашу сторону от всех Бедствий или сыграйте случайный бронзовый отряд из вашей колоды.","flavor":"Хороший день, чтобы умереть.","glossary":"","power":0,"typeMask":2};
            values[200191]={"templateId":200191,"description":"Нанесите 3 ед. урона.","flavor":"Это было нечто, что жило только затем, чтобы убивать.","glossary":"","power":8,"typeMask":4};
            values[200192]={"templateId":200192,"description":"Призовите все копии этого отряда.","flavor":"Полукраб, полупаук. Словом, та еще гадина.","glossary":"","power":3,"typeMask":4};
            values[200193]={"templateId":200193,"description":"Нет способности.","flavor":"Есть множество потаенных страхов. Страх перед туманом обоснован...","glossary":"","power":9,"typeMask":4};
            values[200194]={"templateId":200194,"description":"Уничтожьте все сильнейшие отряды на поле.","flavor":"Геральт отступил на шаг. Он уже видел людей, которых поразила \"Казнь\". А скорее то, что от них осталось.","glossary":"","power":0,"typeMask":2};
            values[200198]={"templateId":200198,"description":"Нанесите 3 ед. урона вражескому отряду. Если он уничтожен или на него действует Мороз, усильте эту карту на 2 ед.","flavor":"Белый Хлад близко.","glossary":"","power":7,"typeMask":4};
            values[200199]={"templateId":200199,"description":"Нет способности.","flavor":"В движущейся по небу ленте проявляются нечетко кошмарные силуэты всадников. Качаются буйволиные рога и оборванные плюмажи на шлемах. Из-под шлемов белеют оскалы черепов.","glossary":"","power":3,"typeMask":4};
            values[200201]={"templateId":200201,"description":"Создайте бронзовый отряд Дикой Охоты.","flavor":"Держи себя в руках. Ты же знаешь, чем это кончится.","glossary":"","power":5,"typeMask":4};
            values[200206]={"templateId":200206,"description":"Размещение, храбрость: укрепите эту карту на 3 ед.","flavor":"Боец Рогатого сопротивления. Semper fi!","glossary":"Храбрость: активируется, если противник побеждает в текущем раунде (подсчитывается после появления на поле этого отряда и всех отрядов, что он создает).\n\nРазмещение: активируется, когда карта появляется на поле.","power":7,"typeMask":4};
        }
        private static function page16():void {
            values[200207]={"templateId":200207,"description":"Сыграйте Бедствие в ряду противника, которое в начале хода наносит {Damage} ед. урона его слабейшему отряду.","flavor":"У меня пальцы так заледенели, едва меч держу... А ведь мечом еще и махать надо...","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[200209]={"templateId":200209,"description":"Поменяйте до 2 карт на бронзовые.","flavor":"Плевать на королей и на их титулы. На востоке есть та, что действительно достойна короны.","glossary":"","power":11,"typeMask":4};
            values[200212]={"templateId":200212,"description":"Сыграйте случайный бронзовый или серебряный проклятый отряд из вашей колоды.","flavor":"Да будет имя его вычеркнуто из Саги Предков, и пусть никто не даст ему ни убежища, ни еды.","glossary":"","power":5,"typeMask":4};
            values[200218]={"templateId":200218,"description":"Переместите вражеские отряды (всего 3) в ряд, противоположный этому отряду, и нанесите им по 2 ед. урона. Если этот ряд находится под действием Трескучего мороза, нанесите по 3 ед. урона.","flavor":"На Скеллиге верят, что в древние времена островами правил могущественный и ужасный Йотун, король великанов. Хеймдалль сумел победить его, но перед смертью Йотун пообещал вернуться, когда наступит Рагнарек.","glossary":"","power":6,"typeMask":4};
            values[200219]={"templateId":200219,"description":"Нет способности.","flavor":"Логика подсказывает, что смерть освобождает стража от его обязанностей. Однако магия часто пренебрегает логикой.","glossary":"","power":6,"typeMask":4};
            values[200220]={"templateId":200220,"description":"Сыграйте бронзовую или серебряную карту органики из вашей колоды.","flavor":"Хи-хи-хи-хи-хи!","glossary":"","power":6,"typeMask":4};
            values[200221]={"templateId":200221,"description":"Воскресите бронзовые отряды (всего 2) со способностью Завещание.","flavor":"Порубим тебя, юноша. Отличный выйдет супчик...","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":1,"typeMask":4};
            values[200222]={"templateId":200222,"description":"Выбор: укрепите все другие ваши реликты в руке, в колоде или на поле на 2 ед. или сыграйте бронзовый или серебряный реликт из вашей колоды и укрепите его на 2 ед.","flavor":"Я чую твою боль, вижу твой страх.","glossary":"","power":4,"typeMask":4};
            values[200223]={"templateId":200223,"description":"Выбор: исцелите отряд и укрепите его на 6 ед. или восстановите отряд и ослабьте его на 6 ед.","flavor":"Не веря дивному открытью, вы рады отшутиться все, о мандрагорах вздор твердите и глупости о черном псе.","glossary":"","power":0,"typeMask":2};
            values[200224]={"templateId":200224,"description":"Нанесите по 4 ед. урона сильнейшему вражескому отряду в каждом ряду. Дополнительно нанесите по 1 ед. урона за каждую копию этой карты в вашем сбросе.","flavor":"Один известный пират так любил это пьянящее растение, что даже получил в честь него прозвище \"Вороний глаз\". В художественную версию его легенды эти сведения не вошли, к великому ужасу всех поклонников пиратских обычаев.","glossary":"","power":0,"typeMask":2};
            values[200225]={"templateId":200225,"description":"Очаруйте бронзовый или серебряный вражеский отряд с силой 8 ед. или меньше.","flavor":"Не каждого зверя можно приручить, но каждого можно обуздать.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[200226]={"templateId":200226,"description":"После 3 ходов в сбросе нанесите в конце хода 6 ед. урона сильнейшему вражескому отряду и усильте слабейший дружественный отряд на 6 ед.","flavor":"Трава волкобой, также называемая \"королевой ядов\", входит в состав многих ведьмачьих эликсиров и алхимических зелий.","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nСлабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":0,"typeMask":2};
            values[200227]={"templateId":200227,"description":"Скройте любое число отрядов. Если это дружественные отряды, усильте их на 2 ед. Если это враги, нанесите им по 2 ед. урона.","flavor":"Я на должности в Новиграде уже тринадцать лет. Я многое видел. Жестокость, цинизм, алчность. Но даже меня бросает в дрожь от того, что сейчас там творится.","glossary":"","power":9,"typeMask":4};
            values[200228]={"templateId":200228,"description":"Сыграйте Бедствие в ряду противника, которое наносит по 3 ед. урона отрядам при контакте.","flavor":"Одна из любимых ловушек скоя'таэлей - простая, дешевая и при этом действенная.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[200232]={"templateId":200232,"description":"Обратите Махакамский эль противника в Испорченный эль.","flavor":"Разве пиво бывает зеленым…?","glossary":"","power":0,"typeMask":2};
            values[200233]={"templateId":200233,"description":"Восстановите отряд.","flavor":"Обычно нападает сзади, а целится точно меж позвонков, либо под левую почку, в аорту. Как правило, ему достаточно одного удара.","glossary":"","power":6,"typeMask":4};
            values[200234]={"templateId":200234,"description":"Создайте Левую пехтуру и Правую пехтуру слева и справа от этого отряда соответственно.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":6,"typeMask":4};
            values[200235]={"templateId":200235,"description":"Нанесите по 4 ед. урона всем копиям вражеского отряда.","flavor":"Не учи дедушку кашлять!","glossary":"","power":8,"typeMask":4};
            values[200236]={"templateId":200236,"description":"Уничтожьте бронзовый или серебряный вражеский отряд, который не усилен.","flavor":"Я твое сопение слышал за три мили, только лень было из кустов вылезать.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":7,"typeMask":4};
            values[200237]={"templateId":200237,"description":"Сыграйте бронзовую или серебряную карту алхимии из вашей колоды.","flavor":"К чудовищам нельзя относиться легкомысленно. Если Цири хочет стать одной из нас, ей придется это понять.","glossary":"","power":6,"typeMask":4};
            values[200240]={"templateId":200240,"description":"Размещение: создайте Махакамский эль или Испорченный эль.","flavor":"Брувер Гоог чуть не прогнал Габора из Махакама, за то, что тот держал ламу в своем жилище… Долгая история.","glossary":"Размещение: активируется, когда карта появляется на поле.","power":5,"typeMask":4};
            values[200244]={"templateId":200244,"description":"Играйте этот отряд из вашей колоды каждый раз, когда есть 6 и более дружественных Пьяных матросов.\nРазмещение: сыграйте Благо Золотая пена в ряду\nБлаго Золотая пена: в начале каждого хода укрепляйте все отряды в ряду на 1 ед.\nНеуязвимость.","flavor":"Легенда гласит, что Хеймдалль презирал все напитки, кроме эля. Особенно воду, которую он прозвал \"рыбьей мочей\".","glossary":"Благо: положительный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.\n\nРазмещение: активируется, когда карта появляется на поле.\n\nНеуязвимость: нельзя выбрать как цель.","power":5,"typeMask":4};
            values[200283]={"templateId":200283,"description":"","flavor":"А я стоял на первой линии, там, где горячше всего было!","glossary":"","power":0,"typeMask":0};
            values[200293]={"templateId":200293,"description":"Создайте базовую копию случайного другого бронзового краснолюда из вашей колоды.","flavor":"\"Запомните мои слова: если вы не поднимете свои задницы, сюда придут люди и украдут наших баб!\"","glossary":"","power":1,"typeMask":4};
            values[200294]={"templateId":200294,"description":"Усиливайте дружественный отряд на 2 ед. каждый раз, когда играете солдата.","flavor":"\"Защищать этот штандарт даже ценой своей жизни! Слава Великому Солнцу!\"","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":8,"typeMask":4};
        }
        private static function page17():void {
            values[200295]={"templateId":200295,"description":"Завещание: нанесите по 2 ед. урона отрядам в противоположном ряду.","flavor":"Ты почуешь их задолго до того, как увидишь.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":8,"typeMask":4};
            values[200296]={"templateId":200296,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда появляется дружественный отряд.","flavor":"Клин конницы с разгона врезался в квадрат пехотинцев. Словно гигантский кинжал дивизия \"Альба\" крушила все, что защищало доступ к живому телу темерской пехоты.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":7,"typeMask":4};
            values[200299]={"templateId":200299,"description":"Усильте дружественный отряд на 6 ед.","flavor":"Не такой творческий путь он себе представлял, когда мечтал стать музыкантом.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":5,"typeMask":4};
            values[200300]={"templateId":200300,"description":"Переместите вражеский отряд в ряд, противоположный этому отряду, и нанесите ему урон, равный количеству отрядов в этом ряду.","flavor":"Всегда клади глаз на самую большую красотку, что в море, что в порту.","glossary":"Урон: уменьшает текущую силу отряда.\n\nВражеский: любой отряд на стороне поля противника.","power":8,"typeMask":4};
            values[200301]={"templateId":200301,"description":"Усильте все дружественные отряды Дикой Охоты на 1 ед.\nУсиливайте другой дружественный отряд Дикой Охоты на 1 ед. каждый раз, когда он появляется.","flavor":"Волна бьет о берег. Волна, которую разрезает нос Нагльфара. Поет рог Хеймдалля, стоящего лицом к врагу на радужной дуге Бифроста. Подступает Белый Хлад, надвигаются Вьюга и Пурга…","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":7,"typeMask":4};
            values[200302]={"templateId":200302,"description":"Нет способности.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":2,"typeMask":4};
            values[200303]={"templateId":200303,"description":"Нет способности.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":2,"typeMask":4};
            values[200307]={"templateId":200307,"description":"Нет способности.","flavor":"Статуэтка увеличилась в один миг, пульсируя и колеблясь, меняя свою форму и строение, как клубок дыма, стелющийся по полу. Лучи света открыли движение и затвердевающую материю. Мгновение спустя в центре магического круга вдруг появилась человеческая фигура.","glossary":"","power":2,"typeMask":4};
            values[200308]={"templateId":200308,"description":"Нет способности.","flavor":"В мире животных молодая - необязательно красивая.","glossary":"","power":1,"typeMask":4};
            values[200309]={"templateId":200309,"description":"","flavor":"","glossary":"","power":1,"typeMask":4};
            values[200320]={"templateId":200320,"description":"Нет способности.","flavor":"Боец Рогатого сопротивления. Semper fi!","glossary":"","power":14,"typeMask":4};
            values[200448]={"templateId":200448,"description":"Обреченность.\nВ начале каждого хода укрепляйте смежные отряды на 1 ед.\nРазмещение: создайте Пьяного краснолюда в случайном ряду.\nНельзя укрепить.","flavor":"Считается величайшим вкладом краснолюдов в мировую культуру.","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.\n\nРазмещение: активируется, когда карта появляется на поле.\n\nУкрепить: увеличить изначальную силу отряда.","power":3,"typeMask":4};
            values[200449]={"templateId":200449,"description":"Обреченность.\nВ начале каждого хода укрепляйте смежные отряды на 1 ед.\nРазмещение: создайте Пьяного матроса в случайном ряду.\nНельзя укрепить.","flavor":"Считается величайшим вкладом краснолюдов в мировую культуру.","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.\n\nРазмещение: активируется, когда карта появляется на поле.\n\nУкрепить: увеличить изначальную силу отряда.","power":3,"typeMask":4};
            values[200457]={"templateId":200457,"description":"Нет способности.","flavor":"Драугиры - демоны войны. Они возникают на местах особенно кровавых сражений. Это концентрированная жажда убийства и ненависти.","glossary":"","power":1,"typeMask":4};
            values[200481]={"templateId":200481,"description":"Размещение: нанесите 3 ед. урона вражескому отряду.\nРазмещение: добавьте 1 ед. брони.\nТрио: укрепите Трололо на 5 ед. и уберите или добавьте ему стойкость.","flavor":"Все тролль хотеть тухлую воду!!!","glossary":"Размещение: активируется, когда карта появляется на поле.\n\nСтойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.\n\nТрио: строго 3 незаблокированные копии отряда в ряду.","power":1,"typeMask":4};
            values[200482]={"templateId":200482,"description":"Размещение: добавьте 2 ед. брони и поглотите слабейший вражеский отряд, но не усиливайте, а укрепите этот отряд.","flavor":"Обожает эльфов и луковый суп.","glossary":"Размещение: активируется, когда карта появляется на поле.\n\nВражеский: любой отряд на стороне поля противника.\n\nСлабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":3,"typeMask":4};
            values[200502]={"templateId":200502,"description":"Вызовите вражеский отряд на дуэль. Если на него действует Трескучий мороз, нанесите двойной урон.","flavor":"Существует множество видов троллей. Однако до сих пор не удалось найти ни одного, который не был бы туп, как ведро гвоздей.","glossary":"Урон: уменьшает текущую силу отряда.\n\nДуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.\n\nВражеский: любой отряд на стороне поля противника.","power":4,"typeMask":4};
            values[200503]={"templateId":200503,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда появляется дружественный крестьянин.\nРазмещение: добавьте 2 ед. брони. Усильте эту карту на 1 ед. за каждого другого дружественного крестьянина.","flavor":"Мы ополчение. Не видишь, порядок охраняем.","glossary":"Размещение: активируется, когда карта появляется на поле.\n\nДружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":0};
            values[200504]={"templateId":200504,"description":"Размещение: усильте смежные отряды на 2 ед.","flavor":"Люди добрые! Если мы не пойдем, то кто пойдет?!","glossary":"Размещение: активируется, когда карта появляется на поле.","power":0,"typeMask":0};
            values[200505]={"templateId":200505,"description":"Размещение: усильте всех крестьян в вашей руке на 1 ед.","flavor":"Мы никогда не бросим землю наших отцов!","glossary":"Размещение: активируется, когда карта появляется на поле.","power":0,"typeMask":0};
            values[200506]={"templateId":200506,"description":"Нет способности.","flavor":"Раз-два - и все дела.","glossary":"","power":0,"typeMask":0};
            values[200507]={"templateId":200507,"description":"Создайте один из вариантов этой карты.","flavor":"Йонтек, у нас вампир, возможно высший. По коням!","glossary":"","power":0,"typeMask":0};
            values[200508]={"templateId":200508,"description":"Размещение: снимите Бедствия в ряду на вашей стороне и усильте 1 случайный отряд в вашей руке на 2 ед.","flavor":"Зададим им жару! С чесноком и укропом!","glossary":"Размещение: активируется, когда карта появляется на поле.","power":0,"typeMask":0};
            values[200509]={"templateId":200509,"description":"Наносите 1 ед. урона случайному бронзовому или серебряному вражескому отряду каждый раз, когда появляется другой дружественный крестьянин.\nРазмещение: за каждого другого дружественного крестьянина нанесите 1 ед. урона случайному бронзовому или серебряному вражескому отряду.","flavor":"Может попасть в стог сена. Посмотрим, попадет ли он в движущуюся цель.","glossary":"Размещение: активируется, когда карта появляется на поле.\n\nДружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":0};
            values[200510]={"templateId":200510,"description":"","flavor":"Мы никогда не бросим землю наших отцов!","glossary":"","power":0,"typeMask":0};
        }
        private static function page18():void {
            values[200511]={"templateId":200511,"description":"Создайте один из вариантов этой карты.","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200512]={"templateId":200512,"description":"Сыграйте трех Косарей из вашей колоды.","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200513]={"templateId":200513,"description":"Усильте всех дружественных крестьян на 1 ед.","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200514]={"templateId":200514,"description":"","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200515]={"templateId":200515,"description":"","flavor":"Герой, который нужен Туссенту, но которого Туссент не заслуживает.","glossary":"","power":0,"typeMask":0};
            values[200516]={"templateId":200516,"description":"","flavor":"Герой, который нужен Туссенту, но которого Туссент не заслуживает.","glossary":"","power":0,"typeMask":0};
            values[200517]={"templateId":200517,"description":"Размещение: создайте 3 Косарей в низу вашей колоды.\nЗавещание: усильте всех Косарей в вашей колоде на 1 ед.","flavor":"В Боклере все лучше, чем где-либо еще: вино слаще, коровы больше, а девушки красивее.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nРазмещение: активируется, когда карта появляется на поле.","power":0,"typeMask":0};
            values[200518]={"templateId":200518,"description":"Поменяйте силу этого отряда на силу вскрытого отряда и наоборот.","flavor":"Эббинг славен своими наемниками и легкой кавалерией.","glossary":"","power":1,"typeMask":4};
            values[200519]={"templateId":200519,"description":"Усильте случайный дружественный отряд в каждом ряду на 4 ед.","flavor":"Считается величайшим вкладом краснолюдов в мировую культуру.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[200520]={"templateId":200520,"description":"Воскресите более слабый или равный по силе бронзовый или серебряный отряд Скоя'таэлей.","flavor":"Единственное, что может сравниться с его мечами - его же вареники.","glossary":"","power":3,"typeMask":4};
            values[200523]={"templateId":200523,"description":"Создайте Коров (всего 2) с каждой стороны от этого отряда.","flavor":"Герой, который нужен Туссенту, но которого Туссент не заслуживает.","glossary":"","power":10,"typeMask":4};
            values[200528]={"templateId":200528,"description":"Нанесите 1 ед. урона бронзовой дружественной машине или солдату, затем сыграйте его копию из вашей колоды.","flavor":"\"Женщины на острове Скеллиге - дикие и непредсказуемые. Всем подразделениям необходимо рассматривать их как серьезную угрозу, способности этих женщин ни в коем случае не следует недооценивать\", - общая директива для сил вторжения имперского флота.","glossary":"","power":2,"typeMask":4};
            values[200529]={"templateId":200529,"description":"Воскресите в случайном ряду с силой 1 ед. в конце хода.\nПодкрепление.","flavor":"Таков мой обет: странствовать по деревням славной земли веленской, воспевая хвалу деве Ягодке, дабы восславить несравненную ее красу и невиданное очарование.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":11,"typeMask":4};
            values[200530]={"templateId":200530,"description":"Нанесите по 6 ед. урона сильнейшему вражескому отряду в каждом ряду.","flavor":"Разве пиво бывает зеленым…?","glossary":"","power":0,"typeMask":2};
            values[200532]={"templateId":200532,"description":"Сыграйте в ряду Золотую пену.","flavor":"Борос, легендарный основатель Клана Фуксов, умер, приняв на грудь слишком много этого напитка. Он потянулся за своим золотым кольцом, упавшим в ручей, и потерял сознание.","glossary":"","power":10,"typeMask":4};
            values[200534]={"templateId":200534,"description":"Сыграйте бронзовый отряд со способностью \"Завещание\" из вашей колоды. Поглотите его и усильте эту карту на изначальную силу поглощенного отряда.","flavor":"Обожает эльфов и луковый суп.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":1,"typeMask":4};
            values[200535]={"templateId":200535,"description":"Нанесите вражескому отряду урон, равный силе этой карты.","flavor":"Бой похож на танец, однако соперник ни в коем случае не должен управлять твоими движениями.","glossary":"Урон: уменьшает текущую силу отряда.","power":5,"typeMask":4};
            values[200536]={"templateId":200536,"description":"","flavor":"Я - Королева Ночи. Я воплощаю в реальность мечты своих клиентов... за небольшой перекус.","glossary":"","power":0,"typeMask":0};
            values[200537]={"templateId":200537,"description":"","flavor":"Я - Королева Ночи. Я воплощаю в реальность мечты своих клиентов... за небольшой перекус.","glossary":"","power":0,"typeMask":0};
            values[200538]={"templateId":200538,"description":"Переместите случайный бронзовый или серебряный вражеский отряд в ваш рукопашный ряд.","flavor":"Несмотря на все поиски и старания, так его больше никто и не видел.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":0};
            values[200539]={"templateId":200539,"description":"Поглотите другой бронзовый отряд из вашего сброса, затем сыграйте его копию из вашей колоды.","flavor":"Ни один человек, сколь сильным или искусным он ни был, не может отразить удар хвоста ослизга, жала скорпиона или когтей грифона.","glossary":"","power":2,"typeMask":4};
            values[200540]={"templateId":200540,"description":"Нанесите 4 ед. урона вражескому отряду.","flavor":"Этот парень способен вызвать настоящую головную боль.","glossary":"","power":7,"typeMask":4};
