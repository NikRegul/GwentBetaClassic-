            values[200584]={"templateId":200584,"description":"Обреченность, упрямство.\nРазмещение: усильте всех дружественных Воронов, Маленьких воронов и Совсем маленьких воронов на 1 ед.","flavor":"Вопреки повсеместным суевериям, кровь для жизни вампирам не нужна. Однако им нравится ее пьянящий эффект, что делает кровь своего рода наркотиком для вампиров.","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.\n\nРазмещение: активируется, когда карта появляется на поле.\n\nУпрямство: нельзя вернуть в руку.","power":0,"typeMask":0};
            values[200585]={"templateId":200585,"description":"Обреченность, упрямство.\nРазмещение: усильте всех дружественных Воронов, Маленьких воронов и Совсем маленьких воронов на 1 ед.","flavor":"Вопреки повсеместным суевериям, кровь для жизни вампирам не нужна. Однако им нравится ее пьянящий эффект, что делает кровь своего рода наркотиком для вампиров.","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.\n\nРазмещение: активируется, когда карта появляется на поле.\n\nУпрямство: нельзя вернуть в руку.","power":0,"typeMask":0};
            values[200586]={"templateId":200586,"description":"Завещание: создайте 2 Крохотных воронов.","flavor":"Вороны исключительно умные создания, они чрезвычайно наблюдательны.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":0,"typeMask":0};
            values[200587]={"templateId":200587,"description":"Нет способности.","flavor":"Вороны исключительно умные создания, они чрезвычайно наблюдательны.","glossary":"","power":0,"typeMask":0};
            values[200589]={"templateId":200589,"description":"Создайте 5 Крыс в колоде противника.","flavor":"Они бегут со стен! Отовсюду!","glossary":"","power":0,"typeMask":0};
            values[200590]={"templateId":200590,"description":"Создайте один из вариантов этой карты.","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200591]={"templateId":200591,"description":"Сыграйте 3 слабейших отряда из вашей колоды.","flavor":"Что посеешь, то и пожнешь.","glossary":"","power":0,"typeMask":0};
            values[200592]={"templateId":200592,"description":"Усильте сильнейший отряд из вашей колоды на 10 ед. и сыграйте его.","flavor":"Что посеешь, то и пожнешь.","glossary":"Сильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":0,"typeMask":0};
            values[200593]={"templateId":200593,"description":"Создайте бронзовый отряд крестьян и дайте ему щит.","flavor":"Что посеешь, то и пожнешь.","glossary":"Щит: этот символ защищает отряд от следующего эффекта, наносящего урон, ослабляющего или уменьшающего его силу.","power":0,"typeMask":0};
            values[200594]={"templateId":200594,"description":"","flavor":"Экимма - это как бы нетопырь... Только размером с человека.","glossary":"","power":0,"typeMask":0};
            values[200595]={"templateId":200595,"description":"Возглавьте атаку и убейте Бруксу.","flavor":"Перед казнью попроси воды. Кто знает, что случится, пока ее принесут.","glossary":"","power":0,"typeMask":0};
            values[200596]={"templateId":200596,"description":"","flavor":"Боги! Сколько же их здесь!","glossary":"","power":0,"typeMask":0};
            values[200598]={"templateId":200598,"description":"","flavor":"Герой, который нужен Туссенту, но которого Туссент не заслуживает.","glossary":"","power":0,"typeMask":0};
            values[200599]={"templateId":200599,"description":"Обреченность.\nНеубираемая стойкость. Нельзя переместить.\nЗавещание: откройте ворота и путь к победе...","flavor":"Никто не пройдет!","glossary":"Обреченность: отряды удаляются из игры, когда уходят с поля в сброс.\nОсобые карты удаляются из игры после активации способности карты.\n\nЗавещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nСтойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.","power":0,"typeMask":0};
            values[200600]={"templateId":200600,"description":"Когда сила этого отряда достигнет 10 ед., вы получите неожиданную помощь.\nВы проиграете испытание, если этот отряд будет уничтожен.","flavor":"Долго она не выдержит... Но ничего лучше у нас нет.","glossary":"","power":0,"typeMask":0};
            values[200601]={"templateId":200601,"description":"","flavor":"","glossary":"","power":0,"typeMask":0};
        }
        private static function page21():void {
            values[201523]={"templateId":201523,"description":"Восстановите все отряды в ряду и уберите их статусы.","flavor":"Он лег навзничь рядом с мумифицированными останками Адды, на плите изнутри начертил знак Ирден.","glossary":"","power":6,"typeMask":4};
            values[201559]={"templateId":201559,"description":"Призовите все копии этого отряда.","flavor":"Ху-у! Ху-у! Строй держи! Печатай шаг! Мы прикроем ваш бардак! Нам не греться на печи! В бой! Вперед, бородачи!","glossary":"","power":3,"typeMask":4};
            values[201562]={"templateId":201562,"description":"Исцелите отряд и укрепите его на 6 ед.","flavor":"Не веря дивному открытью, вы рады отшутиться все, о мандрагорах вздор твердите и глупости о черном псе.","glossary":"","power":0,"typeMask":2};
            values[201563]={"templateId":201563,"description":"Восстановите отряд и ослабьте его на 6 ед.","flavor":"Не веря дивному открытью, вы рады отшутиться все, о мандрагорах вздор твердите и глупости о черном псе.","glossary":"","power":0,"typeMask":2};
            values[201572]={"templateId":201572,"description":"Шпион.\nЗавещание: если это ход противоположного игрока, создайте Медведя в случайном ряду на стороне противника.","flavor":"Высокий - Вильмар. Рядом с ним, справа, - Вильфред. Заика - это Вильхельм.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nШпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[201573]={"templateId":201573,"description":"Завещание: укрепите случайный дружественный отряд на 3 ед.","flavor":"Высокий - Вильмар. Рядом с ним, справа, - Вильфред. Заика - это Вильхельм.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.\n\nДружественный: любой отряд на вашей стороне поля.","power":1,"typeMask":4};
            values[201574]={"templateId":201574,"description":"Завещание: нанесите по 1 ед. урона всем вражеским отрядам в противоположном ряду.","flavor":"Высокий - Вильмар. Рядом с ним, справа, - Вильфред. Заика - это Вильхельм.","glossary":"Завещание: активируется, когда карта уходит с поля в сброс. Учтите, что удаленные или ослабленные до нуля отряды в сброс не отправляются.","power":1,"typeMask":4};
            values[201576]={"templateId":201576,"description":"Нет способности.","flavor":"В Боклере все лучше, чем где-либо еще: вино слаще, коровы больше, а девушки красивее.","glossary":"","power":1,"typeMask":4};
            values[201578]={"templateId":201578,"description":"Нанесите 4 ед. урона. Если эту карту воскресили, нанесите 6 ед. урона.","flavor":"Ты в своем уме? Хочешь плыть на Скеллиге? Их воины разорвут тебя на куски!","glossary":"","power":7,"typeMask":4};
            values[201579]={"templateId":201579,"description":"Воскресите бронзового или серебряного драконида.","flavor":"Вопрос, что было первым, курица или яйцо, приобретает новый смысл в случае с фениксами.","glossary":"","power":5,"typeMask":4};
            values[201580]={"templateId":201580,"description":"Шпион.\nСотворите любого лидера и усильте его на 2 ед.","flavor":"Почему вообще право рождения определяет, кто правит нами?","glossary":"Шпион: статус отряда, сыгранного на противоположной стороне поля.","power":1,"typeMask":4};
            values[201581]={"templateId":201581,"description":"Сотворите бронзовую или серебряную карту Скеллиге.","flavor":"Офирские мастера умеют складывать из слов руны, наделенные большой силой.","glossary":"","power":0,"typeMask":2};
            values[201582]={"templateId":201582,"description":"Сотворите бронзовую или серебряную карту Королевств Севера.","flavor":"От этой руны веет неестественным холодом. Может, кто-то когда-то ранил ее чувства?","glossary":"","power":0,"typeMask":2};
            values[201583]={"templateId":201583,"description":"Сотворите бронзовую или серебряную карту Нильфгаарда.","flavor":"Осторожно, эта руна все еще горячая.","glossary":"","power":0,"typeMask":2};
            values[201584]={"templateId":201584,"description":"Сотворите бронзовую или серебряную карту Чудовищ.","flavor":"Мое острие ранит... все острее!","glossary":"","power":0,"typeMask":2};
            values[201585]={"templateId":201585,"description":"Сотворите бронзовую или серебряную карту Скоя'таэлей.","flavor":"Меня тошнит от одного ее вида.","glossary":"","power":0,"typeMask":2};
            values[201587]={"templateId":201587,"description":"Сотворите бронзовую или серебряную карту органики.","flavor":"Она снова восстанет. В другом месте, за пределами наших чар. Вновь польется кровь.","glossary":"","power":6,"typeMask":4};
            values[201589]={"templateId":201589,"description":"Сотворите серебряную особую карту.","flavor":"Теперь, изгнанный и оттесненный на край света, я просто Филавандрель с Края Света.","glossary":"","power":4,"typeMask":4};
            values[201595]={"templateId":201595,"description":"Сотворите бронзовый или серебряный проклятый отряд.","flavor":"Проклятие сняли... Но привычка есть сырое мясо у нее осталась.","glossary":"","power":6,"typeMask":4};
            values[201597]={"templateId":201597,"description":"Создайте бронзового солдата клана Тиршах.","flavor":"Эйст прибыл в Цинтру, чтобы помочь Краху ан Крайту завоевать руку принцессы Паветты, а вместо этого покорил сердце ее матери.","glossary":"","power":5,"typeMask":4};
            values[201598]={"templateId":201598,"description":"Выбор: воскресите бронзового зверя или сектанта или же исцелите дружественный отряд и укрепите его на 3 ед.","flavor":"Простые предметы иногда таят большую силу.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201599]={"templateId":201599,"description":"Нанесите 5 ед. урона вражескому отряду, затем нанесите по 1 ед. урона всем вражеским отрядам под действием Кровавой луны.","flavor":"Он терпеть не может, когда ему чешут брюшко.","glossary":"","power":5,"typeMask":4};
            values[201600]={"templateId":201600,"description":"Неуязвимость.\nУсильте этот отряд на 7 ед. при первом контакте с Полной луной.","flavor":"Говорят, ликантропия заразна, достаточно одного укуса, чтобы стать оборотнем. Ведьмаки знают, что это неправда. Оборотнем от одного укуса можно стать лишь в результате сильного проклятия.","glossary":"Неуязвимость: нельзя выбрать как цель.","power":7,"typeMask":4};
            values[201601]={"templateId":201601,"description":"Создайте последнее сыгранное вами бронзовое или серебряное заклятие.","flavor":"Лучше не вставать на пути у госпожи Йеннифэр. Особенно если она спешит.","glossary":"","power":5,"typeMask":4};
            values[201603]={"templateId":201603,"description":"Выбор: уничтожьте лидера противника на поле и усильте эту карту на 5 ед. или сыграйте бронзовую или серебряную карту тактики из вашей колоды.","flavor":"Почему у этого монаха стеганые рукавицы?","glossary":"","power":5,"typeMask":4};
        }
        private static function page22():void {
            values[201606]={"templateId":201606,"description":"Поглотите дружественные отряды (всего 2) и усильте эту карту за счет их силы.","flavor":"Дабы вилохвоста приманить, к колышку козу вервием привяжи, и среди листвы как можно скорее скройся.","glossary":"","power":8,"typeMask":4};
            values[201609]={"templateId":201609,"description":"Очаруйте бронзовый вражеский отряд с силой 3 ед. или меньше.","flavor":"Штука в том, чтобы сломить их, но при этом не сильно покалечить.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":8,"typeMask":4};
            values[201610]={"templateId":201610,"description":"Создайте обреченную базовую копию этого отряда в других ваших рядах.","flavor":"Свободный человек может выбирать сам. Невольник принимает то, что выбрали за него.","glossary":"","power":3,"typeMask":4};
            values[201611]={"templateId":201611,"description":"Заставьте несколько вражеских отрядов в одном ряду (всего 2) вызвать друг друга на дуэль.","flavor":"Хоть у Иорвета и один глаз, но его зрение не имеет себе равных.","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.","power":2,"typeMask":4};
            values[201612]={"templateId":201612,"description":"Сделайте силу дружественного отряда равной 1 ед. и нанесите вражескому отряду урон, равный значению потерянной силы.","flavor":"Единственная его цель - убедиться в том, что его приказы исполняются в точности.","glossary":"Урон: уменьшает текущую силу отряда.","power":10,"typeMask":4};
            values[201613]={"templateId":201613,"description":"Удалите все карты из вашей руки и возьмите столько же новых.","flavor":"Я унаследовала от отца способность принимать другие формы. Вернее, в моем случае, одну форму.","glossary":"","power":11,"typeMask":4};
            values[201615]={"templateId":201615,"description":"Выбор: сыграйте бронзовую или серебряную особую карту из вашей колоды или сотворите серебряного эльфа.","flavor":"Впереди перевал Эльскердег, а за перевалом - Зеррикания и Хакланд. Перед нами дальний и опасный путь. Если мы пойдем вместе... Отбросим недоверие.","glossary":"","power":2,"typeMask":4};
            values[201616]={"templateId":201616,"description":"Скройте 2 карты.","flavor":"Великое Солнце, храни нас от наглых вшей, что норовят залезть в наши кафтаны.","glossary":"","power":11,"typeMask":4};
            values[201617]={"templateId":201617,"description":"Сыграйте случайного другого бронзового солдата из вашей колоды.","flavor":"Кто-то же должен чистить картошку, чтоб остальные могли сражаться.","glossary":"","power":1,"typeMask":4};
            values[201618]={"templateId":201618,"description":"Вызовите вражеский отряд на дуэль.\n3 ед. брони.","flavor":"Благородство и отвага не уберегли его от участи, постигшей всех, кто погиб в битве за Верхний Аэдирн.","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.\n\nВражеский: любой отряд на стороне поля противника.","power":8,"typeMask":4};
            values[201619]={"templateId":201619,"description":"Воскресите бронзовый отряд силой 5 ед. или меньше.","flavor":"Поможет ли? Я не уверен, но, скорей всего, не повредит.","glossary":"","power":0,"typeMask":2};
            values[201620]={"templateId":201620,"description":"Нанесите по 1 ед. урона всем вражеским отрядам. Если уничтожите отряд, сыграйте Рагнарек в его ряду.","flavor":"Генерал думал, что война за Нижнюю Мархию закончится быстро и без больших потерь, однако остался на ней навсегда.","glossary":"","power":7,"typeMask":4};
            values[201621]={"templateId":201621,"description":"Выбор: сотворите бронзовую или серебряную карту алхимии либо сыграйте бронзовый или серебряный предмет из вашей колоды.","flavor":"Мы живем себе на тихом островке неизвестности посреди черных морей бесконечности, и не надо нам выходить слишком далеко в море.","glossary":"","power":4,"typeMask":4};
            values[201622]={"templateId":201622,"description":"Если эта карта была сыграна из колоды, усильте ее на 5 ед.\n2 ед. брони.","flavor":"Не все в каэдвенской армии поддерживают политику короля, но никто не осмеливается сказать это открыто.","glossary":"","power":8,"typeMask":4};
            values[201623]={"templateId":201623,"description":"Уничтожьте случайный дружественный отряд (исключая этот отряд), затем усильте эту карту на 10 ед.","flavor":"Кто кабанище встречает, вмиг на дерево влезает. Если только он не со Скеллиге, конечно - этот начинает исходить слюной.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":8,"typeMask":4};
            values[201624]={"templateId":201624,"description":"Создайте обреченную базовую копию этого отряда в его ряду, когда сыграете следующую карту заклятия или предмета.\n1 ед. брони.","flavor":"Он приговорен проживать один и тот же день снова и снова, прямо как работники банка Чианфанелли.","glossary":"","power":4,"typeMask":4};
            values[201625]={"templateId":201625,"description":"Обратите проклятый дружественный отряд в базовую копию этого отряда.\n2 ед. брони.","flavor":"Он сражается на вечной войне, причин которой не помнит.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":8,"typeMask":4};
            values[201626]={"templateId":201626,"description":"Если в вашей стартовой колоде есть ровно по 2 копии каждой бронзовой карты, сделайте изначальную силу равной 22 ед.","flavor":"Зираэль обладает великой силой, которую не в состоянии контролировать. Она опасна и для себя, и для других. Пока она не научится владеть собой, она должна оставаться в изоляции.","glossary":"","power":1,"typeMask":4};
            values[201627]={"templateId":201627,"description":"Если в вашей стартовой колоде нет дублей, отправьте Лавка в приключение.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201628]={"templateId":201628,"description":"Посмотрите бронзовые карты заклятия или предмета (всего 2) в вашей колоде и сыграйте 1 из них.","flavor":"Даже чародеям не удалось избежать разрушительного проклятия Сабрины Глевиссиг.","glossary":"","power":2,"typeMask":4};
            values[201630]={"templateId":201630,"description":"Нанесите 7 ед. урона, если в том же ряду есть проклятый отряд.","flavor":"Проклятье Сабрины не пощадило никого. Даже ее сестер по чародейскому ремеслу.","glossary":"","power":4,"typeMask":4};
            values[201631]={"templateId":201631,"description":"Создайте случайный бронзовый отряд вашей фракции.","flavor":"Люди до того ненавидят допплеров, что обычной казни им недостаточно. Схваченного допплера привязывают к жерди, обмазывают толстым слоем глины и поджаривают на костре.","glossary":"","power":0,"typeMask":2};
            values[201632]={"templateId":201632,"description":"Выбор: нанесите по 3 ед. урона всем вражеским отрядам с нечетным значением силы, или нанесите по 3 ед. урона всем вражеским отрядам с четным значением силы, или сыграйте из вашей колоды бронзовый или серебряный отряд.","flavor":"\"Что написано на клинке? Проклятие?\" - \"Нет, оскорбление\".","glossary":"","power":0,"typeMask":2};
            values[201633]={"templateId":201633,"description":"Нанесите 5 ед. урона и создайте Призрака в случайном ряду.","flavor":"Некоторые виды оружия были запрещены в королевствах Севера - столь страшны были раны, нанесенные ими.","glossary":"","power":0,"typeMask":2};
            values[201634]={"templateId":201634,"description":"Нанесите по 2 ед. урона случайным вражеским отрядам (всего 10).","flavor":"Один камешек - и нам конец.","glossary":"","power":0,"typeMask":2};
        }
        private static function page23():void {
            values[201635]={"templateId":201635,"description":"Если проигрываете, создайте Имперскую мантикору. Если выигрываете или при ничьей, создайте Яд мантикоры.","flavor":"За каким дьяволом ты мне эту падаль приволок, ведьмак? \"Принеси мне голову чудовища\", - это была лишь гребаная фигура речи!","glossary":"","power":0,"typeMask":2};
            values[201636]={"templateId":201636,"description":"Создайте обреченную базовую копию этого отряда справа от него.","flavor":"Люди их ненавидят. Эльфы презирают. Полуэльфам тяжело отыскать свое место на свете.","glossary":"","power":6,"typeMask":4};
            values[201637]={"templateId":201637,"description":"Сыграйте Бедствие в ряду противника, которое взорвется, когда сыграют другую особую карту, и нанесет по 4 ед. урона всем отрядам в этом ряду.","flavor":"В Зеррикании драконов почитают настолько, что даже называют в их честь оружие.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[201638]={"templateId":201638,"description":"Поменяйте карту.","flavor":"Говорят, что эльфы не оставляют следов на снегу. Но сдается мне, что это лишь болтовня сельских дурачков.","glossary":"","power":10,"typeMask":4};
            values[201639]={"templateId":201639,"description":"Сотворите бронзовый или серебряный отряд из стартовой колоды противника и усильте его на 2 ед.","flavor":"Тук-тук, есть кто дома?","glossary":"","power":0,"typeMask":2};
            values[201642]={"templateId":201642,"description":"Сотворите бронзового или серебряного солдата Скеллиге и укрепите его на 3 ед.","flavor":"Выглядит впечатляюще, но самое большее, на что он способен - намазать масло на хлеб.","glossary":"","power":0,"typeMask":2};
            values[201643]={"templateId":201643,"description":"Нанесите 10 ед. урона отряду, не относящемуся к эльфам.","flavor":"Эльфские сабли очень легки, но наносят тяжелые раны.","glossary":"","power":0,"typeMask":2};
            values[201644]={"templateId":201644,"description":"Исцелите дружественный отряд, затем усильте его на значение силы, восстановленной в результате исцеления.","flavor":"Кто поверит, что человек - тем более, женщина, - может быть хорошим оружейником? А краснолюд-кузнец - другое дело.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":6,"typeMask":4};
            values[201645]={"templateId":201645,"description":"Нанесите 6 ед. урона отрядам на конце ряда противника.","flavor":"Если она собьет тебя с ног, ты уже не встанешь.","glossary":"","power":0,"typeMask":2};
            values[201646]={"templateId":201646,"description":"Усиливайте эту карту на 1 ед. каждый раз, когда вражеский отряд получает урон.","flavor":"Какой бы ни была причина его безумия, наверняка она поистине ужасна…","glossary":"Урон: уменьшает текущую силу отряда.\n\nВражеский: любой отряд на стороне поля противника.","power":6,"typeMask":4};
            values[201647]={"templateId":201647,"description":"Нанесите 7 ед. урона вражескому отряду и переместите его в ряд выше. Если этот ряд заполнен, уничтожьте этот вражеский отряд.","flavor":"Ты туда не ходи - ты сюда ходи, а то валун башка попадет - совсем мертвый будешь.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[201648]={"templateId":201648,"description":"Выбор: уничтожьте бронзовый или серебряный проклятый вражеский отряд или нанесите 9 ед. урона и, если уничтожите отряд, удалите его.","flavor":"На рыцарском турнире в Ард Каррайге Зельткирк разломал меч Вандергрифта. После этого взбешенный Вандергрифт заказал себе колдовской клинок, зачарованный могущественными рунами.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[201650]={"templateId":201650,"description":"Воскресите бронзовый проклятый отряд.","flavor":"На последнем издыхании Сабрина Глевиссиг наложила могущественное проклятие, которое потрясло не только ее палачей, но и всех вокруг.","glossary":"","power":3,"typeMask":4};
            values[201653]={"templateId":201653,"description":"Выбор: сотворите бронзового или серебряного краснолюда или укрепите отряд на 7 ед.","flavor":"Как-то раз в Махакаме устроили конкурс игры на роге. И тогда краснолюды обнаружили, что громкие звуки и покрытые снегом вершины - не самое удачное сочетание.","glossary":"","power":0,"typeMask":2};
            values[201656]={"templateId":201656,"description":"Нанесите урон, равный изначальной силе бронзового или серебряного отряда в вашей руке.","flavor":"Держи копье прямо, сволочь! Тут ни один конный не проедет!","glossary":"Урон: уменьшает текущую силу отряда.","power":0,"typeMask":2};
            values[201657]={"templateId":201657,"description":"Нанесите 12 ед. урона вражескому отряду или усильте дружественный отряд на 12 ед.","flavor":"По-настоящему бросается в глаза.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201659]={"templateId":201659,"description":"Усильте все машины на вашей стороне поля на 3 ед.","flavor":"Чего тут лишнего говорить-то? Просто лебедка.","glossary":"","power":0,"typeMask":2};
            values[201660]={"templateId":201660,"description":"Укрепите всех других ваших инсектоидов и проклятые отряды в руке, в колоде или на поле на 1 ед.","flavor":"Никто никогда не возвращался из пущи, чтобы о нем рассказать...","glossary":"","power":8,"typeMask":4};
            values[201661]={"templateId":201661,"description":"Усильте все дружественные копии карты солдата на 2 ед.","flavor":"Стройте мосты, а не стены.","glossary":"","power":8,"typeMask":4};
            values[201662]={"templateId":201662,"description":"Выбор: нанесите по 2 ед. урона вражескому отряду и всем отрядам с теми же категориями или уничтожьте бронзовый или серебряный нейтральный отряд.","flavor":"Я не хочу, чтобы мою судьбу вершил слепой случай, поэтому всегда покрываю клинок трупным ядом.","glossary":"","power":0,"typeMask":2};
            values[201664]={"templateId":201664,"description":"Сыграйте бронзовую машину из вашей колоды.","flavor":"Око за око приведет лишь к тому, что весь мир ослепнет.","glossary":"","power":5,"typeMask":4};
            values[201666]={"templateId":201666,"description":"Укрепите все другие ваши реликты в руке, в колоде или на поле на 2 ед.","flavor":"Я чую твою боль, вижу твой страх.","glossary":"","power":0,"typeMask":2};
            values[201667]={"templateId":201667,"description":"Сыграйте бронзовый или серебряный реликт из вашей колоды и укрепите его на 2 ед.","flavor":"Я чую твою боль, вижу твой страх.","glossary":"","power":0,"typeMask":2};
            values[201668]={"templateId":201668,"description":"Усильте слабейший дружественный отряд на 5 ед.","flavor":"Смотри у меня! Не будешь слушаться - отдам тебя агуаре!","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nСлабейший: с наименьшей силой; если силы равны, выбирается случайным образом.","power":0,"typeMask":2};
            values[201669]={"templateId":201669,"description":"Нанесите 5 ед. урона сильнейшему вражескому отряду.","flavor":"Смотри у меня! Не будешь слушаться - отдам тебя агуаре!","glossary":"","power":0,"typeMask":2};
        }
        private static function page24():void {
            values[201670]={"templateId":201670,"description":"Усильте случайный отряд в вашей руке на 5 ед.","flavor":"Смотри у меня! Не будешь слушаться - отдам тебя агуаре!","glossary":"","power":0,"typeMask":2};
            values[201671]={"templateId":201671,"description":"Очаруйте случайного вражеского эльфа с силой 5 ед. или меньше.","flavor":"Смотри у меня! Не будешь слушаться - отдам тебя агуаре!","glossary":"","power":0,"typeMask":2};
            values[201672]={"templateId":201672,"description":"Сотворите бронзового или серебряного краснолюда.","flavor":"Как-то раз в Махакаме устроили конкурс игры на роге. И тогда краснолюды обнаружили, что громкие звуки и покрытые снегом вершины - не самое удачное сочетание.","glossary":"","power":0,"typeMask":2};
            values[201673]={"templateId":201673,"description":"Укрепите отряд на 7 ед.","flavor":"Как-то раз в Махакаме устроили конкурс игры на роге. И тогда краснолюды обнаружили, что громкие звуки и покрытые снегом вершины - не самое удачное сочетание.","glossary":"","power":0,"typeMask":2};
            values[201676]={"templateId":201676,"description":"Сыграйте бронзовый или серебряный предмет из вашей колоды.","flavor":"Никто не перебросил эльфам с Синих гор столько еды, сколько он. В особенности репы и лука.","glossary":"","power":5,"typeMask":4};
            values[201677]={"templateId":201677,"description":"Нет способности.","flavor":"Мы ополчение. Не видишь, порядок охраняем.","glossary":"","power":3,"typeMask":4};
            values[201679]={"templateId":201679,"description":"Нанесите 3 ед. урона Фениксу.","flavor":"","glossary":"","power":3,"typeMask":4};
            values[201680]={"templateId":201680,"description":"Уничтожьте не более 3 поврежденных отрядов.","flavor":"Если в гончем листе написано \"живым или мертвым\", многие охотники тебя просто убьют... только не я. Если я тебя поймаю, тебя повесят.","glossary":"","power":10,"typeMask":4};
            values[201681]={"templateId":201681,"description":"Нет способности.","flavor":"Вопрос, что было первым, курица или яйцо, приобретает новый смысл в случае с фениксами.","glossary":"","power":40,"typeMask":4};
            values[201682]={"templateId":201682,"description":"Усильте на 1 ед. каждый отряд на поле и в руке, затем нанесите 5 ед. урона Фениксу.","flavor":"","glossary":"","power":15,"typeMask":4};
            values[201684]={"templateId":201684,"description":"","flavor":"","glossary":"","power":0,"typeMask":2};
            values[201686]={"templateId":201686,"description":"9 ед. брони.","flavor":"Что, людь мне видит? Я записался в армию короля Радозвида. И у меня приказ - защищать лодки.","glossary":"","power":11,"typeMask":4};
            values[201687]={"templateId":201687,"description":"4 ед. брони.","flavor":"Солдаты, верные старому барону Тридама, покинули город вместе с Фалибором, тем самым пойдя против закона.","glossary":"","power":10,"typeMask":4};
            values[201689]={"templateId":201689,"description":"Усильте все ваши верные отряды на 1 ед., где бы они ни были.\nПодкрепление .","flavor":"Проклятая политика... Я доверяю только своим солдатам.","glossary":"Подкрепление: активирует способность \"Команда\" у соответствующих отрядов, сыгранных рядом с этим.","power":5,"typeMask":4};
            values[201690]={"templateId":201690,"description":"Нанесите 5 ед. урона.","flavor":"Я сумею о себе позаботиться. Поверь мне.","glossary":"","power":10,"typeMask":4};
            values[201691]={"templateId":201691,"description":"Нанесите 4 ед. урона вражескому отряду.","flavor":"Никогда не попадает дважды в одно и то же место. По здравому размышлению, это может вызвать серьезные проблемы.","glossary":"","power":7,"typeMask":4};
            values[201692]={"templateId":201692,"description":"Усильте дружественный отряд на 6 ед.","flavor":"Не такой творческий путь он себе представлял, когда мечтал стать музыкантом.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":5,"typeMask":4};
            values[201693]={"templateId":201693,"description":"Уничтожьте все сильнейшие отряды в ряду противника, если общая сила этого ряда больше или равна 25 ед.","flavor":"Многие пренебрегали ведьмачьими Знаками. Почувствовав на своей шкуре мощь Игни, они быстро меняли свое мнение.","glossary":"","power":5,"typeMask":4};
            values[201694]={"templateId":201694,"description":"Уничтожьте лидера противника на поле и усильте эту карту на 5 ед.","flavor":"Почему у этого монаха стеганые рукавицы?","glossary":"","power":0,"typeMask":2};
            values[201695]={"templateId":201695,"description":"Сыграйте бронзовую или серебряную карту тактики из вашей колоды.","flavor":"Почему у этого монаха стеганые рукавицы?","glossary":"","power":0,"typeMask":2};
            values[201696]={"templateId":201696,"description":"Воскресите бронзового краснолюда, который не является отрядом поддержки.","flavor":"Быстрей! Быстрей! Тут гребаная засада!","glossary":"","power":3,"typeMask":4};
            values[201697]={"templateId":201697,"description":"Выбор: сотворите бронзового трупоеда или вампира и усильте его на 2 ед. либо уничтожьте бронзового или серебряного трупоеда или вампира.","flavor":"Все вампиры пришли к единому мнению: пользоваться этим эликсиром неспортивно.","glossary":"","power":0,"typeMask":2};
            values[201698]={"templateId":201698,"description":"Поглотите бронзовый или серебряный отряд из любого сброса и усильте его на значение, равное значению его силы.","flavor":"Некоторым трупоедам так нравится людская плоть, что они не ограничиваются одними лишь трупами...","glossary":"","power":5,"typeMask":4};
            values[201699]={"templateId":201699,"description":"Сыграйте бронзового или серебряного офицера из вашей колоды и усильте его на 1 ед.","flavor":"Кажется, гостей они не принимают...","glossary":"","power":0,"typeMask":2};
            values[201700]={"templateId":201700,"description":"Переместите Бедствие из ряда противника в другой его ряд.","flavor":"Этот мост тролли построили в давние времена, и всякий, кто здесь ездил, должен был платить им звонкой монетой. Ну а потому как этой дорогой нечасто ездили, тролли и убрались восвояси. А мост остался.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":10,"typeMask":4};
        }
        private static function page25():void {
            values[201701]={"templateId":201701,"description":"Стойкость.\nПоглотите дружественный отряд и усильте эту карту на силу поглощенного отряда.","flavor":"То, что еще секунду назад он принимал за лежащие у основания сталагмитов округлые камни, теперь таращилось на него огромными горящими глазищами.","glossary":"Дружественный: любой отряд на вашей стороне поля.\n\nСтойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.","power":6,"typeMask":4};
            values[201702]={"templateId":201702,"description":"Воскресите бронзового зверя или сектанта.","flavor":"Простые предметы иногда таят большую силу.","glossary":"","power":0,"typeMask":2};
            values[201703]={"templateId":201703,"description":"Исцелите дружественный отряд и укрепите его на 3 ед.","flavor":"Простые предметы иногда таят большую силу.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201704]={"templateId":201704,"description":"Посмотрите бронзовые отряды (всего 2) в вашей колоде и сыграйте 1 из них.","flavor":"Если разведчики не вернутся, мы пойдем обратно. Говорят, в этих лесах полно белок - и я не о тех, что орехи собирают.","glossary":"","power":0,"typeMask":2};
            values[201705]={"templateId":201705,"description":"Исцелите дружественный отряд и случайным образом распределите между дружественным отрядами 5 ед. усиления.","flavor":"Поможет ли? Я не уверен, но, скорей всего, не повредит.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201706]={"templateId":201706,"description":"Воскресите бронзовый отряд силой 5 ед. или меньше.","flavor":"Поможет ли? Я не уверен, но, скорей всего, не повредит.","glossary":"","power":0,"typeMask":2};
            values[201707]={"templateId":201707,"description":"","flavor":"","glossary":"","power":5,"typeMask":4};
            values[201708]={"templateId":201708,"description":"Усильте дружественный отряд на 10 ед.","flavor":"Это зелье, ускоряющее заживление ран, получило свое название от ласточки, что приносит весну и радость.","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201709]={"templateId":201709,"description":"Нанесите по 3 ед. урона всем вражеским отрядам с нечетным значением силы.","flavor":"\"Что написано на клинке? Проклятие?\" - \"Нет, оскорбление\".","glossary":"","power":0,"typeMask":2};
            values[201710]={"templateId":201710,"description":"Нанесите по 3 ед. урона всем вражеским отрядам с четным значением силы.","flavor":"\"Что написано на клинке? Проклятие?\" - \"Нет, оскорбление\".","glossary":"","power":0,"typeMask":2};
            values[201711]={"templateId":201711,"description":"Уничтожьте бронзовый или серебряный проклятый вражеский отряд.","flavor":"На рыцарском турнире в Ард Каррайге Зельткирк разломал меч Вандергрифта. После этого взбешенный Вандергрифт заказал себе колдовской клинок, зачарованный могущественными рунами.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[201712]={"templateId":201712,"description":"Нанесите 9 ед. урона и, если уничтожите отряд, удалите его.","flavor":"На рыцарском турнире в Ард Каррайге Зельткирк разломал меч Вандергрифта. После этого взбешенный Вандергрифт заказал себе колдовской клинок, зачарованный могущественными рунами.","glossary":"","power":0,"typeMask":2};
            values[201713]={"templateId":201713,"description":"Нанесите по 2 ед. урона вражескому отряду и всем отрядам с теми же категориями.","flavor":"Этот яд получил название благодаря одному из своих ингредиентов - мандрагоре, которая часто растет на местах казни.","glossary":"","power":0,"typeMask":2};
            values[201714]={"templateId":201714,"description":"Уничтожьте бронзовый или серебряный нейтральный отряд.","flavor":"Этот яд получил название благодаря одному из своих ингредиентов - мандрагоре, которая часто растет на местах казни.","glossary":"","power":0,"typeMask":2};
            values[201715]={"templateId":201715,"description":"Сыграйте бронзовую или серебряную особую карту из вашей колоды.","flavor":"Впереди перевал Эльскердег, а за перевалом - Зеррикания и Хакланд. Перед нами дальний и опасный путь. Если мы пойдем вместе... Отбросим недоверие.","glossary":"","power":0,"typeMask":2};
            values[201716]={"templateId":201716,"description":"Сотворите серебряного эльфа.","flavor":"Впереди перевал Эльскердег, а за перевалом - Зеррикания и Хакланд. Перед нами дальний и опасный путь. Если мы пойдем вместе... Отбросим недоверие.","glossary":"","power":0,"typeMask":2};
            values[201717]={"templateId":201717,"description":"Сыграйте проклятый бронзовый или серебряный отряд из вашей колоды.","flavor":"Боги обращаются ко мне. Я слышу их шепот из тени....","glossary":"","power":0,"typeMask":2};
            values[201718]={"templateId":201718,"description":"Сотворите серебряный отряд из стартовой колоды противника.","flavor":"Боги обращаются ко мне. Я слышу их шепот из тени....","glossary":"","power":0,"typeMask":2};
            values[201719]={"templateId":201719,"description":"Сотворите бронзовую или серебряную карту алхимии.","flavor":"Мы живем себе на тихом островке неизвестности посреди черных морей бесконечности, и не надо нам выходить слишком далеко в море.","glossary":"","power":0,"typeMask":2};
            values[201720]={"templateId":201720,"description":"Сыграйте бронзовый или серебряный предмет из вашей колоды.","flavor":"Мы живем себе на тихом островке неизвестности посреди черных морей бесконечности, и не надо нам выходить слишком далеко в море.","glossary":"","power":0,"typeMask":2};
            values[201721]={"templateId":201721,"description":"Сотворите бронзового трупоеда или вампира и усильте его на 2 ед.","flavor":"Все вампиры пришли к единому мнению: пользоваться этим эликсиром неспортивно.","glossary":"","power":0,"typeMask":2};
            values[201722]={"templateId":201722,"description":"Уничтожьте бронзового или серебряного трупоеда или вампира.","flavor":"Все вампиры пришли к единому мнению: пользоваться этим эликсиром неспортивно.","glossary":"","power":0,"typeMask":2};
            values[201725]={"templateId":201725,"description":"Отправьте Лавка в Академию Бан Арда для мальчиков.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":4,"typeMask":4};
            values[201726]={"templateId":201726,"description":"Возьмите карту.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201727]={"templateId":201727,"description":"Очаруйте случайный вражеский отряд.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"Вражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
        }
        private static function page26():void {
            values[201728]={"templateId":201728,"description":"Создайте случайные Бедствия во всех рядах противника.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201729]={"templateId":201729,"description":"Нанесите 10 ед. урона вражескому отряду и по 5 ед. урона всем смежным с ним.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201730]={"templateId":201730,"description":"Сыграйте бронзовую или серебряную особую карту из вашей колоды.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201731]={"templateId":201731,"description":"Отправьте Лавка в леса Дол Блатанна.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":8,"typeMask":4};
            values[201732]={"templateId":201732,"description":"Нанесите 15 ед. урона.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201733]={"templateId":201733,"description":"Нанесите 2 ед. урона случайному вражескому отряду. Повторите несколько раз (всего 8).","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201734]={"templateId":201734,"description":"Повторно сыграйте бронзовый или серебряный дружественный отряд и усильте его на 5 ед.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"Дружественный: любой отряд на вашей стороне поля.","power":0,"typeMask":2};
            values[201735]={"templateId":201735,"description":"Очистите вашу сторону от всех Бедствий и усильте дружественные отряды на 1 ед.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201736]={"templateId":201736,"description":"Сыграйте бронзовый или серебряный отряд из вашей колоды.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201737]={"templateId":201737,"description":"Отправьте Лавка в Императорскую военную академию.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":12,"typeMask":4};
            values[201738]={"templateId":201738,"description":"Сделайте изначальную силу равной 25.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201739]={"templateId":201739,"description":"Стойкость.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"Стойкость: статус, позволяющий отряду остаться на поле в конце раунда. Возвращает силу отряда к изначальной, если он был усилен ранее.","power":0,"typeMask":2};
            values[201740]={"templateId":201740,"description":"Вызовите вражеский отряд на дуэль.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.\n\nВражеский: любой отряд на стороне поля противника.","power":0,"typeMask":2};
            values[201741]={"templateId":201741,"description":"Восстановите отряд.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201742]={"templateId":201742,"description":"Уничтожьте вражеские отряды с силой меньше 4 ед.","flavor":"Другие тролли всегда считали его слегка того. Ну кто в своем уме станет менять камни на цветные фантики?","glossary":"","power":0,"typeMask":2};
            values[201743]={"templateId":201743,"description":"Неуязвимость.\nПоглотите дружественные отряды (всего 3) и усильте эту карту за счет их силы.","flavor":"Ее дети унаследовали ее красоту.","glossary":"Неуязвимость: нельзя выбрать как цель.","power":7,"typeMask":4};
            values[201744]={"templateId":201744,"description":"Нанесите по 2 ед. урона всем отрядам в одном ряду и очистите этот ряд от Блага.","flavor":"Съешь побольше, и мир уже не будет прежним...","glossary":"","power":0,"typeMask":2};
            values[201745]={"templateId":201745,"description":"","flavor":"","glossary":"","power":3,"typeMask":4};
            values[201746]={"templateId":201746,"description":"Сыграйте Благо в дружественном ряду, которое в начале хода усиливает случайного зверя или вампира на 2 ед.","flavor":"Когда восходит полная луна, из темных закоулков этого мира приходят кошмары.","glossary":"Благо: положительный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[201747]={"templateId":201747,"description":"Сыграйте Бедствие во вражеском ряду, которое наносит по 2 ед. урона всем отрядам при контакте.","flavor":"Когда восходит полная луна, из темных закоулков этого мира приходят кошмары.","glossary":"Бедствие: отрицательный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[201748]={"templateId":201748,"description":"Нанесите вражескому отряду 2 ед. урона и переместите его в ряд выше. \nКоманда: повторите эту способность.","flavor":"Как любит говорить король Фольтест, важен не размер, а умение пользоваться.","glossary":"Команда: при появлении на поле активируется по разу за каждый смежный отряд, обладающий способностью \"Подкрепление\".","power":10,"typeMask":4};
            values[201749]={"templateId":201749,"description":"Сыграйте Благо в дружественном ряду, которое в начале хода усиливает случайные отряды (всего 2) на 1 ед.","flavor":"Чувствуете? Это запах счастья.","glossary":"Благо: положительный эффект в ряду. Заменяется другими эффектами, убирается в конце раунда.","power":0,"typeMask":2};
            values[201750]={"templateId":201750,"description":"Нет способности.","flavor":"\"Спокойно... я знаю, как приручить волка\" - последние слова ловчего Дунбара.","glossary":"","power":1,"typeMask":4};
            values[201751]={"templateId":201751,"description":"3 ед. брони.","flavor":"Солдаты, верные старому барону Тридама, покинули город вместе с Фалибором, тем самым пойдя против закона.","glossary":"","power":10,"typeMask":4};
            values[201752]={"templateId":201752,"description":"Нанесите 4 ед. урона вражескому отряду.","flavor":"Никогда не попадает дважды в одно и то же место. По здравому размышлению, это может вызвать серьезные проблемы.","glossary":"","power":7,"typeMask":4};
        }
        private static function page27():void {
            values[201753]={"templateId":201753,"description":"Создайте крестьян в ряду (всего 3).","flavor":"Мы ополчение. Не видишь, порядок охраняем.","glossary":"","power":0,"typeMask":2};
            values[201755]={"templateId":201755,"description":"Нет способности.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":2,"typeMask":4};
            values[201757]={"templateId":201757,"description":"Нет способности.","flavor":"С вербовки? Гони бумагу. Чего, зараза, стоишь будто столб? На месте шагом марш! Вперед!","glossary":"","power":2,"typeMask":4};
            values[201758]={"templateId":201758,"description":"Нет способности.","flavor":"Он сражается на вечной войне, причин которой не помнит.","glossary":"","power":5,"typeMask":4};
            values[201759]={"templateId":201759,"description":"Получите силу и способности одной из карт Геральта.\nПосле 2 ходов верните в вашу руку.","flavor":"Если надо выбирать между одним злом и другим, я предпочитаю не выбирать.","glossary":"","power":15,"typeMask":4};
            values[201761]={"templateId":201761,"description":"Вы проиграете партию, если этот отряд будет уничтожен.","flavor":"Вопрос, что было первым, курица или яйцо, приобретает новый смысл в случае с фениксами.","glossary":"","power":10,"typeMask":4};
            values[201762]={"templateId":201762,"description":"Уничтожьте не более 3 поврежденных вражеских отрядов.","flavor":"Если в гончем листе написано \"живым или мертвым\", многие охотники тебя просто убьют... только не я. Если я тебя поймаю, тебя повесят.","glossary":"","power":10,"typeMask":4};
            values[201763]={"templateId":201763,"description":"Призовите все копии этого отряда.","flavor":"Темерия! Темерия! Судьба к тебе щедра! Ты сокрушишь врагов своих величием добра!","glossary":"","power":3,"typeMask":4};
            values[201764]={"templateId":201764,"description":"Нельзя сделать целью или уничтожить.","flavor":"Мы остановились на краю пропасти... а затем шагнули вперед!","glossary":"Уничтожить: переместить карту в сброс.","power":0,"typeMask":8};
            values[201765]={"templateId":201765,"description":"Переместите 3 вражеских отряда в противоположный ряд и нанесите им по 2 ед. урона. Если этот ряд находится под действием Мороза, нанесите по 3 ед. урона.","flavor":"На Скеллиге верят, что в древние времена островами правил могущественный и ужасный Йотун, король великанов. Хеймдалль сумел победить его, но перед смертью Йотун пообещал вернуться, когда наступит Рагнарек.","glossary":"","power":6,"typeMask":4};
            values[201767]={"templateId":201767,"description":"Уменьшите наполовину броню Феникса.","flavor":"Необычный туман окутал корабль Демавенда и превратил его экипаж и пассажиров в ледяные скульптуры...","glossary":"","power":0,"typeMask":2};
            values[201768]={"templateId":201768,"description":"Сыграйте случайный бронзовый или серебряный отряд из вашей колоды.","flavor":"\"Что написано на клинке? Проклятие?\" - \"Нет, оскорбление\".","glossary":"","power":0,"typeMask":2};
            values[201770]={"templateId":201770,"description":"Значение силы равно 6 ед.","flavor":"Он даст тебе успех и достаток. Щедро одарит и сребром, и златом.","glossary":"","power":6,"typeMask":4};
            values[201772]={"templateId":201772,"description":"Нанесите 4 ед. урона вражескому отряду. Если это отряд из фракции Чудовищ, уничтожьте его.","flavor":"Когда-то я выполнил заказ. Мне предложили выбрать награду, и я воспользовался Правом Неожиданности.","glossary":"","power":7,"typeMask":4};
            values[201773]={"templateId":201773,"description":"Сотворите бронзовую особую карту из стартовой колоды любого игрока.","flavor":"Просто связать руки недостаточно. Да и кляп во рту не сделает ее менее опасной. Нет, тут помогут только кандалы из двимерита.","glossary":"","power":6,"typeMask":4};
            values[201774]={"templateId":201774,"description":"Усильте эту карту на 3 ед. за каждого Геральта, Йеннифэр, Трисс и Золтана в вашей стартовой колоде.","flavor":"Лютик рассказывал мне о ваших приключениях. Как он воодушевлял тебя песней на бой, как отвлекал кейрана игрой на лютне...","glossary":"","power":9,"typeMask":4};
            values[201776]={"templateId":201776,"description":"Возьмите карту, затем сыграйте карту.","flavor":"Перо разит больней, чем меч.","glossary":"","power":5,"typeMask":4};
            values[201777]={"templateId":201777,"description":"Уничтожьте лежащий рубашкой вверх вражеский отряд засады.","flavor":"Страх нам не к лицу. Но есть тут один d'hoine... Вернон Роше. Берегись его.","glossary":"Вражеский: любой отряд на стороне поля противника.","power":6,"typeMask":4};
            values[201778]={"templateId":201778,"description":"Воскресите следующий сброшенный отряд.","flavor":"Надо объединить кланы. Я бы постаралась избежать войны, но если на нас действительно готовится напасть Нильфгаард, придется дать ему отпор общими силами.","glossary":"","power":6,"typeMask":4};
            values[201779]={"templateId":201779,"description":"Засада: когда противник сыграет бронзовую или серебряную особую карту, переверните ее и отмените ее способность.","flavor":"Брокилон для меня дороже жизни. Мы его дети, и он заботится о нас. Я буду защищать его до последнего вздоха.","glossary":"Засада: играется рубашкой вверх. При блокировке может быть отменена и перевернута.","power":6,"typeMask":4};
            values[201780]={"templateId":201780,"description":"Воскресите бронзового или серебряного солдата из сброса противника.","flavor":"Процесс гниения зашел далеко... Но голосовые связки целы. Может, мы что-нибудь из него и вытянем...","glossary":"","power":5,"typeMask":4};
            values[201781]={"templateId":201781,"description":"В конце каждого хода вызывайте на дуэль сильнейший вражеский отряд. Если эта карта выживет, исцелите ее на 2 ед. и добавьте ей 2 ед. брони.\n2 ед. брони.","flavor":"Сестры сказали, что ты придешь. Они видели тебя в воде.","glossary":"Дуэль: отряды по очереди наносят друг другу урон, равный своей силе, пока один из отрядов не будет уничтожен.\n\nВражеский: любой отряд на стороне поля противника.\n\nСильнейший: с наибольшей силой; если силы равны, выбирается случайным образом.","power":5,"typeMask":4};
            values[201817]={"templateId":201817,"description":"Нанесите 5 ед. урона этой карте.\nВ следующий раз, когда текущая сила этой карты станет равна изначальной, нанесите в конце хода 7 ед. урона нескольким случайным вражеским отрядам (всего 3).","flavor":"\"Невозможная невозможность, - подумала Цири, приходя в себя и собираясь с мыслями. - Ведь единорогов уже нет на свете, ведь они же вымерли\".","glossary":"","power":7,"typeMask":4};
        }
    }
}
