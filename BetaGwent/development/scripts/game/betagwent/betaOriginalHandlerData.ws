function BetaOriginalCreateHandler(id : int, owner : IScriptable) : CBetaOriginalHandler {
    var h : CBetaOriginalHandler;
    h=new CBetaOriginalHandler in owner; h.Initialize();
    if(id>=1 && id<=10){BetaOriginalHandlerData0(h,id);return h;}
    if(id>=11 && id<=20){BetaOriginalHandlerData1(h,id);return h;}
    if(id>=21 && id<=30){BetaOriginalHandlerData2(h,id);return h;}
    if(id>=31 && id<=40){BetaOriginalHandlerData3(h,id);return h;}
    if(id>=41 && id<=50){BetaOriginalHandlerData4(h,id);return h;}
    if(id>=51 && id<=57){BetaOriginalHandlerData5(h,id);return h;}
    if(id==0){h.kind="Random";return h;}
    return NULL;
}
