function BetaGwentNeutralView(id : int) : SBetaGwentDuelDefinition
{
    var d : SBetaGwentDuelDefinition;
    if(id==200175) {d.header.templateId=200175;d.title="Алчность";d.description="Значение силы больше 6 ед.";return d;}
    if(id==200176) {d.header.templateId=200176;d.title="Недоверие";d.description="Значение силы меньше 6 ед.";return d;}
    if(id==201770) {d.header.templateId=201770;d.title="Осторожность";d.description="Значение силы равно 6 ед.";return d;}
    if(id==201668) {d.header.templateId=201668;d.title="Неестественная сила";d.description="Усильте слабейший дружественный отряд на 5 ед.";return d;}
    if(id==201669) {d.header.templateId=201669;d.title="Бешеная атака";d.description="Нанесите 5 ед. урона сильнейшему вражескому отряду.";return d;}
    if(id==201670) {d.header.templateId=201670;d.title="Иллюзия";d.description="Усильте случайный отряд в вашей руке на 5 ед.";return d;}
    if(id==201671) {d.header.templateId=201671;d.title="Похищение";d.description="Очаруйте случайного вражеского эльфа с силой 5 ед. или меньше.";return d;}
    if(id==201726) {d.header.templateId=201726;d.title="Лавк: чародей";d.description="Возьмите карту.";return d;}
    if(id==201727) {d.header.templateId=201727;d.title="Лавк: чародей";d.description="Очаруйте случайный вражеский отряд.";return d;}
    if(id==201728) {d.header.templateId=201728;d.title="Лавк: чародей";d.description="Создайте случайные Бедствия во всех рядах противника.";return d;}
    if(id==201729) {d.header.templateId=201729;d.title="Лавк: чародей";d.description="Нанесите 10 ед. урона вражескому отряду и по 5 ед. урона всем смежным с ним.";return d;}
    if(id==201730) {d.header.templateId=201730;d.title="Лавк: чародей";d.description="Сыграйте бронзовую или серебряную особую карту из вашей колоды.";return d;}
    if(id==201732) {d.header.templateId=201732;d.title="Лавк: охотник";d.description="Нанесите 15 ед. урона.";return d;}
    if(id==201733) {d.header.templateId=201733;d.title="Лавк: охотник";d.description="Нанесите 2 ед. урона случайному вражескому отряду. Повторите несколько раз (всего 8).";return d;}
    if(id==201734) {d.header.templateId=201734;d.title="Лавк: охотник";d.description="Повторно сыграйте бронзовый или серебряный дружественный отряд и усильте его на 5 ед.";return d;}
    if(id==201735) {d.header.templateId=201735;d.title="Лавк: охотник";d.description="Очистите вашу сторону от всех Бедствий и усильте дружественные отряды на 1 ед.";return d;}
    if(id==201736) {d.header.templateId=201736;d.title="Лавк: охотник";d.description="Сыграйте бронзовый или серебряный отряд из вашей колоды.";return d;}
    if(id==201738) {d.header.templateId=201738;d.title="Лавк: рыцарь";d.description="Сделайте изначальную силу равной 25.";return d;}
    if(id==201739) {d.header.templateId=201739;d.title="Лавк: рыцарь";d.description="Стойкость.";return d;}
    if(id==201740) {d.header.templateId=201740;d.title="Лавк: рыцарь";d.description="Вызовите вражеский отряд на дуэль.";return d;}
    if(id==201741) {d.header.templateId=201741;d.title="Лавк: рыцарь";d.description="Восстановите отряд.";return d;}
    if(id==201742) {d.header.templateId=201742;d.title="Лавк: рыцарь";d.description="Уничтожьте вражеские отряды с силой меньше 4 ед.";return d;}
    return BetaGwentSkelligeView(id);
}

