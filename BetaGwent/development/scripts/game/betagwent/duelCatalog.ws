function BetaGwentDuelViewDefinition(id : int) : SBetaGwentDuelDefinition
{
    var value : SBetaGwentDuelDefinition;
    switch (id)
    {
    case 113403:
        value.header.templateId = 113403; value.header.typeMask = 2; value.header.tierMask = 2; value.header.factionMask = 1;
        value.title = "Мутаген"; value.description = "Восстановите отряд и укрепите его на 3 ед.";
        return value;
    case 113404:
        value.header.templateId = 113404; value.header.typeMask = 2; value.header.tierMask = 2; value.header.factionMask = 1;
        value.title = "Токсин"; value.description = "Восстановите отряд и ослабьте его на 3 ед.";
        return value;
    case 201562:
        value.header.templateId = 201562; value.header.typeMask = 2; value.header.tierMask = 4; value.header.factionMask = 1;
        value.title = "Наливка"; value.description = "Исцелите отряд и укрепите его на 6 ед.";
        return value;
    case 201563:
        value.header.templateId = 201563; value.header.typeMask = 2; value.header.tierMask = 4; value.header.factionMask = 1;
        value.title = "Экстракт"; value.description = "Восстановите отряд и ослабьте его на 6 ед.";
        return value;
    case 201702:
        value.header.templateId = 201702; value.header.typeMask = 2; value.header.tierMask = 2; value.header.factionMask = 32;
        value.title = "Зверь"; value.description = "Воскресите бронзового зверя или сектанта.";
        return value;
    case 201703:
        value.header.templateId = 201703; value.header.typeMask = 2; value.header.tierMask = 2; value.header.factionMask = 32;
        value.title = "Регенерация"; value.description = "Исцелите дружественный отряд и укрепите его на 3 ед.";
        return value;
    case 201709:
        value.header.templateId = 201709; value.header.typeMask = 2; value.header.tierMask = 8; value.header.factionMask = 1;
        value.title = "Равенство"; value.description = "Нанесите по 3 ед. урона всем вражеским отрядам с нечетным значением силы.";
        return value;
    case 201710:
        value.header.templateId = 201710; value.header.typeMask = 2; value.header.tierMask = 8; value.header.factionMask = 1;
        value.title = "Разрыв"; value.description = "Нанесите по 3 ед. урона всем вражеским отрядам с четным значением силы.";
        return value;
    case 201711:
        value.header.templateId = 201711; value.header.typeMask = 2; value.header.tierMask = 4; value.header.factionMask = 8;
        value.title = "Ровный разрез"; value.description = "Уничтожьте бронзовый или серебряный проклятый вражеский отряд.";
        return value;
    case 201712:
        value.header.templateId = 201712; value.header.typeMask = 2; value.header.tierMask = 4; value.header.factionMask = 8;
        value.title = "Свирепый удар"; value.description = "Нанесите 9 ед. урона и, если уничтожите отряд, удалите его.";
        return value;
    case 201746:
        value.header.templateId = 201746; value.header.typeMask = 2; value.header.tierMask = 2; value.header.factionMask = 2;
