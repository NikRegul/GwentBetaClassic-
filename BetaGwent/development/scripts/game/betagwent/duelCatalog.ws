function BetaGwentNilfView(id : int) : SBetaGwentDuelDefinition
{
    var d : SBetaGwentDuelDefinition;
    if (id == 201694) { d.header.templateId = 201694; d.title = "Резня"; d.description = "Уничтожьте лидера противника на поле и усильте эту карту на 5 ед."; return d; }
    if (id == 201695) { d.header.templateId = 201695; d.title = "Уловка"; d.description = "Сыграйте бронзовую или серебряную карту тактики из вашей колоды."; return d; }
    if (id == 201713) { d.header.templateId = 201713; d.title = "Яд"; d.description = "Нанесите по 2 ед. урона вражескому отряду и всем отрядам с теми же категориями."; return d; }
    if (id == 201714) { d.header.templateId = 201714; d.title = "Кислота"; d.description = "Уничтожьте бронзовый или серебряный нейтральный отряд."; return d; }
    if (id == 201672) { d.header.templateId = 201672; d.title = "Предупреждение"; d.description = "Сотворите бронзового или серебряного краснолюда."; return d; }
    if (id == 201673) { d.header.templateId = 201673; d.title = "Призыв к битве"; d.description = "Укрепите отряд на 7 ед."; return d; }
    return BetaGwentNorthernView(id);
}

