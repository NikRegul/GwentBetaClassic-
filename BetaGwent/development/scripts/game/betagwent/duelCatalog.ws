// Mode display definitions are never separately played.
function BetaGwentDuelModeChoices(id : int, out ids : array<int>)
{
    ids.Clear();
    switch (id)
    {
    case 113320:
        ids.PushBack(113403);
        ids.PushBack(113404);
        break;
    case 200223:
        ids.PushBack(201562);
        ids.PushBack(201563);
        break;
    case 201598:
        ids.PushBack(201702);
        ids.PushBack(201703);
        break;
    case 201632:
        ids.PushBack(201709);
        ids.PushBack(201710);
        ids.PushBack(201768);
        break;
    case 201648:
        ids.PushBack(201711);
        ids.PushBack(201712);
        break;
    case 200067:
        ids.PushBack(201746);
        ids.PushBack(201747);
        break;
        default: break;
    }
}

