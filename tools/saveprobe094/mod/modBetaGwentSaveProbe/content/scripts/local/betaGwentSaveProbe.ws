@addMethod(W3PlayerWitcher)
private function Bgs4A(j : int) : int
{
    switch (j)
    {
        case 0: return bgs3F00;
        case 1: return bgs3F01;
        case 2: return bgs3F02;
        case 3: return bgs3F03;
        case 4: return bgs3F04;
        case 5: return bgs3F05;
        case 6: return bgs3F06;
        case 7: return bgs3F07;
        case 8: return bgs3F08;
        case 9: return bgs3F09;
        case 10: return bgs3F10;
        case 11: return bgs3F11;
        case 12: return bgs3F12;
        case 13: return bgs3F13;
        case 14: return bgs3F14;
    }
    return -1;
}
